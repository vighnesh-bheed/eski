		{"listpack-duplicate-int-small-False-True", "0b0b000000020001010101ff", 20, false, true, 1, 1, .Ok, "", .Hashtable, 1, 12},
		{"listpack-duplicate-int-table-False-True", "0b0b000000020001010101ff", 20, false, true, 0, 0, .Ok, "", .Hashtable, 1, 12},
		{"listpack-duplicate-int-compact-True-True", "0b0b000000020001010101ff", 20, true, true, 512, 512, .Corrupt, "Set listpack integrity check failed.", .Intset, -1, 12},
		{"listpack-duplicate-int-small-True-True", "0b0b000000020001010101ff", 20, true, true, 1, 1, .Corrupt, "Set listpack integrity check failed.", .Intset, -1, 12},
		{"listpack-duplicate-int-table-True-True", "0b0b000000020001010101ff", 20, true, true, 0, 0, .Corrupt, "Set listpack integrity check failed.", .Intset, -1, 12},
		{"listpack-long-duplicate-compact-False-True", "408f8f0000000200e041717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717143e041717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717143ff", 20, false, true, 512, 512, .Ok, "", .Listpack, 2, 145},
		{"listpack-long-duplicate-small-False-True", "408f8f0000000200e041717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717143e041717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717143ff", 20, false, true, 1, 1, .Ok, "", .Hashtable, 1, 145},
		{"listpack-long-duplicate-table-False-True", "408f8f0000000200e041717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717143e041717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717143ff", 20, false, true, 0, 0, .Ok, "", .Hashtable, 1, 145},
		{"listpack-long-duplicate-compact-True-True", "408f8f0000000200e041717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717143e041717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717143ff", 20, true, true, 512, 512, .Corrupt, "Set listpack integrity check failed.", .Intset, -1, 145},
		{"listpack-long-duplicate-small-True-True", "408f8f0000000200e041717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717143e041717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717143ff", 20, true, true, 1, 1, .Corrupt, "Set listpack integrity check failed.", .Intset, -1, 145},
		{"listpack-long-duplicate-table-True-True", "408f8f0000000200e041717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717143e041717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717171717143ff", 20, true, true, 0, 0, .Corrupt, "Set listpack integrity check failed.", .Intset, -1, 145},
	}
	for fixture in cases {
		set_max_intset_entries = fixture.imax
		set_max_listpack_entries = fixture.lmax
		bytes := decode_hex(fixture.payload)
		reader: rdb.Reader
		rdb.reader_init_mem(&reader, bytes, false)
		reader.lenient = fixture.lenient
		loaded := rdb_load(&reader, fixture.kind, fixture.deep)
		testing.expectf(t, reader.pos == fixture.position, "%s reader position", fixture.label)
		testing.expectf(t, reader.status == fixture.status, "%s status expected %v got %v", fixture.label, fixture.status, reader.status)
		testing.expectf(t, rdb.reader_reason(&reader) == fixture.reason, "%s reason expected %s got %s", fixture.label, fixture.reason, rdb.reader_reason(&reader))
		if fixture.status == .Ok {
			testing.expectf(t, loaded != nil, "%s expected object", fixture.label)
			if loaded != nil {
				testing.expectf(t, loaded.encoding == fixture.encoding && size(loaded) == fixture.n, "%s representation/size", fixture.label)
			}
		} else {
			testing.expectf(t, loaded == nil, "%s expected nil", fixture.label)
		}
		destroy(loaded)
		rdb.reader_destroy(&reader)
		delete(bytes)
	}
	release_pending_maintenance()
}
