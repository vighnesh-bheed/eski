package settype

import "core:testing"
import rdb "../rdb"

decode_hex :: proc(text: string) -> []u8 {
	bytes := make([]u8, len(text) / 2)
	for index in 0 ..< len(bytes) {
		for half in 0 ..< 2 {
			ch := text[index * 2 + half]
			value := ch - '0' if ch <= '9' else ch - 'a' + 10
			bytes[index] = bytes[index] * 16 + value
		}
	}
	return bytes
}

@(test)
