package listpack

import "core:testing"

@(test)
observed_mutations_match_literal_wires_counts_and_returned_cursors :: proc(t: ^testing.T) {
	Fixture :: struct { operation, where_, index: int, num: u64, cursor: int, count: u32, wire: string }
	fixtures := []Fixture{
		{0, 0, 0, 0, 6, 4, "\x12\x00\x00\x00\x04\x00\x11\x01\x81a\x02\x81b\x02\x81c\x02\xff"},
		{0, 0, 1, 0, 9, 4, "\x12\x00\x00\x00\x04\x00\x81a\x02\x11\x01\x81b\x02\x81c\x02\xff"},
		{0, 0, 2, 0, 12, 4, "\x12\x00\x00\x00\x04\x00\x81a\x02\x81b\x02\x11\x01\x81c\x02\xff"},
		{0, 1, 0, 0, 9, 4, "\x12\x00\x00\x00\x04\x00\x81a\x02\x11\x01\x81b\x02\x81c\x02\xff"},
		{0, 1, 1, 0, 12, 4, "\x12\x00\x00\x00\x04\x00\x81a\x02\x81b\x02\x11\x01\x81c\x02\xff"},
		{0, 1, 2, 0, 15, 4, "\x12\x00\x00\x00\x04\x00\x81a\x02\x81b\x02\x81c\x02\x11\x01\xff"},
		{0, 2, 0, 0, 6, 3, "\x0f\x00\x00\x00\x03\x00\x11\x01\x81b\x02\x81c\x02\xff"},
		{0, 2, 1, 0, 9, 3, "\x0f\x00\x00\x00\x03\x00\x81a\x02\x11\x01\x81c\x02\xff"},
		{0, 2, 2, 0, 12, 3, "\x0f\x00\x00\x00\x03\x00\x81a\x02\x81b\x02\x11\x01\xff"},
		{1, 0, 0, 0, 15, 4, "\x12\x00\x00\x00\x04\x00\x81a\x02\x81b\x02\x81c\x02\x80\x01\xff"},
		{2, 0, 0, 0, 6, 2, "\x0d\x00\x00\x00\x02\x00\x81b\x02\x81c\x02\xff"},
		{2, 0, 1, 0, 9, 2, "\x0d\x00\x00\x00\x02\x00\x81a\x02\x81c\x02\xff"},
		{2, 0, 2, 0, -1, 2, "\x0d\x00\x00\x00\x02\x00\x81a\x02\x81b\x02\xff"},
		{3, 0, 0, 0, -1, 1, "\x0a\x00\x00\x00\x01\x00\x81a\x02\xff"},
		{4, 0, 0, 1, 9, 4, "\x13\x00\x00\x00\x04\x00\x81a\x02\x81x\x02\x81b\x02\x81c\x02\xff"},
		{4, 1, 0, 1, 12, 4, "\x13\x00\x00\x00\x04\x00\x81a\x02\x81b\x02\x81x\x02\x81c\x02\xff"},
		{4, 0, 0, 2, 12, 5, "\x16\x00\x00\x00\x05\x00\x81a\x02\x81x\x02\xdf\xf8\x02\x81b\x02\x81c\x02\xff"},
		{4, 1, 0, 2, 15, 5, "\x16\x00\x00\x00\x05\x00\x81a\x02\x81b\x02\x81x\x02\xdf\xf8\x02\x81c\x02\xff"},
		{4, 0, 0, 4, 17, 7, "\x1a\x00\x00\x00\x07\x00\x81a\x02\x81x\x02\xdf\xf8\x02\x80\x01\x09\x01\x81b\x02\x81c\x02\xff"},
		{4, 1, 0, 4, 20, 7, "\x1a\x00\x00\x00\x07\x00\x81a\x02\x81b\x02\x81x\x02\xdf\xf8\x02\x80\x01\x09\x01\x81c\x02\xff"},
		{5, 0, -9, 0, -1, 3, "\x10\x00\x00\x00\x03\x00\x81a\x02\x81b\x02\x81c\x02\xff"},
		{5, 0, -9, 1, -1, 3, "\x10\x00\x00\x00\x03\x00\x81a\x02\x81b\x02\x81c\x02\xff"},
		{5, 0, -9, 99, -1, 3, "\x10\x00\x00\x00\x03\x00\x81a\x02\x81b\x02\x81c\x02\xff"},
		{5, 0, -3, 0, -1, 3, "\x10\x00\x00\x00\x03\x00\x81a\x02\x81b\x02\x81c\x02\xff"},
		{5, 0, -3, 1, -1, 2, "\x0d\x00\x00\x00\x02\x00\x81b\x02\x81c\x02\xff"},
		{5, 0, -3, 99, -1, 0, "\x07\x00\x00\x00\x00\x00\xff"},
		{5, 0, -1, 0, -1, 3, "\x10\x00\x00\x00\x03\x00\x81a\x02\x81b\x02\x81c\x02\xff"},
		{5, 0, -1, 1, -1, 2, "\x0d\x00\x00\x00\x02\x00\x81a\x02\x81b\x02\xff"},
		{5, 0, -1, 99, -1, 2, "\x0d\x00\x00\x00\x02\x00\x81a\x02\x81b\x02\xff"},
		{5, 0, 0, 0, -1, 3, "\x10\x00\x00\x00\x03\x00\x81a\x02\x81b\x02\x81c\x02\xff"},
		{5, 0, 0, 1, -1, 2, "\x0d\x00\x00\x00\x02\x00\x81b\x02\x81c\x02\xff"},
		{5, 0, 0, 99, -1, 0, "\x07\x00\x00\x00\x00\x00\xff"},
		{5, 0, 1, 0, -1, 3, "\x10\x00\x00\x00\x03\x00\x81a\x02\x81b\x02\x81c\x02\xff"},
		{5, 0, 1, 1, -1, 2, "\x0d\x00\x00\x00\x02\x00\x81a\x02\x81c\x02\xff"},
		{5, 0, 1, 99, -1, 1, "\x0a\x00\x00\x00\x01\x00\x81a\x02\xff"},
		{5, 0, 2, 0, -1, 3, "\x10\x00\x00\x00\x03\x00\x81a\x02\x81b\x02\x81c\x02\xff"},
		{5, 0, 2, 1, -1, 2, "\x0d\x00\x00\x00\x02\x00\x81a\x02\x81b\x02\xff"},
		{5, 0, 2, 99, -1, 2, "\x0d\x00\x00\x00\x02\x00\x81a\x02\x81b\x02\xff"},
		{5, 0, 3, 0, -1, 3, "\x10\x00\x00\x00\x03\x00\x81a\x02\x81b\x02\x81c\x02\xff"},
		{5, 0, 3, 1, -1, 3, "\x10\x00\x00\x00\x03\x00\x81a\x02\x81b\x02\x81c\x02\xff"},
		{5, 0, 3, 99, -1, 3, "\x10\x00\x00\x00\x03\x00\x81a\x02\x81b\x02\x81c\x02\xff"},
		{5, 0, 9, 0, -1, 3, "\x10\x00\x00\x00\x03\x00\x81a\x02\x81b\x02\x81c\x02\xff"},
		{5, 0, 9, 1, -1, 3, "\x10\x00\x00\x00\x03\x00\x81a\x02\x81b\x02\x81c\x02\xff"},
		{5, 0, 9, 99, -1, 3, "\x10\x00\x00\x00\x03\x00\x81a\x02\x81b\x02\x81c\x02\xff"},
		{6, 0, 0, 0, -1, 3, "\x10\x00\x00\x00\x03\x00\x81a\x02\x81b\x02\x81c\x02\xff"},
		{6, 0, 0, 1, -1, 2, "\x0d\x00\x00\x00\x02\x00\x81b\x02\x81c\x02\xff"},
		{6, 0, 0, 2, -1, 1, "\x0a\x00\x00\x00\x01\x00\x81c\x02\xff"},
		{6, 0, 0, 3, -1, 0, "\x07\x00\x00\x00\x00\x00\xff"},
	}
	for fixture in fixtures {
		lp := test_pack([]Element{entry_from_bytes(transmute([]u8)string("a")), entry_from_bytes(transmute([]u8)string("b")), entry_from_bytes(transmute([]u8)string("c"))})
		cursor: [^]u8
		switch fixture.operation {
		case 0:
			lp = lp_insert_integer(lp, 17, lp_seek(lp, i64(fixture.index)), Placement(fixture.where_), &cursor)
		case 1:
			lp = lp_insert_string(lp, nil, padd(lp, lp_bytes(lp) - 1), Placement.Before, &cursor)
		case 2:
			lp = lp_delete(lp, lp_seek(lp, i64(fixture.index)), &cursor)
		case 3:
			cursor = lp_seek(lp, 1)
			lp = lp_delete_range_with_entry(lp, &cursor, 99)
		case 4:
			batch := [4]Element{entry_from_bytes(transmute([]u8)string("x")), entry_from_int(-8), entry_from_bytes(nil), entry_from_int(9)}
			lp = lp_splice_entries(lp, batch[:int(fixture.num)], lp_seek(lp, 1), Placement(fixture.where_), &cursor)
		case 5:
			lp = lp_delete_range(lp, i64(fixture.index), fixture.num)
		case 6:
			positions := [3][^]u8{lp_seek(lp, 0), lp_seek(lp, 1), lp_seek(lp, 2)}
			lp = lp_batch_delete(lp, positions[:int(fixture.num)])
		}
		testing.expect(t, lp != nil && string(lp_view(lp)) == fixture.wire)
		testing.expect(t, lp_get_num_elements(lp) == fixture.count)
		testing.expect(t, cursor == nil if fixture.cursor < 0 else cursor == padd(lp, fixture.cursor))
		testing.expect(t, lp_malloc_size(lp) >= lp_bytes(lp))
		lp_free(lp)
	}
}

@(test)
observed_merges_preserve_handle_owner_and_literal_concatenation :: proc(t: ^testing.T) {
	Fixture :: struct { left, right: int, wire: string }
	fixtures := []Fixture{
		{0, 0, "\x07\x00\x00\x00\x00\x00\xff"},
		{0, 1, "\x0a\x00\x00\x00\x01\x00\x81b\x02\xff"},
		{0, 2, "\x0d\x00\x00\x00\x02\x00\x81b\x02\x81b\x02\xff"},
		{0, 3, "\x10\x00\x00\x00\x03\x00\x81b\x02\x81b\x02\x81b\x02\xff"},
		{1, 0, "\x19\x00\x00\x00\x01\x00\x90left-long-string\x11\xff"},
		{1, 1, "\x1c\x00\x00\x00\x02\x00\x90left-long-string\x11\x81b\x02\xff"},
		{1, 2, "\x1f\x00\x00\x00\x03\x00\x90left-long-string\x11\x81b\x02\x81b\x02\xff"},
		{1, 3, "\"\x00\x00\x00\x04\x00\x90left-long-string\x11\x81b\x02\x81b\x02\x81b\x02\xff"},
		{2, 0, "+\x00\x00\x00\x02\x00\x90left-long-string\x11\x90left-long-string\x11\xff"},
		{2, 1, ".\x00\x00\x00\x03\x00\x90left-long-string\x11\x90left-long-string\x11\x81b\x02\xff"},
		{2, 2, "1\x00\x00\x00\x04\x00\x90left-long-string\x11\x90left-long-string\x11\x81b\x02\x81b\x02\xff"},
		{2, 3, "4\x00\x00\x00\x05\x00\x90left-long-string\x11\x90left-long-string\x11\x81b\x02\x81b\x02\x81b\x02\xff"},
		{3, 0, "=\x00\x00\x00\x03\x00\x90left-long-string\x11\x90left-long-string\x11\x90left-long-string\x11\xff"},
		{3, 1, "@\x00\x00\x00\x04\x00\x90left-long-string\x11\x90left-long-string\x11\x90left-long-string\x11\x81b\x02\xff"},
		{3, 2, "C\x00\x00\x00\x05\x00\x90left-long-string\x11\x90left-long-string\x11\x90left-long-string\x11\x81b\x02\x81b\x02\xff"},
		{3, 3, "F\x00\x00\x00\x06\x00\x90left-long-string\x11\x90left-long-string\x11\x90left-long-string\x11\x81b\x02\x81b\x02\x81b\x02\xff"},
	}
	for fixture in fixtures {
		left, right := lp_new(0), lp_new(0)
		for _ in 0..<fixture.left {
			left = lp_append(left, transmute([]u8)string("left-long-string"))
		}
		for _ in 0..<fixture.right {
			right = lp_append(right, transmute([]u8)string("b"))
		}
		keep_left := lp_bytes(left) >= lp_bytes(right)
		result := lp_merge(&left, &right)
		testing.expect(t, result != nil && string(lp_view(result)) == fixture.wire)
		testing.expect(t, left == result && right == nil if keep_left else right == result && left == nil)
		testing.expect(t, lp_validate_integrity(result, u64(lp_bytes(result)), true, nil, nil))
		lp_free(result)
	}
}
