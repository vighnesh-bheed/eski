package listpack

import "core:testing"

@(test)
captured_integer_bytes_and_decimal_sentinels :: proc(t: ^testing.T) {
	Fixture :: struct {
		value: i64,
		pack: string,
		decimal: string,
	}
	fixtures := []Fixture{
		{-9223372036854775808, "\x11\x00\x00\x00\x01\x00\xf4\x00\x00\x00\x00\x00\x00\x00\x80\x09\xff", "\x2d\x39\x32\x32\x33\x33\x37\x32\x30\x33\x36\x38\x35\x34\x37\x37\x35\x38\x30\x38"},
		{-2147483649, "\x11\x00\x00\x00\x01\x00\xf4\xff\xff\xff\x7f\xff\xff\xff\xff\x09\xff", "\x2d\x32\x31\x34\x37\x34\x38\x33\x36\x34\x39"},
		{-2147483648, "\x0d\x00\x00\x00\x01\x00\xf3\x00\x00\x00\x80\x05\xff", "\x2d\x32\x31\x34\x37\x34\x38\x33\x36\x34\x38"},
		{-8388609, "\x0d\x00\x00\x00\x01\x00\xf3\xff\xff\x7f\xff\x05\xff", "\x2d\x38\x33\x38\x38\x36\x30\x39"},
		{-8388608, "\x0c\x00\x00\x00\x01\x00\xf2\x00\x00\x80\x04\xff", "\x2d\x38\x33\x38\x38\x36\x30\x38"},
		{-32769, "\x0c\x00\x00\x00\x01\x00\xf2\xff\x7f\xff\x04\xff", "\x2d\x33\x32\x37\x36\x39"},
		{-32768, "\x0b\x00\x00\x00\x01\x00\xf1\x00\x80\x03\xff", "\x2d\x33\x32\x37\x36\x38"},
		{-4097, "\x0b\x00\x00\x00\x01\x00\xf1\xff\xef\x03\xff", "\x2d\x34\x30\x39\x37"},
		{-4096, "\x0a\x00\x00\x00\x01\x00\xd0\x00\x02\xff", "\x2d\x34\x30\x39\x36"},
		{-1, "\x0a\x00\x00\x00\x01\x00\xdf\xff\x02\xff", "\x2d\x31"},
		{0, "\x09\x00\x00\x00\x01\x00\x00\x01\xff", "\x30"},
		{1, "\x09\x00\x00\x00\x01\x00\x01\x01\xff", "\x31"},
		{127, "\x09\x00\x00\x00\x01\x00\x7f\x01\xff", "\x31\x32\x37"},
		{128, "\x0a\x00\x00\x00\x01\x00\xc0\x80\x02\xff", "\x31\x32\x38"},
		{4095, "\x0a\x00\x00\x00\x01\x00\xcf\xff\x02\xff", "\x34\x30\x39\x35"},
		{4096, "\x0b\x00\x00\x00\x01\x00\xf1\x00\x10\x03\xff", "\x34\x30\x39\x36"},
		{32767, "\x0b\x00\x00\x00\x01\x00\xf1\xff\x7f\x03\xff", "\x33\x32\x37\x36\x37"},
		{32768, "\x0c\x00\x00\x00\x01\x00\xf2\x00\x80\x00\x04\xff", "\x33\x32\x37\x36\x38"},
		{8388607, "\x0c\x00\x00\x00\x01\x00\xf2\xff\xff\x7f\x04\xff", "\x38\x33\x38\x38\x36\x30\x37"},
		{8388608, "\x0d\x00\x00\x00\x01\x00\xf3\x00\x00\x80\x00\x05\xff", "\x38\x33\x38\x38\x36\x30\x38"},
		{2147483647, "\x0d\x00\x00\x00\x01\x00\xf3\xff\xff\xff\x7f\x05\xff", "\x32\x31\x34\x37\x34\x38\x33\x36\x34\x37"},
		{2147483648, "\x11\x00\x00\x00\x01\x00\xf4\x00\x00\x00\x80\x00\x00\x00\x00\x09\xff", "\x32\x31\x34\x37\x34\x38\x33\x36\x34\x38"},
		{9223372036854775807, "\x11\x00\x00\x00\x01\x00\xf4\xff\xff\xff\xff\xff\xff\xff\x7f\x09\xff", "\x39\x32\x32\x33\x33\x37\x32\x30\x33\x36\x38\x35\x34\x37\x37\x35\x38\x30\x37"},
	}
	for fixture in fixtures {
		expected := transmute([]u8)fixture.pack
		lp := lp_new(len(expected))
		testing.expect(t, lp != nil)
		if lp == nil {
			continue
		}
		lp_set_total_bytes(lp, u64(len(expected)))
		lp_set_num_elements(lp, 1)
		length, valid := write_integer(lp[6:len(expected) - 2], fixture.value)
		testing.expect(t, valid && length == len(expected) - 8)
		width := lp_encode_backlen(padd(lp, 6 + length), u64(length))
		testing.expect(t, width == 1)
		lp[len(expected) - 1] = LP_EOF
		for byte, index in expected {
			testing.expect(t, lp[index] == byte)
		}
		storage: [LP_INTBUF_SIZE]u8
		for index in 0..<len(storage) {
			storage[index] = 238
		}
		digits := ll2string(raw_data(storage[:]), fixture.value)
		testing.expect(t, string(storage[:digits]) == fixture.decimal && storage[digits] == 238)
		lp_free(lp)
	}
}

@(test)
captured_reverse_length_widths_and_bounded_left_edges :: proc(t: ^testing.T) {
	Fixture :: struct {
		length: u64,
		hex: string,
	}
	fixtures := []Fixture{
		{0, "\x00"},
		{1, "\x01"},
		{127, "\x7f"},
		{128, "\x01\x80"},
		{16382, "\x7f\xfe"},
		{16383, "\x00\xff\xff"},
		{16384, "\x01\x80\x80"},
		{2097150, "\x7f\xff\xfe"},
		{2097151, "\x00\xff\xff\xff"},
		{2097152, "\x01\x80\x80\x80"},
		{268435454, "\x7f\xff\xff\xfe"},
		{268435455, "\x00\xff\xff\xff\xff"},
		{268435456, "\x01\x80\x80\x80\x80"},
		{1073741823, "\x03\xff\xff\xff\xff"},
	}
	for fixture in fixtures {
		storage: [7]u8
		for index in 0..<len(storage) {
			storage[index] = 238
		}
		width := int(lp_encode_backlen(raw_data(storage[1:]), fixture.length))
		testing.expect(t, width == len(fixture.hex) && int(lp_encode_backlen(nil, fixture.length)) == width)
		testing.expect(t, storage[0] == 238 && storage[width + 1] == 238 && string(storage[1:width + 1]) == fixture.hex)
		decoded, read_width, valid := read_backlen(storage[:width + 1], width, 1)
		testing.expect(t, valid && read_width == width && decoded == fixture.length)
		testing.expect(t, lp_decode_backlen(raw_data(storage[width:])) == fixture.length)
		for cut in 1..<width {
			_, _, truncated_valid := read_backlen(storage[1 + cut:width + 1], width - cut - 1, 0)
			testing.expect(t, !truncated_valid)
		}
	}
}
