		{"", 128, "", "\x8f\x00\x00\x00\x02\x00\x82\x75\x3a\x03\xe0\x80", "\x01\x82\xff", 143},
		{"", 498, "", "\x01\x02\x00\x00\x02\x00\x82\x75\x3a\x03\xe1\xf2", "\x03\xf4\xff", 513},
		{"", 4094, "", "\x0d\x10\x00\x00\x02\x00\x82\x75\x3a\x03\xef\xfe", "\x20\x80\xff", 4109},
		{"", 4095, "", "\x0e\x10\x00\x00\x02\x00\x82\x75\x3a\x03\xef\xff", "\x20\x81\xff", 4110},
		{"", 4096, "", "\x12\x10\x00\x00\x02\x00\x82\x75\x3a\x03\xf0\x00\x10\x00\x00", "\x20\x85\xff", 4114},
		{"", 4097, "", "\x13\x10\x00\x00\x02\x00\x82\x75\x3a\x03\xf0\x01\x10\x00\x00", "\x20\x86\xff", 4115},
		{"", 16377, "", "\x0b\x40\x00\x00\x02\x00\x82\x75\x3a\x03\xf0\xf9\x3f\x00\x00", "\x7f\xfe\xff", 16395},
		{"", 16378, "", "\x0d\x40\x00\x00\x02\x00\x82\x75\x3a\x03\xf0\xfa\x3f\x00\x00", "\x00\xff\xff\xff", 16397},
		{"", 16379, "", "\x0e\x40\x00\x00\x02\x00\x82\x75\x3a\x03\xf0\xfb\x3f\x00\x00", "\x01\x80\x80\xff", 16398},
		{"", 2097145, "", "\x0c\x00\x20\x00\x02\x00\x82\x75\x3a\x03\xf0\xf9\xff\x1f\x00", "\x7f\xff\xfe\xff", 2097164},
		{"", 2097146, "", "\x0e\x00\x20\x00\x02\x00\x82\x75\x3a\x03\xf0\xfa\xff\x1f\x00", "\x00\xff\xff\xff\xff", 2097166},
		{"", 2097147, "", "\x0f\x00\x20\x00\x02\x00\x82\x75\x3a\x03\xf0\xfb\xff\x1f\x00", "\x01\x80\x80\x80\xff", 2097167},
	}
	for fixture in fixtures {
		input := transmute([]u8)fixture.input
		owned_input: []u8
		if fixture.cycle >= 0 {
			owned_input = make([]u8, fixture.cycle)
			for index in 0..<len(owned_input) {
				owned_input[index] = u8(index % 256)
			}
			input = owned_input
		}
		defer delete(owned_input)
		expected := transmute([]u8)fixture.full
		owned_expected: []u8
		if fixture.cycle >= 0 {
			owned_expected = make([]u8, fixture.total)
			copy(owned_expected, transmute([]u8)fixture.prefix)
			copy(owned_expected[len(fixture.prefix):], input)
			copy(owned_expected[len(fixture.prefix) + len(input):], transmute([]u8)fixture.suffix)
			expected = owned_expected
		}
		defer delete(owned_expected)
		field_plan, field_valid := plan_entry(entry_from_bytes(transmute([]u8)string("u:")))
		value_plan, value_valid := plan_entry(entry_from_bytes(input))
		testing.expect(t, field_valid && value_valid)
		if !field_valid || !value_valid {
			continue
		}
		total := LP_HDR_SIZE + 1 + field_plan.encoded_bytes + value_plan.encoded_bytes
		testing.expect(t, total == fixture.total)
		lp := lp_new(total)
		defer lp_free(lp)
		testing.expect(t, lp != nil)
		if lp == nil {
			continue
		}
		lp_set_total_bytes(lp, u64(total))
		lp_set_num_elements(lp, 2)
		testing.expect(t, write_entry(lp[6:6 + field_plan.encoded_bytes], field_plan))
		start := 6 + field_plan.encoded_bytes
		testing.expect(t, write_entry(lp[start:total - 1], value_plan))
		lp[total - 1] = LP_EOF
		testing.expect(t, string(lp[:total]) == string(expected))
		testing.expect(t, lp_validate_integrity(lp, u64(total), true, nil, nil))
		first := lp_first(lp)
		last := lp_last(lp)
		testing.expect(t, first == padd(lp, 6) && last == padd(lp, start) && lp_next(lp, first) == last)
		testing.expect(t, lp_prev(lp, last) == first && lp_next(lp, last) == nil && lp_prev(lp, first) == nil)
		value_buffer: [LP_INTBUF_SIZE]u8
		testing.expect(t, string(lp_get_bytes(last, &value_buffer)) == string(input))
		body, valid := decode_body(lp[:total - 1], start)
		testing.expect(t, valid)
		if body.is_string {
			testing.expect(t, string(lp[body.string_offset:body.string_offset + body.string_length]) == string(input))
		} else {
			buffer: [LP_INTBUF_SIZE]u8
			length := ll2string(raw_data(buffer[:]), body.value)
			testing.expect(t, string(buffer[:length]) == string(input))
		}
	}
}

@(test)
redis_deep_validation_acceptance_recipes :: proc(t: ^testing.T) {
	Fixture :: struct {
		wire: string,
		prefix: string,
		cycle: int,
		suffix: string,
		accepted: bool,
	}
	fixtures := []Fixture{
		{"\x0d\x00\x00\x00\x02\x00\x82\x75\x3a\x03\x00\x01\xff", "", -1, "", true},
		{"\x0d\x00\x00\x00\x02\x00\x82\x75\x3a\x03\x00\x81\xff", "", -1, "", true},
		{"\x0d\x00\x00\x00\x02\x00\x82\x75\x3a\x03\x01\x81\xff", "", -1, "", false},
		{"\x0e\x00\x00\x00\x02\x00\x82\x75\x3a\x03\x00\x00\x81\xff", "", -1, "", false},
		{"\x0d\x00\x00\x00\x02\x00\x82\x75\x3a\x03\x00\x00\xff", "", -1, "", false},
		{"\x0e\x00\x00\x00\x02\x00\x82\x75\x3a\x03\xc0\x00\x02\xff", "", -1, "", true},
		{"\x0e\x00\x00\x00\x02\x00\x82\x75\x3a\x03\xc0\x00\x82\xff", "", -1, "", true},
		{"\x0f\x00\x00\x00\x02\x00\x82\x75\x3a\x03\xf1\x01\x00\x03\xff", "", -1, "", true},
		{"\x10\x00\x00\x00\x02\x00\x82\x75\x3a\x03\xf2\x01\x00\x00\x04\xff", "", -1, "", true},
		{"\x11\x00\x00\x00\x02\x00\x82\x75\x3a\x03\xf3\x01\x00\x00\x00\x05\xff", "", -1, "", true},
		{"\x15\x00\x00\x00\x02\x00\x82\x75\x3a\x03\xf4\x01\x00\x00\x00\x00\x00\x00\x00\x09\xff", "", -1, "", true},
		{"\x0f\x00\x00\x00\x02\x00\x82\x75\x3a\x03\xe0\x01\x7a\x03\xff", "", -1, "", true},
		{"\x12\x00\x00\x00\x02\x00\x82\x75\x3a\x03\xf0\x01\x00\x00\x00\x7a\x06\xff", "", -1, "", true},
		{"\x0e\x00\x00\x00\x02\x00\x82\x75\x3a\x03\xe0\x00\x02\xff", "", -1, "", true},
		{"\x11\x00\x00\x00\x02\x00\x82\x75\x3a\x03\xf0\x00\x00\x00\x00\x05\xff", "", -1, "", true},
		{"\x0e\x00\x00\x00\x02\x00\x82\x75\x3a\x03\x81\x31\x02\xff", "", -1, "", true},
		{"\x0f\x00\x00\x00\x02\x00\x82\x75\x3a\x03\x82\x61\x00\x83\xff", "", -1, "", true},
		{"\x0d\x00\x00\x00\x02\x00\x82\x75\x3a\x03\xf5\x01\xff", "", -1, "", false},
		{"\x11\x00\x00\x00\x02\x00\x82\x75\x3a\x03\xf0\xff\xff\xff\xff\x05\xff", "", -1, "", false},
		{"\x0d\x00\x00\x00\x03\x00\x82\x75\x3a\x03\x00\x01\xff", "", -1, "", false},
		{"\x0d\x00\x00\x00\x01\x00\x82\x75\x3a\x03\x00\x01\xff", "", -1, "", false},
		{"\x0d\x00\x00\x00\xff\xff\x82\x75\x3a\x03\x00\x01\xff", "", -1, "", true},
		{"\x0e\x00\x00\x00\x02\x00\x82\x75\x3a\x03\x00\x01\xff", "", -1, "", false},
		{"\x0c\x00\x00\x00\x02\x00\x82\x75\x3a\x03\x00\x01\xff", "", -1, "", false},
		{"\x0e\x00\x00\x00\x02\x00\x82\x75\x3a\x03\x00\x01\xff\xff", "", -1, "", false},
		{"", "\x0c\x40\x00\x00\x02\x00\x82\x75\x3a\x03\xf0\xfa\x3f\x00\x00", 16378, "\x7f\xff\xff", false},
	}
	for fixture in fixtures {
		wire := transmute([]u8)fixture.wire
		owned: []u8
		if fixture.cycle >= 0 {
			owned = make([]u8, len(fixture.prefix) + fixture.cycle + len(fixture.suffix))
			copy(owned, transmute([]u8)fixture.prefix)
			for index in 0..<fixture.cycle {
				owned[len(fixture.prefix) + index] = u8(index % 256)
			}
			copy(owned[len(fixture.prefix) + fixture.cycle:], transmute([]u8)fixture.suffix)
			wire = owned
		}
		defer delete(owned)
		testing.expect(t, lp_validate_integrity(raw_data(wire), u64(len(wire)), true, nil, nil) == fixture.accepted)
	}
}
