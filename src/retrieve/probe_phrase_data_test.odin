package retrieve

Phrase_Doc :: struct {
	key:    int,
	fields: []string,
}

Phrase_Case :: struct {
	corpus:   string,
	field:    string,
	words:    []string,
	slop:     int,
	in_order: bool,
	docs:     []int,
}

Phrase_Corpus :: struct {
	name: string,
	docs: []Phrase_Doc,
}

PHRASE_CORPORA := [?]Phrase_Corpus {
	{name = "dp", docs = {{key = 0, fields = {"fox dog"}}, {key = 1, fields = {"fox fox dog"}}, {key = 2, fields = {"dog fox"}}, {key = 3, fields = {"fox"}}, {key = 4, fields = {"a1 x b1 x c1"}}, {key = 5, fields = {"a1 x x b1 c1"}}, {key = 6, fields = {"c1 a1 b1"}}, {key = 7, fields = {"b1 x x a1 y b1"}}, {key = 8, fields = {"a1 b1 a1"}}, {key = 9, fields = {"b1 a1 x b1"}}}},
	{name = "ph", docs = {{key = 1, fields = {"alpha", "beta"}}, {key = 2, fields = {"beta", "alpha"}}, {key = 3, fields = {"alpha beta", ""}}, {key = 4, fields = {"alpha gamma", "beta"}}, {key = 5, fields = {"", "alpha beta"}}}},
	{name = "ph2", docs = {{key = 6, fields = {"beta", "alpha"}}, {key = 7, fields = {"beta", "alpha"}}, {key = 8, fields = {"alpha", "beta"}}}},
	{name = "z", docs = {{key = 1, fields = {"alpha x beta", "alpha beta"}}, {key = 2, fields = {"alpha", "x beta"}}}},
}

