package main

import "core:strconv"
import "core:sys/linux"

Config_Type :: enum u8 {
	Bool,
	Num,
	Enum,
	Str,
	Special,
}

Config_Flag :: enum u8 {
	Immutable,
	Sensitive,
	Multi_Arg,
	Hidden,
	Protected,
	Deny_Loading,
	Memory,
	Percent,
	Octal,
	Unsigned,
	Null_Empty,
}

Config_Flags :: bit_set[Config_Flag;u16]

Config_Enum :: struct {
	name:  string,
	value: int,
}

Config_Store :: union {
	^bool,
	^int,
	^i64,
	^u64,
	^u8,
	^string,
}

Config_Special :: struct {
	set:     proc(args: [][]u8) -> (changed: bool, err: string),
	get:     proc(b: ^[dynamic]u8),
	rewrite: proc(rs: ^Rewrite_State, cf: ^Config),
}

Config :: struct {
	name:    string,
	alias:   string,
	type:    Config_Type,
	flags:   Config_Flags,
	lo:      i64,
	hi:      u64,
	def:     i64,
	sdef:    string,
	enums:   []Config_Enum,
	store:   Config_Store,
	check:   proc(v: i64, s: []u8) -> string,
	apply:   proc() -> string,
	special: ^Config_Special,
}

Rewrite_State :: struct {
	lines:           [dynamic]string,
	option_lines:    map[string][dynamic]int,
	rewritten:       map[string]bool,
	needs_signature: bool,
	force_write:     bool,
}

CONFIG_REWRITE_SIGNATURE :: "# Generated by CONFIG REWRITE"
CONFIG_BIND_MAX :: 16
CONFIG_DEFAULT_BIND :: "* -::*"
CONFIG_MIN_HZ :: 1
CONFIG_MAX_HZ :: 500
CONFIG_MIN_RESERVED_FDS :: 32
OOM_SCORE_DEFAULTS :: [3]i64{0, 200, 800}

config_file: string
config_reading_file: bool
config_save_loaded: bool
config_bind: [dynamic]string
config_oom_values := OOM_SCORE_DEFAULTS
config_oom_base: i64
config_oom_base_read: bool
config_replica_host: string
config_replica_port: i64
config_percentiles: [dynamic]f64
config_hz_current: i64 = 10

@(private = "file")
config_err_buf: [dynamic]u8
@(private = "file")
config_val_buf: [dynamic]u8

config_lookup :: proc(name: []u8) -> ^Config {
	cf, _ := config_lookup_named(name)
	return cf
}

config_lookup_named :: proc(name: []u8) -> (^Config, string) {
	for &cf in configs {
		if eq_nocase(name, cf.name) {
			return &cf, cf.name
		}
		if cf.alias != "" && eq_nocase(name, cf.alias) {
			return &cf, cf.alias
		}
	}
	return nil, ""
}

eq_fold :: proc "contextless" (a: []u8, b: []u8) -> bool {
	if len(a) != len(b) {
		return false
	}
	for i in 0 ..< len(a) {
		if lower(a[i]) != lower(b[i]) {
			return false
		}
	}
	return true
}

@(private = "file")
config_errf :: proc(parts: ..string) -> string {
	clear(&config_err_buf)
	for p in parts {
		sb_str(&config_err_buf, p)
	}
	return string(config_err_buf[:])
}

sb_u64 :: proc(b: ^[dynamic]u8, v: u64) {
	tmp: [20]u8
	i := 20
	x := v
	for {
		i -= 1
		tmp[i] = u8('0' + x % 10)
		x /= 10
		if x == 0 {
			break
		}
	}
	append(b, ..tmp[i:])
}

@(private = "file")
sb_octal :: proc(b: ^[dynamic]u8, v: u64) {
	tmp: [24]u8
	i := 24
	x := v
	for {
		i -= 1
		tmp[i] = u8('0' + x % 8)
		x /= 8
		if x == 0 {
			break
		}
	}
	append(b, ..tmp[i:])
}

config_memtoull :: proc "contextless" (s: []u8) -> (u64, bool) {
	if len(s) > 0 && s[0] == '-' {
		return 0, false
	}
	digits := 0
	for digits < len(s) && s[digits] >= '0' && s[digits] <= '9' {
		digits += 1
	}
	unit := s[digits:]
	mul: u64
	switch {
	case len(unit) == 0 || eq_nocase(unit, "b"):
		mul = 1
	case eq_nocase(unit, "k"):
		mul = 1000
	case eq_nocase(unit, "kb"):
		mul = 1024
	case eq_nocase(unit, "m"):
		mul = 1000 * 1000
	case eq_nocase(unit, "mb"):
		mul = 1024 * 1024
	case eq_nocase(unit, "g"):
		mul = 1000 * 1000 * 1000
	case eq_nocase(unit, "gb"):
		mul = 1024 * 1024 * 1024
	case:
		return 0, false
	}
	if digits >= 128 {
		return 0, false
	}
	val: u64 = 0
	for b in s[:digits] {
		d := u64(b - '0')
		if val > (max(u64) - d) / 10 {
			val = max(u64)
			break
		}
		val = val * 10 + d
	}
	return val * mul, true
}

config_strtoll :: proc "contextless" (s: []u8, base: u64) -> (v: i64, ok: bool) {
	i := 0
	for i < len(s) && (s[i] == ' ' || (s[i] >= '\t' && s[i] <= '\r')) {
		i += 1
	}
	neg := false
	if i < len(s) && (s[i] == '+' || s[i] == '-') {
		neg = s[i] == '-'
		i += 1
	}
	start := i
	acc: u64 = 0
	overflow := false
	for i < len(s) {
		d := u64(s[i]) - '0'
		if d >= base {
			break
		}
		if acc > (max(u64) - d) / base {
			overflow = true
		} else {
			acc = acc * base + d
		}
		i += 1
	}
	if i == start {
		return 0, len(s) == 0
	}
	if i != len(s) {
		return 0, false
	}
	limit: u64 = u64(max(i64)) + 1 if neg else u64(max(i64))
	if overflow || acc > limit {
		return 0, false
	}
	return -i64(acc) if neg else i64(acc), true
}

config_num_value :: proc(cf: ^Config) -> i64 {
	switch p in cf.store {
	case ^int:
		return i64(p^)
	case ^i64:
		return p^
	case ^u64:
		return cast(i64)p^
	case ^u8:
		return i64(p^)
	case ^bool:
		return 1 if p^ else 0
	case ^string:
	}
	return 0
}

@(private = "file")
config_num_store :: proc(cf: ^Config, v: i64) {
	switch p in cf.store {
	case ^int:
		p^ = int(v)
	case ^i64:
		p^ = v
	case ^u64:
		p^ = cast(u64)v
	case ^u8:
		p^ = u8(v)
	case ^bool:
		p^ = v != 0
	case ^string:
	}
}

@(private = "file")
config_str_value :: proc(cf: ^Config) -> string {
	if p, ok := cf.store.(^string); ok {
		return p^
	}
	return ""
}

@(private = "file")
config_str_store :: proc(cf: ^Config, v: []u8) {
	if p, ok := cf.store.(^string); ok {
		old := p^
		p^ = string(clone_bytes(v))
		if len(old) > 0 {
			delete(old)
		}
	}
}

clone_bytes :: proc(v: []u8) -> []u8 {
	if len(v) == 0 {
		return nil
	}
	out := make([]u8, len(v))
	copy(out, v)
	return out
}

@(private = "file")
config_format_num :: proc(b: ^[dynamic]u8, cf: ^Config, v: i64) {
	switch {
	case .Percent in cf.flags && v < 0:
		sb_int(b, -v)
		sb_byte(b, '%')
	case .Memory in cf.flags:
		sb_u64(b, cast(u64)v)
	case .Octal in cf.flags:
		sb_octal(b, cast(u64)v)
	case:
		sb_int(b, v)
	}
}

config_enum_name :: proc(b: ^[dynamic]u8, cf: ^Config, value: int) {
	bitflags := .Multi_Arg in cf.flags
	start := len(b)
	unmatched := value
	any := false
	for e in cf.enums {
		if value == e.value {
			resize(b, start)
			sb_str(b, e.name)
			return
		}
		if bitflags && e.value != 0 && e.value == (unmatched & e.value) {
			if any {
				sb_byte(b, ' ')
			}
			sb_str(b, e.name)
			any = true
			unmatched &= ~e.value
		}
	}
	if !any || unmatched != 0 {
		resize(b, start)
		sb_str(b, "unknown")
	}
}

@(private = "file")
config_enum_value :: proc(cf: ^Config, args: [][]u8) -> (int, bool) {
	bitflags := .Multi_Arg in cf.flags
	if len(args) == 0 || (!bitflags && len(args) != 1) {
		return 0, false
	}
	values := 0
	for a in args {
		matched := false
		for e in cf.enums {
			if eq_nocase(a, e.name) {
				values |= e.value
				matched = true
			}
		}
		if !matched {
			return 0, false
		}
	}
	return values, true
}

config_get :: proc(cf: ^Config, b: ^[dynamic]u8) {
	switch cf.type {
	case .Bool:
		sb_str(b, "yes" if config_num_value(cf) != 0 else "no")
	case .Num:
		config_format_num(b, cf, config_num_value(cf))
	case .Enum:
		config_enum_name(b, cf, int(config_num_value(cf)))
	case .Str:
		sb_str(b, config_str_value(cf))
	case .Special:
		cf.special.get(b)
	}
}

config_value_string :: proc(cf: ^Config) -> string {
	clear(&config_val_buf)
	config_get(cf, &config_val_buf)
	return string(config_val_buf[:])
}

@(private = "file")
config_parse_num :: proc(cf: ^Config, s: []u8) -> (v: i64, err: string) {
	if .Memory in cf.flags {
		if u, ok := config_memtoull(s); ok {
			return cast(i64)u, ""
		}
	}
	if .Percent in cf.flags && len(s) > 1 && s[len(s) - 1] == '%' {
		if n, ok := parse_i64(s[:len(s) - 1]); ok && n >= 0 {
			return -n, ""
		}
	}
	if .Octal in cf.flags {
		if n, ok := config_strtoll(s, 8); ok {
			return n, ""
		}
	}
	if cf.flags & {.Memory, .Percent, .Octal} == {} {
		if n, ok := parse_i64(s); ok {
			return n, ""
		}
	}
	switch {
	case .Memory in cf.flags && .Percent in cf.flags:
		return 0, "argument must be a memory or percent value"
	case .Memory in cf.flags:
		return 0, "argument must be a memory value"
	case .Octal in cf.flags:
		return 0, "argument couldn't be parsed as an octal number"
	}
	return 0, "argument couldn't be parsed into an integer"
}

@(private = "file")
config_bounds :: proc(cf: ^Config, v: i64) -> string {
	if .Unsigned in cf.flags {
		u := cast(u64)v
		if u > cf.hi || u < u64(cf.lo) {
			clear(&config_err_buf)
			sb_str(&config_err_buf, "argument must be between ")
			if .Octal in cf.flags {
				sb_octal(&config_err_buf, u64(cf.lo))
				sb_str(&config_err_buf, " and ")
				sb_octal(&config_err_buf, cf.hi)
			} else {
				sb_u64(&config_err_buf, u64(cf.lo))
				sb_str(&config_err_buf, " and ")
				sb_u64(&config_err_buf, cf.hi)
			}
			sb_str(&config_err_buf, " inclusive")
			return string(config_err_buf[:])
		}
		return ""
	}
	if .Percent in cf.flags && v < 0 {
		if v < cf.lo {
			clear(&config_err_buf)
			sb_str(&config_err_buf, "percentage argument must be less or equal to ")
			sb_int(&config_err_buf, -cf.lo)
			return string(config_err_buf[:])
		}
		return ""
	}
	if v > i64(cf.hi) || v < cf.lo {
		clear(&config_err_buf)
		sb_str(&config_err_buf, "argument must be between ")
		sb_int(&config_err_buf, cf.lo)
		sb_str(&config_err_buf, " and ")
		sb_int(&config_err_buf, i64(cf.hi))
		sb_str(&config_err_buf, " inclusive")
		return string(config_err_buf[:])
	}
	return ""
}

config_set :: proc(cf: ^Config, args: [][]u8) -> (changed: bool, err: string) {
	switch cf.type {
	case .Bool:
		v: i64
		switch {
		case eq_nocase(args[0], "yes"):
			v = 1
		case eq_nocase(args[0], "no"):
			v = 0
		case:
			return false, "argument must be 'yes' or 'no'"
		}
		if cf.check != nil {
			if e := cf.check(v, args[0]); e != "" {
				return false, e
			}
		}
		if config_num_value(cf) == v {
			return false, ""
		}
		config_num_store(cf, v)
		return true, ""
	case .Num:
		v, e := config_parse_num(cf, args[0])
		if e != "" {
			return false, e
		}
		if e2 := config_bounds(cf, v); e2 != "" {
			return false, e2
		}
		if cf.check != nil {
			if e3 := cf.check(v, args[0]); e3 != "" {
				return false, e3
			}
		}
		if config_num_value(cf) == v {
			return false, ""
		}
		config_num_store(cf, v)
		return true, ""
	case .Enum:
		v, ok := config_enum_value(cf, args)
		if !ok {
			clear(&config_err_buf)
			sb_str(&config_err_buf, "argument(s) must be one of the following: ")
			for e, i in cf.enums {
				if i > 0 {
					sb_str(&config_err_buf, ", ")
				}
				sb_str(&config_err_buf, e.name)
			}
			return false, string(config_err_buf[:])
		}
		if cf.check != nil {
			if e := cf.check(i64(v), nil); e != "" {
				return false, e
			}
		}
		if config_num_value(cf) == i64(v) {
			return false, ""
		}
		config_num_store(cf, i64(v))
		return true, ""
	case .Str:
		if cf.check != nil {
			if e := cf.check(0, args[0]); e != "" {
				return false, e
			}
		}
		if config_str_value(cf) == string(args[0]) {
			return false, ""
		}
		config_str_store(cf, args[0])
		return true, ""
	case .Special:
		return cf.special.set(args)
	}
	return false, ""
}

config_split_spaces :: proc(v: []u8, out: ^[dynamic][]u8) {
	clear(out)
	if len(v) == 0 {
		return
	}
	start := 0
	for i in 0 ..= len(v) {
		if i == len(v) || v[i] == ' ' {
			append(out, v[start:i])
			start = i + 1
		}
	}
}

config_set_value :: proc(cf: ^Config, value: []u8) -> (changed: bool, err: string) {
	if .Multi_Arg in cf.flags {
		parts: [dynamic][]u8
		defer delete(parts)
		config_split_spaces(value, &parts)
		return config_set(cf, parts[:])
	}
	one := [1][]u8{value}
	return config_set(cf, one[:])
}

conn_is_local :: proc(c: ^Conn) -> bool {
	a := c.addr[:c.addr_len]
	return len(a) >= 4 && a[0] == '1' && a[1] == '2' && a[2] == '7' && a[3] == '.'
}

protected_allowed :: proc(setting: u8, c: ^Conn) -> bool {
	return setting == 1 || (setting == 2 && c != nil && conn_is_local(c))
}

@(private = "file")
config_reply_set_error :: proc(c: ^Conn, name: string, err: string) {
	if err == "" {
		reply_error_parts(c, "ERR CONFIG SET failed (possibly related to argument '", name, "')")
	} else {
		reply_error_parts(c, "ERR CONFIG SET failed (possibly related to argument '", name, "') - ", err)
	}
}

@(private = "file")
config_cmd_set :: proc(c: ^Conn, argv: [][]u8) {
	if len(argv) & 1 != 0 {
		reply_error(c, ERR_SYNTAX)
		return
	}
	n := (len(argv) - 2) / 2
	set_cfgs := make([]^Config, n, context.temp_allocator)
	set_names := make([]string, n, context.temp_allocator)
	old_values := make([]string, n, context.temp_allocator)
	applies := make([dynamic]proc() -> string, 0, n, context.temp_allocator)
	apply_owner := make([dynamic]int, 0, n, context.temp_allocator)
	invalid_name: []u8
	err_name: string
	errstr: string
	invalid := false
	deny_loading := false
	for i in 0 ..< n {
		name := argv[2 + i * 2]
		cf, cname := config_lookup_named(name)
		if cf == nil {
			if !invalid {
				invalid_name = name
				invalid = true
			}
			continue
		}
		if .Sensitive in cf.flags {
			config_redact_hook(c, 2 + i * 2 + 1)
		}
		if invalid {
			continue
		}
		if .Immutable in cf.flags || (.Protected in cf.flags && !protected_allowed(u8(pst.protected), c)) {
			errstr = "can't set immutable config" if .Immutable in cf.flags else "can't set protected config"
			err_name = string(name)
			invalid = true
			continue
		}
		if pst.loading && .Deny_Loading in cf.flags {
			deny_loading = true
			invalid = true
			continue
		}
		for j in 0 ..< i {
			if set_cfgs[j] == cf && set_names[j] == cname {
				errstr = "duplicate parameter"
				err_name = string(name)
				invalid = true
				break
			}
		}
		set_cfgs[i] = cf
		set_names[i] = cname
	}
	if invalid {
		switch {
		case deny_loading:
			reply_error(c, ERR_LOADING)
		case invalid_name != nil:
			clear(&scratch)
			sb_str(&scratch, "ERR Unknown option or number of arguments for CONFIG SET - '")
			sb_bytes(&scratch, invalid_name)
			sb_byte(&scratch, '\'')
			sanitize_scratch()
			reply_error_bytes(c, scratch[:])
		case:
			config_reply_set_error(c, err_name, errstr)
		}
		return
	}
	for i in 0 ..< n {
		old_values[i] = clone_string_temp(config_value_string(set_cfgs[i]))
	}
	for i in 0 ..< n {
		cf := set_cfgs[i]
		changed, e := config_set_value(cf, argv[3 + i * 2])
		if e != "" {
			msg := clone_string_temp(e)
			config_restore(set_cfgs[:i + 1], old_values[:i + 1])
			config_reply_set_error(c, set_names[i], msg)
			return
		}
		if changed && cf.apply != nil {
			seen := false
			for a in applies {
				if a == cf.apply {
					seen = true
					break
				}
			}
			if !seen {
				append(&applies, cf.apply)
				append(&apply_owner, i)
			}
		}
	}
	for a, k in applies {
		if e := a(); e != "" {
			msg := clone_string_temp(e)
			plog(LOG_WARNING, "Failed applying new configuration. Possibly related to new ", set_names[apply_owner[k]], " setting. Restoring previous settings.")
			config_restore(set_cfgs, old_values)
			for b in applies {
				if e2 := b(); e2 != "" {
					plog(LOG_WARNING, "Failed applying restored failed CONFIG SET command: ", e2)
				}
			}
			config_reply_set_error(c, set_names[apply_owner[k]], msg)
			return
		}
	}
	reply_ok(c)
}

clone_string_temp :: proc(s: string) -> string {
	out := make([]u8, len(s), context.temp_allocator)
	copy(out, s)
	return string(out)
}

@(private = "file")
config_restore :: proc(cfgs: []^Config, values: []string) {
	for cf, i in cfgs {
		if _, e := config_set_value(cf, transmute([]u8)values[i]); e != "" {
			plog(LOG_WARNING, "Failed restoring failed CONFIG SET command. Error setting ", cf.name, " to '", values[i], "': ", e)
		}
	}
}

config_redact_hook: proc(c: ^Conn, index: int) = config_redact_noop

@(private = "file")
config_redact_noop :: proc(c: ^Conn, index: int) {
}

@(private = "file")
config_has_pattern :: proc(s: []u8) -> bool {
	for b in s {
		if b == '[' || b == '*' || b == '?' {
			return true
		}
	}
	return false
}

@(private = "file")
Config_Match :: struct {
	key: string,
	cf:  ^Config,
}

@(private = "file")
config_matched :: proc(matches: []Config_Match, name: string) -> bool {
	for m in matches {
		if eq_fold(transmute([]u8)m.key, transmute([]u8)name) {
			return true
		}
	}
	return false
}

@(private = "file")
config_cmd_get :: proc(c: ^Conn, argv: [][]u8) {
	matches := make([dynamic]Config_Match, 0, 16, context.temp_allocator)
	for i in 2 ..< len(argv) {
		name := argv[i]
		if !config_has_pattern(name) {
			if config_matched(matches[:], string(name)) {
				continue
			}
			if cf := config_lookup(name); cf != nil {
				append(&matches, Config_Match{string(name), cf})
			}
			continue
		}
		for &cf in configs {
			if .Hidden in cf.flags {
				continue
			}
			names := [2]string{cf.name, cf.alias}
			for nm in names {
				if nm == "" || config_matched(matches[:], nm) {
					continue
				}
				if glob_match(name, transmute([]u8)nm, true) {
					append(&matches, Config_Match{nm, &cf})
				}
			}
		}
	}
	reply_map(c, len(matches))
	for m in matches {
		reply_bulk_str(c, m.key)
		reply_bulk_str(c, config_value_string(m.cf))
	}
}

config_reset_stats :: proc() {
	srv.stat_commands = 0
	srv.stat_conns = 0
	srv.stat_rejected_conns = 0
	srv.stat_expired = 0
	stat_expired_subkeys = 0
	srv.stat_hits = 0
	srv.stat_misses = 0
	evict_reset_stats()
	lazyfree_reset_stats()
	pst.latest_fork_usec = 0
	pst.total_forks = 0
	pst.stat_rdb_saves = 0
	aof.stat_rewrites = 0
	aof.failures = 0
	aof.delayed_fsync = 0
	stat_obuf_disconnections = 0
	stat_qbuf_limit_disconnections = 0
	stats_reset_server()
}

@(private = "file")
config_help := [?]string {
	"CONFIG <subcommand> [<arg> [value] [opt] ...]. Subcommands are:",
	"GET <pattern>",
	"    Return parameters matching the glob-like <pattern> and their values.",
	"SET <directive> <value>",
	"    Set the configuration <directive> to <value>.",
	"RESETSTAT",
	"    Reset statistics reported by the INFO command.",
	"REWRITE",
	"    Rewrite the configuration file.",
	"HELP",
	"    Print this help.",
}

cmd_config :: proc(c: ^Conn, argv: [][]u8) {
	sub := argv[1]
	switch {
	case eq_nocase(sub, "get"):
		if len(argv) < 3 {
			reply_wrong_args(c, "config|get")
			return
		}
		config_cmd_get(c, argv)
	case eq_nocase(sub, "set"):
		if len(argv) < 4 {
			reply_wrong_args(c, "config|set")
			return
		}
		config_cmd_set(c, argv)
	case eq_nocase(sub, "resetstat"):
		if len(argv) != 2 {
			reply_wrong_args(c, "config|resetstat")
			return
		}
		config_reset_stats()
		reply_ok(c)
	case eq_nocase(sub, "rewrite"):
		if len(argv) != 2 {
			reply_wrong_args(c, "config|rewrite")
			return
		}
		if config_file == "" {
			reply_error(c, "ERR The server is running without a config file")
			return
		}
		if err := config_rewrite(config_file, false); err != .NONE {
			plog(LOG_WARNING, "CONFIG REWRITE failed: ", errno_text(err))
			reply_error_parts(c, "ERR Rewriting config file: ", errno_text(err))
			return
		}
		plog(LOG_NOTICE, "CONFIG REWRITE executed with success.")
		reply_ok(c)
	case eq_nocase(sub, "help"):
		if len(argv) != 2 {
			reply_wrong_args(c, "config|help")
			return
		}
		reply_array(c, len(config_help))
		for line in config_help {
			reply_simple(c, line)
		}
	case:
		reply_unknown_subcommand(c, sub, "CONFIG")
	}
}

config_init :: proc() {
	config_table_init()
	for &cf in configs {
		switch cf.type {
		case .Bool, .Num, .Enum:
			config_num_store(&cf, cf.def)
		case .Str:
			if p, ok := cf.store.(^string); ok {
				p^ = string(clone_bytes(transmute([]u8)cf.sdef))
			}
		case .Special:
		}
	}
	append(&config_bind, string(clone_bytes(transmute([]u8)string("*"))), string(clone_bytes(transmute([]u8)string("-::*"))))
	append(&config_percentiles, 50, 99, 99.9)
	config_hz_current = cfg.hz
}

sds_repr :: proc(b: ^[dynamic]u8, s: []u8) {
	hexd := "0123456789abcdef"
	sb_byte(b, '"')
	for ch in s {
		switch ch {
		case '\\', '"':
			sb_byte(b, '\\')
			sb_byte(b, ch)
		case '\n':
			sb_str(b, "\\n")
		case '\r':
			sb_str(b, "\\r")
		case '\t':
			sb_str(b, "\\t")
		case '\a':
			sb_str(b, "\\a")
		case '\b':
			sb_str(b, "\\b")
		case:
			if ch >= 0x20 && ch < 0x7f {
				sb_byte(b, ch)
			} else {
				sb_str(b, "\\x")
				sb_byte(b, hexd[ch >> 4])
				sb_byte(b, hexd[ch & 15])
			}
		}
	}
	sb_byte(b, '"')
}

@(private = "file")
is_hex_digit :: proc "contextless" (c: u8) -> bool {
	return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

@(private = "file")
hex_digit_value :: proc "contextless" (c: u8) -> u8 {
	switch c {
	case '0' ..= '9':
		return c - '0'
	case 'a' ..= 'f':
		return c - 'a' + 10
	case 'A' ..= 'F':
		return c - 'A' + 10
	}
	return 0
}

@(private = "file")
c_isspace :: proc "contextless" (c: u8) -> bool {
	return c == ' ' || (c >= '\t' && c <= '\r')
}

split_args :: proc(line: []u8, out: ^[dynamic][]u8, allocator := context.allocator) -> bool {
	clear(out)
	p := 0
	n := len(line)
	at :: proc "contextless" (line: []u8, i: int) -> u8 {
		return line[i] if i < len(line) else 0
	}
	for p < n && at(line, p) != 0 {
		for p < n && c_isspace(line[p]) {
			p += 1
		}
		if p >= n || line[p] == 0 {
			break
		}
		cur := make([dynamic]u8, allocator)
		inq, insq, done := false, false, false
		for !done {
			ch := at(line, p)
			if inq {
				if ch == '\\' && at(line, p + 1) == 'x' && is_hex_digit(at(line, p + 2)) && is_hex_digit(at(line, p + 3)) {
					append(&cur, hex_digit_value(at(line, p + 2)) * 16 + hex_digit_value(at(line, p + 3)))
					p += 3
				} else if ch == '\\' && at(line, p + 1) != 0 {
					p += 1
					e := at(line, p)
					switch e {
					case 'n':
						append(&cur, '\n')
					case 'r':
						append(&cur, '\r')
					case 't':
						append(&cur, '\t')
					case 'b':
						append(&cur, '\b')
					case 'a':
						append(&cur, '\a')
					case:
						append(&cur, e)
					}
				} else if ch == '"' {
					nx := at(line, p + 1)
					if nx != 0 && !c_isspace(nx) {
						return false
					}
					done = true
				} else if ch == 0 {
					return false
				} else {
					append(&cur, ch)
				}
			} else if insq {
				if ch == '\\' && at(line, p + 1) == '\'' {
					p += 1
					append(&cur, '\'')
				} else if ch == '\'' {
					nx := at(line, p + 1)
					if nx != 0 && !c_isspace(nx) {
						return false
					}
					done = true
				} else if ch == 0 {
					return false
				} else {
					append(&cur, ch)
				}
			} else {
				switch ch {
				case ' ', '\n', '\r', '\t', 0:
					done = true
				case '"':
					inq = true
				case '\'':
					insq = true
				case:
					append(&cur, ch)
				}
			}
			if p < n && at(line, p) != 0 {
				p += 1
			}
		}
		append(out, cur[:])
	}
	return true
}

@(private = "file")
config_rewrite_mark :: proc(rs: ^Rewrite_State, option: string) {
	rs.rewritten[option] = true
}

config_rewrite_line :: proc(rs: ^Rewrite_State, option: string, line: string, force: bool) -> bool {
	config_rewrite_mark(rs, option)
	l, has := &rs.option_lines[option]
	if !has && !force && !rs.force_write {
		return false
	}
	if has && len(l) > 0 {
		linenum := l[0]
		ordered_remove(l, 0)
		rs.lines[linenum] = line
		if len(l) == 0 {
			delete(l^)
			delete_key(&rs.option_lines, option)
		}
		return true
	}
	if rs.needs_signature {
		append(&rs.lines, CONFIG_REWRITE_SIGNATURE)
		rs.needs_signature = false
	}
	append(&rs.lines, line)
	return true
}

config_format_memory :: proc(b: ^[dynamic]u8, bytes: i64) {
	GB :: i64(1024 * 1024 * 1024)
	MB :: i64(1024 * 1024)
	KB :: i64(1024)
	switch {
	case bytes != 0 && bytes % GB == 0:
		sb_int(b, bytes / GB)
		sb_str(b, "gb")
	case bytes != 0 && bytes % MB == 0:
		sb_int(b, bytes / MB)
		sb_str(b, "mb")
	case bytes != 0 && bytes % KB == 0:
		sb_int(b, bytes / KB)
		sb_str(b, "kb")
	case:
		sb_int(b, bytes)
	}
}

rewrite_line_buf :: proc(rs: ^Rewrite_State) -> [dynamic]u8 {
	return make([dynamic]u8, context.temp_allocator)
}

@(private = "file")
config_rewrite_one :: proc(rs: ^Rewrite_State, cf: ^Config) {
	b := rewrite_line_buf(rs)
	sb_str(&b, cf.name)
	sb_byte(&b, ' ')
	switch cf.type {
	case .Bool:
		v := config_num_value(cf)
		sb_str(&b, "yes" if v != 0 else "no")
		config_rewrite_line(rs, cf.name, string(b[:]), v != cf.def)
	case .Num:
		v := config_num_value(cf)
		switch {
		case .Percent in cf.flags && v < 0:
			sb_int(&b, -v)
			sb_byte(&b, '%')
			config_rewrite_line(rs, cf.name, string(b[:]), -v != cf.def)
		case .Memory in cf.flags:
			config_format_memory(&b, v)
			config_rewrite_line(rs, cf.name, string(b[:]), v != cf.def)
		case .Octal in cf.flags:
			sb_octal(&b, cast(u64)v)
			config_rewrite_line(rs, cf.name, string(b[:]), v != cf.def)
		case:
			sb_int(&b, v)
			config_rewrite_line(rs, cf.name, string(b[:]), v != cf.def)
		}
	case .Enum:
		v := config_num_value(cf)
		config_enum_name(&b, cf, int(v))
		config_rewrite_line(rs, cf.name, string(b[:]), v != cf.def)
	case .Str:
		v := config_str_value(cf)
		if .Null_Empty in cf.flags && v == "" {
			config_rewrite_mark(rs, cf.name)
			return
		}
		force := .Null_Empty in cf.flags || v != cf.sdef
		sds_repr(&b, transmute([]u8)v)
		config_rewrite_line(rs, cf.name, string(b[:]), force)
	case .Special:
		cf.special.rewrite(rs, cf)
	}
}

@(private = "file")
config_rewrite_read_old :: proc(path: string, rs: ^Rewrite_State) -> linux.Errno {
	rs.needs_signature = true
	data, err := read_whole_file(path)
	if err == .ENOENT {
		return .NONE
	}
	if err != .NONE {
		return err
	}
	if len(data) == 0 {
		return .NONE
	}
	argv: [dynamic][]u8
	defer delete(argv)
	linenum := -1
	text := string(data)
	for {
		idx := -1
		for i in 0 ..< len(text) {
			if text[i] == '\n' {
				idx = i
				break
			}
		}
		raw: string
		if idx >= 0 {
			raw = text[:idx]
			text = text[idx + 1:]
		} else {
			raw = text
			text = ""
		}
		linenum += 1
		line := trim_set(raw, "\r\n\t ")
		if len(line) == 0 || line[0] == '#' {
			if rs.needs_signature && line == CONFIG_REWRITE_SIGNATURE {
				rs.needs_signature = false
			}
			append(&rs.lines, clone_string_temp(line))
			if idx < 0 {
				break
			}
			continue
		}
		ok := split_args(transmute([]u8)line, &argv, context.temp_allocator)
		known := false
		if ok && len(argv) > 0 {
			name := argv[0]
			known = config_lookup(name) != nil || eq_nocase(name, "include") || eq_nocase(name, "rename-command") || eq_nocase(name, "user") || eq_nocase(name, "loadmodule") || eq_nocase(name, "sentinel")
		}
		if !ok || !known {
			append(&rs.lines, clone_string_temp(concat_temp("# ??? ", line)))
			if idx < 0 {
				break
			}
			continue
		}
		append(&rs.lines, clone_string_temp(line))
		option := lower_temp(argv[0])
		if cf := config_lookup(argv[0]); cf != nil && cf.alias != "" && eq_nocase(argv[0], cf.alias) {
			option = cf.name
		}
		l, has := &rs.option_lines[option]
		if !has {
			rs.option_lines[option] = make([dynamic]int, context.temp_allocator)
			l = &rs.option_lines[option]
		}
		append(l, linenum)
		if idx < 0 {
			break
		}
	}
	return .NONE
}

concat_temp :: proc(a: string, b: string) -> string {
	out := make([]u8, len(a) + len(b), context.temp_allocator)
	copy(out, a)
	copy(out[len(a):], b)
	return string(out)
}

lower_temp :: proc(s: []u8) -> string {
	out := make([]u8, len(s), context.temp_allocator)
	for b, i in s {
		out[i] = lower(b)
	}
	return string(out)
}

trim_set :: proc(s: string, set: string) -> string {
	in_set :: proc(c: u8, set: string) -> bool {
		for x in transmute([]u8)set {
			if x == c {
				return true
			}
		}
		return false
	}
	a := 0
	b := len(s)
	for a < b && in_set(s[a], set) {
		a += 1
	}
	for b > a && in_set(s[b - 1], set) {
		b -= 1
	}
	return s[a:b]
}

read_whole_file :: proc(path: string, allocator := context.temp_allocator) -> ([]u8, linux.Errno) {
	buf: [4096]u8
	fd, err := linux.open(persist_cstr(path, buf[:]), {.CLOEXEC})
	if err != .NONE {
		return nil, err
	}
	defer linux.close(fd)
	out := make([dynamic]u8, allocator)
	chunk: [65536]u8
	for {
		n, rerr := linux.read(fd, chunk[:])
		if rerr == .EINTR {
			continue
		}
		if rerr != .NONE {
			return nil, rerr
		}
		if n <= 0 {
			break
		}
		append(&out, ..chunk[:n])
	}
	return out[:], .NONE
}

config_rewrite_user_hook: proc(rs: ^Rewrite_State) = config_rewrite_users

@(private = "file")
config_rewrite_users :: proc(rs: ^Rewrite_State) {
	if cfg.aclfile == "" {
		for u in acl_users {
			b := rewrite_line_buf(rs)
			sb_str(&b, "user ")
			sb_bytes(&b, u.name)
			sb_byte(&b, ' ')
			acl_describe_user(&b, u)
			config_rewrite_line(rs, "user", string(b[:]), true)
		}
	}
	config_rewrite_mark(rs, "user")
}

config_rewrite_content :: proc(rs: ^Rewrite_State) -> []u8 {
	out := make([dynamic]u8, context.temp_allocator)
	was_empty := false
	for line in rs.lines {
		if len(line) == 0 {
			if was_empty {
				continue
			}
			was_empty = true
		} else {
			was_empty = false
		}
		sb_str(&out, line)
		sb_byte(&out, '\n')
	}
	return out[:]
}

config_rewrite :: proc(path: string, force_all: bool) -> linux.Errno {
	rs: Rewrite_State
	rs.option_lines = make(map[string][dynamic]int, context.temp_allocator)
	rs.rewritten = make(map[string]bool, context.temp_allocator)
	rs.lines = make([dynamic]string, context.temp_allocator)
	if err := config_rewrite_read_old(path, &rs); err != .NONE {
		return err
	}
	rs.force_write = force_all
	for &cf in configs {
		config_rewrite_one(&rs, &cf)
	}
	config_rewrite_user_hook(&rs)
	config_rewrite_mark(&rs, "loadmodule")
	for option, l in rs.option_lines {
		if !rs.rewritten[option] {
			continue
		}
		for linenum in l {
			rs.lines[linenum] = ""
		}
	}
	return config_overwrite_file(path, config_rewrite_content(&rs))
}

@(private = "file")
config_overwrite_file :: proc(path: string, content: []u8) -> linux.Errno {
	tmp := concat_temp(path, ".tmp-eski")
	pbuf: [4096]u8
	tbuf: [4096]u8
	fd, err := linux.open(persist_cstr(tmp, tbuf[:]), {.WRONLY, .CREAT, .TRUNC, .CLOEXEC}, {.IRUSR, .IWUSR, .IRGRP, .IROTH})
	if err != .NONE {
		return err
	}
	off := 0
	for off < len(content) {
		n, werr := linux.write(fd, content[off:])
		if werr == .EINTR {
			continue
		}
		if werr != .NONE {
			linux.close(fd)
			linux.unlink(persist_cstr(tmp, tbuf[:]))
			return werr
		}
		off += n
	}
	linux.fsync(fd)
	linux.fchmod(fd, {.IRUSR, .IWUSR, .IRGRP, .IROTH})
	linux.close(fd)
	if rerr := linux.rename(persist_cstr(tmp, tbuf[:]), persist_cstr(path, pbuf[:])); rerr != .NONE {
		linux.unlink(persist_cstr(tmp, tbuf[:]))
		return rerr
	}
	return .NONE
}

config_fatal :: proc(linenum: int, line: string, err: string) -> ! {
	b: [dynamic]u8
	sb_str(&b, "\n*** FATAL CONFIG FILE ERROR (eski ")
	sb_str(&b, VERSION)
	sb_str(&b, ") ***\n")
	if linenum > 0 {
		sb_str(&b, "Reading the configuration file, at line ")
		sb_int(&b, i64(linenum))
		sb_str(&b, "\n>>> '")
		sb_str(&b, line)
		sb_str(&b, "'\n")
	}
	sb_str(&b, err)
	sb_byte(&b, '\n')
	write_fd(2, string(b[:]))
	linux.exit_group(1)
}

@(private = "file")
config_deprecated := [?]string{"list-max-ziplist-entries", "list-max-ziplist-value", "lua-replicate-commands"}

config_directive_hook: proc(argv: [][]u8) -> (handled: bool, err: string) = acl_config_directive

config_load_string :: proc(text: string) {
	config_reading_file = true
	argv: [dynamic][]u8
	sub: [dynamic][]u8
	rest := text
	linenum := 0
	for {
		idx := -1
		for i in 0 ..< len(rest) {
			if rest[i] == '\n' {
				idx = i
				break
			}
		}
		raw := rest[:idx] if idx >= 0 else rest
		linenum += 1
		line := trim_set(raw, " \t\r\n")
		if len(line) > 0 && line[0] != '#' {
			config_load_line(line, linenum, &argv, &sub)
		}
		if idx < 0 {
			break
		}
		rest = rest[idx + 1:]
	}
	delete(argv)
	delete(sub)
	config_reading_file = false
	if cfg.hz < CONFIG_MIN_HZ {
		cfg.hz = CONFIG_MIN_HZ
	}
	if cfg.hz > CONFIG_MAX_HZ {
		cfg.hz = CONFIG_MAX_HZ
	}
	config_hz_current = cfg.hz
}

@(private = "file")
config_load_line :: proc(line: string, linenum: int, argv: ^[dynamic][]u8, sub: ^[dynamic][]u8) {
	if !split_args(transmute([]u8)line, argv) {
		config_fatal(linenum, line, "Unbalanced quotes in configuration line")
	}
	if len(argv) == 0 {
		return
	}
	for &b in argv[0] {
		b = lower(b)
	}
	name := argv[0]
	if cf := config_lookup(name); cf != nil {
		if .Multi_Arg not_in cf.flags && len(argv) != 2 {
			config_fatal(linenum, line, "wrong number of arguments")
		}
		if .Multi_Arg in cf.flags && len(argv) == 2 && len(argv[1]) > 0 {
			if !split_args(argv[1], sub) {
				config_fatal(linenum, line, "wrong number of arguments")
			}
			if _, e := config_set(cf, sub[:]); e != "" {
				config_fatal(linenum, line, e)
			}
		} else {
			if _, e := config_set(cf, argv[1:]); e != "" {
				config_fatal(linenum, line, e)
			}
		}
		return
	}
	for d in config_deprecated {
		if eq_nocase(name, d) && len(argv) == 2 {
			return
		}
	}
	switch {
	case eq_nocase(name, "include") && len(argv) == 2:
		config_load_file(string(argv[1]), false, "")
		return
	case eq_nocase(name, "rename-command") && len(argv) == 3:
		if e := rename_command(argv[1], argv[2]); e != "" {
			config_fatal(linenum, line, e)
		}
		return
	}
	if handled, e := config_directive_hook(argv[:]); handled {
		if e != "" {
			config_fatal(linenum, line, e)
		}
		return
	}
	config_fatal(linenum, line, "Bad directive or wrong number of arguments")
}

@(private = "file")
config_has_wildcard :: proc(s: string) -> bool {
	for b in transmute([]u8)s {
		if b == '*' || b == '?' || b == '[' {
			return true
		}
	}
	return false
}

@(private = "file")
config_read_fatal :: proc(path: string, err: linux.Errno) -> ! {
	plog(LOG_WARNING, "Fatal error, can't open config file '", path, "': ", errno_text(err))
	linux.exit_group(1)
}

config_load_file :: proc(filename: string, from_stdin: bool, options: string) {
	text := make([dynamic]u8)
	defer delete(text)
	if filename != "" {
		if config_has_wildcard(filename) {
			paths := glob_paths(filename)
			for p in paths {
				data, err := read_whole_file(p)
				if err != .NONE {
					config_read_fatal(p, err)
				}
				append(&text, ..data)
			}
		} else {
			data, err := read_whole_file(filename)
			if err != .NONE {
				config_read_fatal(filename, err)
			}
			append(&text, ..data)
		}
	}
	if from_stdin {
		plog(LOG_NOTICE, "Reading config from stdin")
		chunk: [65536]u8
		for {
			n, rerr := linux.read(0, chunk[:])
			if rerr == .EINTR {
				continue
			}
			if rerr != .NONE || n <= 0 {
				break
			}
			append(&text, ..chunk[:n])
		}
	}
	if options != "" {
		append(&text, '\n')
		sb_str(&text, options)
	}
	config_load_string(string(text[:]))
}

foreign import libc_cfg "system:c"

@(private = "file")
Glob_T :: struct {
	pathc:    uint,
	pathv:    [^]cstring,
	offs:     uint,
	flags:    i32,
	closedir: rawptr,
	readdir:  rawptr,
	opendir:  rawptr,
	lstat:    rawptr,
	stat:     rawptr,
}

@(default_calling_convention = "c")
foreign libc_cfg {
	@(link_name = "glob")
	libc_glob :: proc(pattern: cstring, flags: i32, errfunc: rawptr, g: ^Glob_T) -> i32 ---
	@(link_name = "globfree")
	libc_globfree :: proc(g: ^Glob_T) ---
	@(link_name = "setlocale")
	libc_setlocale :: proc(category: i32, locale: cstring) -> cstring ---
}

glob_paths :: proc(pattern: string) -> []string {
	buf: [4096]u8
	g: Glob_T
	out := make([dynamic]string, context.temp_allocator)
	if libc_glob(persist_cstr(pattern, buf[:]), 0, nil, &g) == 0 {
		for i in 0 ..< int(g.pathc) {
			append(&out, clone_string_temp(string(g.pathv[i])))
		}
		libc_globfree(&g)
	}
	return out[:]
}

config_parse_command_line :: proc(args: []string) -> (filename: string, from_stdin: bool, options: string) {
	b := make([dynamic]u8)
	tmp: [dynamic][]u8
	defer delete(tmp)
	j := 1
	if len(args) >= 2 && len(args[1]) > 0 && args[1][0] != '-' {
		filename = args[1]
		j = 2
	}
	handled_last := true
	for ; j < len(args); j += 1 {
		a := args[j]
		if a == "-" && (j == 1 || j == len(args) - 1) {
			from_stdin = true
			continue
		}
		if handled_last && len(a) >= 2 && a[0] == '-' && a[1] == '-' {
			if len(b) > 0 {
				sb_byte(&b, '\n')
			}
			sb_str(&b, a[2:])
			sb_byte(&b, ' ')
			split_args(transmute([]u8)a, &tmp, context.temp_allocator)
			if len(tmp) == 1 {
				handled_last = false
				is_save := eq_nocase(transmute([]u8)a, "--save")
				if j != len(args) - 1 && len(args[j + 1]) >= 2 && args[j + 1][0] == '-' && args[j + 1][1] == '-' && is_save {
					sb_str(&b, "\"\"")
					handled_last = true
				} else if j == len(args) - 1 && is_save {
					sb_str(&b, "\"\"")
				}
			} else {
				handled_last = true
			}
			continue
		}
		sds_repr(&b, transmute([]u8)a)
		sb_byte(&b, ' ')
		handled_last = true
	}
	return filename, from_stdin, string(b[:])
}

absolute_path :: proc(path: string) -> string {
	if len(path) > 0 && path[0] == '/' {
		return path
	}
	buf: [4096]u8
	cwd := persist_cwd(buf[:])
	out := make([dynamic]u8)
	sb_str(&out, cwd)
	if len(cwd) == 0 || cwd[len(cwd) - 1] != '/' {
		sb_byte(&out, '/')
	}
	sb_str(&out, path)
	return string(out[:])
}

@(private = "file")
config_rewrite_string_line :: proc(rs: ^Rewrite_State, name: string, value: string, force: bool) {
	b := rewrite_line_buf(rs)
	sb_str(&b, name)
	sb_byte(&b, ' ')
	sds_repr(&b, transmute([]u8)value)
	config_rewrite_line(rs, name, string(b[:]), force)
}

config_dir_set :: proc(args: [][]u8) -> (bool, string) {
	if len(args) != 1 {
		return false, "wrong number of arguments"
	}
	buf: [4096]u8
	if err := linux.chdir(persist_cstr(string(args[0]), buf[:])); err != .NONE {
		return false, errno_text(err)
	}
	return true, ""
}

config_dir_get :: proc(b: ^[dynamic]u8) {
	buf: [4096]u8
	n, err := linux.getcwd(buf[:])
	if err == .NONE && n > 0 {
		end := n
		for end > 0 && buf[end - 1] == 0 {
			end -= 1
		}
		sb_bytes(b, buf[:end])
	}
}

config_dir_rewrite :: proc(rs: ^Rewrite_State, cf: ^Config) {
	buf: [4096]u8
	n, err := linux.getcwd(buf[:])
	if err != .NONE || n <= 0 {
		config_rewrite_mark(rs, cf.name)
		return
	}
	end := n
	for end > 0 && buf[end - 1] == 0 {
		end -= 1
	}
	config_rewrite_string_line(rs, cf.name, string(buf[:end]), true)
}

config_save_set :: proc(args: [][]u8) -> (bool, string) {
	a := args
	if len(a) == 1 && len(a[0]) == 0 {
		clear(&pst.save_params)
		a = a[:0]
	}
	if len(a) & 1 != 0 {
		return false, "Invalid save parameters"
	}
	for s, j in a {
		v, ok := c_strtol_full(s)
		if !ok || (j & 1 == 0 && v < 1) || (j & 1 == 1 && v < 0) {
			return false, "Invalid save parameters"
		}
	}
	if !config_reading_file {
		clear(&pst.save_params)
	} else if !config_save_loaded {
		config_save_loaded = true
		clear(&pst.save_params)
	}
	for j := 0; j < len(a); j += 2 {
		secs, _ := c_strtol_full(a[j])
		changes, _ := c_strtol_full(a[j + 1])
		append(&pst.save_params, Save_Param{secs, i64(i32(changes))})
	}
	return true, ""
}

c_strtol_full :: proc "contextless" (s: []u8) -> (i64, bool) {
	i := 0
	for i < len(s) && (s[i] == ' ' || (s[i] >= '\t' && s[i] <= '\r')) {
		i += 1
	}
	neg := false
	if i < len(s) && (s[i] == '+' || s[i] == '-') {
		neg = s[i] == '-'
		i += 1
	}
	start := i
	v: i64 = 0
	for i < len(s) && s[i] >= '0' && s[i] <= '9' {
		d := i64(s[i] - '0')
		if v < (max(i64) - d) / 10 {
			v = v * 10 + d
		} else {
			v = max(i64)
		}
		i += 1
	}
	if i == start {
		return 0, len(s) == 0
	}
	if i != len(s) {
		return 0, false
	}
	return -v if neg else v, true
}

config_save_get :: proc(b: ^[dynamic]u8) {
	for sp, j in pst.save_params {
		if j > 0 {
			sb_byte(b, ' ')
		}
		sb_int(b, sp.seconds)
		sb_byte(b, ' ')
		sb_int(b, sp.changes)
	}
}

config_save_rewrite :: proc(rs: ^Rewrite_State, cf: ^Config) {
	if len(pst.save_params) == 0 {
		config_rewrite_line(rs, cf.name, "save \"\"", true)
	} else {
		for sp in pst.save_params {
			b := rewrite_line_buf(rs)
			sb_str(&b, "save ")
			sb_int(&b, sp.seconds)
			sb_byte(&b, ' ')
			sb_int(&b, sp.changes)
			config_rewrite_line(rs, cf.name, string(b[:]), true)
		}
	}
	config_rewrite_mark(rs, cf.name)
}

@(private = "file")
OBUF_DEFAULTS := [Obuf_Class]Obuf_Limit {
	.Normal  = {0, 0, 0},
	.Replica = {256 * 1024 * 1024, 64 * 1024 * 1024, 60},
	.Pubsub  = {32 * 1024 * 1024, 8 * 1024 * 1024, 60},
}

config_obuf_set :: proc(args: [][]u8) -> (bool, string) {
	if len(args) % 4 != 0 {
		return false, "Wrong number of arguments in buffer limit configuration."
	}
	values: [Obuf_Class]Obuf_Limit
	classes: bit_set[Obuf_Class]
	for j := 0; j < len(args); j += 4 {
		cls: Obuf_Class
		switch {
		case eq_nocase(args[j], "normal"):
			cls = .Normal
		case eq_nocase(args[j], "slave"), eq_nocase(args[j], "replica"):
			cls = .Replica
		case eq_nocase(args[j], "pubsub"):
			cls = .Pubsub
		case:
			return false, "Invalid client class specified in buffer limit configuration."
		}
		hard, hok := config_memtoull(args[j + 1])
		soft, sok := config_memtoull(args[j + 2])
		secs, tok := c_strtol_full(args[j + 3])
		if !hok || !sok || !tok || i64(i32(secs)) < 0 {
			return false, "Error in hard, soft or soft_seconds setting in buffer limit configuration."
		}
		values[cls] = Obuf_Limit{hard, soft, i64(i32(secs))}
		classes += {cls}
	}
	for cls in Obuf_Class {
		if cls in classes {
			obuf_limits[cls] = values[cls]
		}
	}
	obuf_normal_limited = obuf_limits[.Normal].hard != 0 || obuf_limits[.Normal].soft != 0
	return true, ""
}

config_obuf_get :: proc(b: ^[dynamic]u8) {
	names := [Obuf_Class]string {
		.Normal  = "normal",
		.Replica = "slave",
		.Pubsub  = "pubsub",
	}
	for cls in Obuf_Class {
		lim := obuf_limits[cls]
		if cls != .Normal {
			sb_byte(b, ' ')
		}
		sb_str(b, names[cls])
		sb_byte(b, ' ')
		sb_u64(b, lim.hard)
		sb_byte(b, ' ')
		sb_u64(b, lim.soft)
		sb_byte(b, ' ')
		sb_int(b, lim.seconds)
	}
}

config_obuf_rewrite :: proc(rs: ^Rewrite_State, cf: ^Config) {
	names := [Obuf_Class]string {
		.Normal  = "normal",
		.Replica = "replica",
		.Pubsub  = "pubsub",
	}
	for cls in Obuf_Class {
		lim := obuf_limits[cls]
		d := OBUF_DEFAULTS[cls]
		b := rewrite_line_buf(rs)
		sb_str(&b, cf.name)
		sb_byte(&b, ' ')
		sb_str(&b, names[cls])
		sb_byte(&b, ' ')
		config_format_memory(&b, cast(i64)lim.hard)
		sb_byte(&b, ' ')
		config_format_memory(&b, cast(i64)lim.soft)
		sb_byte(&b, ' ')
		sb_int(&b, lim.seconds)
		config_rewrite_line(rs, cf.name, string(b[:]), lim != d)
	}
}

config_oom_values_set :: proc(args: [][]u8) -> (bool, string) {
	if len(args) != 3 {
		return false, "wrong number of arguments"
	}
	values: [3]i64
	for a, i in args {
		v, ok := c_strtol_full(a)
		if !ok || v < -2000 || v > 2000 {
			return false, "Invalid oom-score-adj-values, elements must be between -2000 and 2000."
		}
		values[i] = v
	}
	if values[1] < values[0] || values[2] < values[1] {
		plog(LOG_WARNING, "The oom-score-adj-values configuration may not work for non-privileged processes! Please consult the documentation.")
	}
	if values == config_oom_values {
		return false, ""
	}
	config_oom_values = values
	return true, ""
}

config_oom_values_get :: proc(b: ^[dynamic]u8) {
	for v, i in config_oom_values {
		if i > 0 {
			sb_byte(b, ' ')
		}
		sb_int(b, v)
	}
}

config_oom_values_rewrite :: proc(rs: ^Rewrite_State, cf: ^Config) {
	b := rewrite_line_buf(rs)
	sb_str(&b, cf.name)
	sb_byte(&b, ' ')
	config_oom_values_get(&b)
	config_rewrite_line(rs, cf.name, string(b[:]), config_oom_values != OOM_SCORE_DEFAULTS)
}

config_notify_set :: proc(args: [][]u8) -> (bool, string) {
	if len(args) != 1 {
		return false, "wrong number of arguments"
	}
	flags, ok := notify_parse(args[0])
	if !ok {
		return false, ERR_NOTIFY_CLASS
	}
	notify_apply(flags)
	return true, ""
}

config_notify_get :: proc(b: ^[dynamic]u8) {
	tmp: [32]u8
	n := notify_format(notify_config, tmp[:])
	sb_bytes(b, tmp[:n])
}

config_notify_rewrite :: proc(rs: ^Rewrite_State, cf: ^Config) {
	tmp: [32]u8
	n := notify_format(notify_config, tmp[:])
	b := rewrite_line_buf(rs)
	sb_str(&b, cf.name)
	sb_byte(&b, ' ')
	sds_repr(&b, tmp[:n])
	config_rewrite_line(rs, cf.name, string(b[:]), notify_config != {})
}

config_bind_set :: proc(args: [][]u8) -> (bool, string) {
	if len(args) > CONFIG_BIND_MAX {
		return false, "Too many bind addresses specified."
	}
	a := args
	if len(a) == 1 && len(a[0]) == 0 {
		a = a[:0]
	}
	for s in config_bind {
		delete(s)
	}
	clear(&config_bind)
	for s in a {
		append(&config_bind, string(clone_bytes(s)))
	}
	return true, ""
}

config_bind_get :: proc(b: ^[dynamic]u8) {
	for s, i in config_bind {
		if i > 0 {
			sb_byte(b, ' ')
		}
		sb_str(b, s)
	}
}

config_bind_rewrite :: proc(rs: ^Rewrite_State, cf: ^Config) {
	if len(config_bind) == 2 && config_bind[0] == "*" && config_bind[1] == "-::*" {
		config_rewrite_mark(rs, cf.name)
		return
	}
	b := rewrite_line_buf(rs)
	sb_str(&b, cf.name)
	sb_byte(&b, ' ')
	if len(config_bind) == 0 {
		sb_str(&b, "\"\"")
	} else {
		config_bind_get(&b)
	}
	config_rewrite_line(rs, cf.name, string(b[:]), true)
}

config_replicaof_set :: proc(args: [][]u8) -> (bool, string) {
	if len(args) != 2 {
		return false, "wrong number of arguments"
	}
	if len(config_replica_host) > 0 {
		delete(config_replica_host)
	}
	config_replica_host = ""
	if eq_nocase(args[0], "no") && eq_nocase(args[1], "one") {
		return true, ""
	}
	port, ok := c_strtol_full(args[1])
	if !ok || len(args[1]) == 0 || port < 0 || port > 65535 {
		return false, "Invalid master port"
	}
	config_replica_port = port
	config_replica_host = string(clone_bytes(args[0]))
	return true, ""
}

config_replicaof_get :: proc(b: ^[dynamic]u8) {
	if config_replica_host != "" {
		sb_str(b, config_replica_host)
		sb_byte(b, ' ')
		sb_int(b, config_replica_port)
	}
}

config_replicaof_rewrite :: proc(rs: ^Rewrite_State, cf: ^Config) {
	if config_replica_host == "" {
		config_rewrite_mark(rs, cf.name)
		return
	}
	b := rewrite_line_buf(rs)
	sb_str(&b, cf.name)
	sb_byte(&b, ' ')
	config_replicaof_get(&b)
	config_rewrite_line(rs, cf.name, string(b[:]), true)
}

@(private = "file")
config_format_percentile :: proc(b: ^[dynamic]u8, v: f64) {
	tmp: [64]u8
	s := strconv.write_float(tmp[:], v, 'f', 6, 64)
	if len(s) > 0 && (s[0] == '+') {
		s = s[1:]
	}
	end := len(s)
	dot := -1
	for i in 0 ..< end {
		if s[i] == '.' {
			dot = i
			break
		}
	}
	if dot >= 0 {
		for end > dot + 1 && s[end - 1] == '0' {
			end -= 1
		}
		if end == dot + 1 {
			end = dot
		}
	}
	sb_str(b, s[:end])
}

config_percentiles_set :: proc(args: [][]u8) -> (bool, string) {
	clear(&config_percentiles)
	if len(args) == 1 && len(args[0]) == 0 {
		return true, ""
	}
	for a in args {
		v, ok := parse_double_strict(a)
		if !ok {
			clear(&config_percentiles)
			return false, "Invalid latency-tracking-info-percentiles parameters"
		}
		if v > 100.0 || v < 0.0 {
			clear(&config_percentiles)
			return false, "latency-tracking-info-percentiles parameters should sit between [0.0,100.0]"
		}
		append(&config_percentiles, v)
	}
	return true, ""
}

parse_double_strict :: proc(s: []u8) -> (f64, bool) {
	if len(s) == 0 || len(s) > 5000 || c_isspace(s[0]) || c_isspace(s[len(s) - 1]) {
		return 0, false
	}
	v, ok := strconv.parse_f64(string(s))
	if !ok || v != v {
		return 0, false
	}
	return v, true
}

config_percentiles_get :: proc(b: ^[dynamic]u8) {
	for v, i in config_percentiles {
		if i > 0 {
			sb_byte(b, ' ')
		}
		config_format_percentile(b, v)
	}
}

config_percentiles_rewrite :: proc(rs: ^Rewrite_State, cf: ^Config) {
	b := rewrite_line_buf(rs)
	sb_str(&b, cf.name)
	if len(config_percentiles) == 0 {
		sb_str(&b, " \"\"")
	} else {
		for v in config_percentiles {
			sb_byte(&b, ' ')
			config_format_percentile(&b, v)
		}
	}
	config_rewrite_line(rs, cf.name, string(b[:]), true)
}

config_appendonly_value :: proc() -> bool {
	return aof.state != .Off if aof.started else aof.wanted
}

config_appendonly_set :: proc(args: [][]u8) -> (bool, string) {
	v: bool
	switch {
	case eq_nocase(args[0], "yes"):
		v = true
	case eq_nocase(args[0], "no"):
		v = false
	case:
		return false, "argument must be 'yes' or 'no'"
	}
	if v == config_appendonly_value() {
		return false, ""
	}
	aof.wanted = v
	return true, ""
}

config_appendonly_get :: proc(b: ^[dynamic]u8) {
	sb_str(b, "yes" if config_appendonly_value() else "no")
}

config_appendonly_rewrite :: proc(rs: ^Rewrite_State, cf: ^Config) {
	v := config_appendonly_value()
	config_rewrite_line(rs, cf.name, "appendonly yes" if v else "appendonly no", v)
}

config_apply_appendonly :: proc() -> string {
	if !aof.started {
		return ""
	}
	if aof.wanted && aof.state == .Off {
		if !aof_start() {
			return "Unable to turn on AOF. Check server logs."
		}
	} else if !aof.wanted && aof.state != .Off {
		aof_stop()
	}
	return ""
}

config_mc_port_set :: proc(args: [][]u8) -> (bool, string) {
	n, ok := parse_i64(args[0])
	if !ok {
		return false, "argument couldn't be parsed into an integer"
	}
	if n < 0 || n > 65535 {
		return false, "argument must be between 0 and 65535 inclusive"
	}
	changed := int(n) != mc_port
	mc_port = int(n)
	return changed, ""
}

config_mc_port_get :: proc(b: ^[dynamic]u8) {
	sb_int(b, i64(mc_port))
}

config_mc_port_rewrite :: proc(rs: ^Rewrite_State, cf: ^Config) {
	b := rewrite_line_buf(rs)
	sb_str(&b, cf.name)
	sb_byte(&b, ' ')
	sb_int(&b, i64(mc_port))
	config_rewrite_line(rs, cf.name, string(b[:]), mc_port != 0)
}

config_mc_item_size_set :: proc(args: [][]u8) -> (bool, string) {
	n, ok := mc_parse_size(args[0])
	if !ok {
		return false, "invalid memcached max item size, expected 1k to 512m"
	}
	changed := n != mc_item_size_max
	mc_item_size_max = n
	return changed, ""
}

config_mc_item_size_get :: proc(b: ^[dynamic]u8) {
	sb_int(b, i64(mc_item_size_max))
}

config_mc_item_size_rewrite :: proc(rs: ^Rewrite_State, cf: ^Config) {
	b := rewrite_line_buf(rs)
	sb_str(&b, cf.name)
	sb_byte(&b, ' ')
	sb_int(&b, i64(mc_item_size_max))
	config_rewrite_line(rs, cf.name, string(b[:]), mc_item_size_max != MC_ITEM_SIZE_DEFAULT)
}

config_databases_set :: proc(args: [][]u8) -> (bool, string) {
	n, ok := parse_i64(args[0])
	if !ok {
		return false, "argument couldn't be parsed into an integer"
	}
	if n < 1 || n > INT_MAX_CFG {
		return false, "argument must be between 1 and 2147483647 inclusive"
	}
	if n > DB_MAX {
		return false, "eski supports at most 1024 databases"
	}
	changed := int(n) != db_count
	db_count = int(n)
	return changed, ""
}

config_databases_get :: proc(b: ^[dynamic]u8) {
	sb_int(b, i64(db_count))
}

config_databases_rewrite :: proc(rs: ^Rewrite_State, cf: ^Config) {
	b := rewrite_line_buf(rs)
	sb_str(&b, cf.name)
	sb_byte(&b, ' ')
	sb_int(&b, i64(db_count))
	config_rewrite_line(rs, cf.name, string(b[:]), db_count != DB_COUNT)
}

config_check_announce_ip :: proc(v: i64, s: []u8) -> string {
	if len(s) == 0 {
		return ""
	}
	if ipv4_strict(s) {
		return ""
	}
	if ipv6_valid(s) {
		return ""
	}
	return "Cluster announce IP must be a valid IPv4 or IPv6 address"
}

ipv4_strict :: proc(s: []u8) -> bool {
	if len(s) == 0 || s[0] == '*' {
		return false
	}
	_, ok := parse_ipv4(string(s))
	return ok && !eq_nocase(s, "localhost")
}

ipv6_valid :: proc(s: []u8) -> bool {
	groups := 0
	double := false
	i := 0
	n := len(s)
	if n < 2 {
		return false
	}
	if s[0] == ':' {
		if s[1] != ':' {
			return false
		}
	}
	for i < n {
		if s[i] == ':' {
			if i + 1 < n && s[i + 1] == ':' {
				if double {
					return false
				}
				double = true
				i += 2
				if i >= n {
					break
				}
				continue
			}
			if i == 0 {
				return false
			}
			i += 1
			if i >= n {
				return false
			}
			continue
		}
		start := i
		dots := false
		for i < n && s[i] != ':' {
			if s[i] == '.' {
				dots = true
			}
			i += 1
		}
		part := s[start:i]
		if dots {
			if i != n {
				return false
			}
			if !ipv4_strict(part) {
				return false
			}
			groups += 2
			break
		}
		if len(part) == 0 || len(part) > 4 {
			return false
		}
		for ch in part {
			if !is_hex_digit(ch) {
				return false
			}
		}
		groups += 1
	}
	if double {
		return groups < 8
	}
	return groups == 8
}

config_check_cluster_config_file :: proc(v: i64, s: []u8) -> string {
	if len(s) == 0 {
		return "cluster-config-file can't be empty"
	}
	return ""
}

config_check_hostname :: proc(v: i64, s: []u8) -> string {
	if len(s) >= 256 {
		return "Hostnames must be less than 256 characters"
	}
	for ch in s {
		if !((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '-' || ch == '.') {
			return "Hostnames may only contain alphanumeric characters, hyphens or dots"
		}
	}
	return ""
}

config_check_nodename :: proc(v: i64, s: []u8) -> string {
	for ch in s {
		if !((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '-' || ch == '.' || ch == '_' || ch == ':') {
			return "Announced human node name contained invalid character"
		}
	}
	return ""
}

@(private = "file")
path_is_base_name :: proc(s: []u8) -> bool {
	for b in s {
		if b == '/' {
			return false
		}
	}
	return !(len(s) == 1 && s[0] == '.') && !(len(s) == 2 && s[0] == '.' && s[1] == '.')
}

config_check_dbfilename :: proc(v: i64, s: []u8) -> string {
	if !path_is_base_name(s) {
		return "dbfilename can't be a path, just a filename"
	}
	return ""
}

config_check_appendfilename :: proc(v: i64, s: []u8) -> string {
	if len(s) == 0 {
		return "appendfilename can't be empty"
	}
	if !path_is_base_name(s) {
		return "appendfilename can't be a path, just a filename"
	}
	return ""
}

config_check_appenddirname :: proc(v: i64, s: []u8) -> string {
	if len(s) == 0 {
		return "appenddirname can't be empty"
	}
	if !path_is_base_name(s) {
		return "appenddirname can't be a path, just a dirname"
	}
	return ""
}

config_check_shutdown_flags :: proc(v: i64, s: []u8) -> string {
	if v & SHUTDOWN_NOSAVE != 0 && v & SHUTDOWN_SAVE != 0 {
		return "shutdown options SAVE and NOSAVE can't be used simultaneously"
	}
	return ""
}

proc_title_expand :: proc(b: ^[dynamic]u8, template: []u8, title: string) -> bool {
	p := 0
	for p < len(template) {
		sv := -1
		for i in p ..< len(template) {
			if template[i] == '{' {
				sv = i
				break
			}
		}
		if sv < 0 {
			sb_bytes(b, template[p:])
			break
		}
		sb_bytes(b, template[p:sv])
		sv += 1
		if sv >= len(template) {
			return false
		}
		if template[sv] == '{' {
			p = sv + 1
			sb_byte(b, '{')
			continue
		}
		ev := -1
		for i in sv ..< len(template) {
			if template[i] == '}' {
				ev = i
				break
			}
		}
		if ev < 0 {
			return false
		}
		name := string(template[sv:ev])
		switch name {
		case "title":
			sb_str(b, title)
		case "listen-addr":
			sb_str(b, config_bind[0] if len(config_bind) > 0 else "*")
			sb_byte(b, ':')
			sb_int(b, i64(srv.port))
		case "server-mode":
		case "config-file":
			sb_str(b, config_file if config_file != "" else "-")
		case "port":
			sb_int(b, i64(srv.port))
		case "tls-port":
			sb_int(b, cfg.tls_port)
		case "unixsocket":
			sb_str(b, cfg.unixsocket)
		case:
			return false
		}
		p = ev + 1
	}
	return true
}

config_check_proc_title :: proc(v: i64, s: []u8) -> string {
	b := make([dynamic]u8, context.temp_allocator)
	if !proc_title_expand(&b, s, "") || len(trim_set(string(b[:]), " ")) == 0 {
		return "template format is invalid or contains unknown variables"
	}
	return ""
}

config_apply_persist_gate :: proc() -> string {
	persist_update_gate()
	return ""
}

config_apply_policy :: proc() -> string {
	evict_policy_changed()
	hooks_update()
	return ""
}

config_apply_maxmemory :: proc() -> string {
	evict_policy_changed()
	hooks_update()
	if maxmemory_bytes != 0 {
		db_drop_prepared()
		used := max(mem_used() - mem_not_counted(), 0)
		if maxmemory_bytes < u64(used) {
			l: Log_Line
			ll_begin(&l, LOG_WARNING)
			ll_str(&l, "WARNING: the new maxmemory value set via CONFIG SET (")
			ll_int(&l, i64(maxmemory_bytes))
			ll_str(&l, ") is smaller than the current memory usage (")
			ll_int(&l, i64(used))
			ll_str(&l, "). This will result in key eviction and/or the inability to accept new write commands depending on the maxmemory-policy.")
			ll_end(&l)
		}
		evict_timer = true
	}
	return ""
}

config_apply_maxmemory_clients :: proc() -> string {
	client_buckets_apply()
	hooks_update()
	return ""
}

maxmemory_startup_warning :: proc() {
	if maxmemory_bytes > 0 && maxmemory_bytes < 1024 * 1024 {
		l: Log_Line
		ll_begin(&l, LOG_WARNING)
		ll_str(&l, "WARNING: You specified a maxmemory value that is less than 1MB (current value is ")
		ll_int(&l, i64(maxmemory_bytes))
		ll_str(&l, " bytes). Are you sure this is what you really want?")
		ll_end(&l)
	}
}

config_apply_hz :: proc() -> string {
	if cfg.hz < CONFIG_MIN_HZ {
		cfg.hz = CONFIG_MIN_HZ
	}
	if cfg.hz > CONFIG_MAX_HZ {
		cfg.hz = CONFIG_MAX_HZ
	}
	config_hz_current = cfg.hz
	return ""
}

config_update_dynamic_hz :: proc() {
	hz := cfg.hz
	if cfg.dynamic_hz {
		for i64(srv.nconns) / hz > 200 {
			hz *= 2
			if hz > CONFIG_MAX_HZ {
				hz = CONFIG_MAX_HZ
				break
			}
		}
	}
	config_hz_current = hz
}

cron_interval_ms :: #force_inline proc() -> i64 {
	return max(1000 / config_hz_current, 1)
}

config_apply_port :: proc() -> string {
	if !server_relisten() {
		return "Unable to listen on this port. Check server logs."
	}
	return ""
}

config_apply_bind :: proc() -> string {
	if !server_relisten() {
		return "Failed to bind to specified addresses."
	}
	return ""
}

config_apply_tls_port :: proc() -> string {
	if cfg.tls_port != 0 {
		return "Unable to update TLS configuration. Check server logs."
	}
	return ""
}

config_apply_tls :: proc() -> string {
	if cfg.tls_port != 0 || cfg.tls_replication || cfg.tls_cluster {
		return "Unable to update TLS configuration. Check server logs."
	}
	return ""
}

config_apply_backlog :: proc() -> string {
	if cfg.repl_backlog_size < 16 * 1024 {
		cfg.repl_backlog_size = 16 * 1024
	}
	return ""
}

config_apply_maxclients :: proc() -> string {
	want := cfg.maxclients
	adjust_open_files_limit()
	if cfg.maxclients != want {
		clear(&config_err_buf)
		sb_str(&config_err_buf, "The operating system is not able to handle the specified number of clients, try with ")
		sb_int(&config_err_buf, cfg.maxclients)
		return string(config_err_buf[:])
	}
	return ""
}

adjust_open_files_limit :: proc() {
	maxfiles := u64(cfg.maxclients) + CONFIG_MIN_RESERVED_FDS
	lim: linux.RLimit
	if linux.getrlimit(.NOFILE, &lim) != .NONE {
		cfg.maxclients = 1024 - CONFIG_MIN_RESERVED_FDS
		return
	}
	old := u64(lim.cur)
	if old >= maxfiles {
		return
	}
	best := maxfiles
	for best > old {
		nl := linux.RLimit {
			cur = uint(best),
			max = uint(best),
		}
		if linux.setrlimit(.NOFILE, &nl) == .NONE {
			break
		}
		decr: u64 = 16
		if best < decr {
			best = old
			break
		}
		best -= decr
	}
	if best < old {
		best = old
	}
	if best < maxfiles {
		if best <= CONFIG_MIN_RESERVED_FDS {
			cfg.maxclients = 1
		} else {
			cfg.maxclients = i64(best) - CONFIG_MIN_RESERVED_FDS
		}
	}
}

config_apply_locale :: proc() -> string {
	buf: [4096]u8
	LC_COLLATE :: 3
	if libc_setlocale(LC_COLLATE, persist_cstr(cfg.locale_collate, buf[:])) == nil {
		return "Invalid locale name"
	}
	return ""
}

config_apply_oom_score :: proc() -> string {
	if !oom_score_apply() {
		return "Failed to set current oom_score_adj. Check server logs."
	}
	return ""
}

@(private = "file")
oom_score_read :: proc() -> (i64, bool) {
	data, err := read_whole_file("/proc/self/oom_score_adj")
	if err != .NONE {
		return 0, false
	}
	v, ok := c_strtol_full(transmute([]u8)trim_set(string(data), " \n"))
	return v, ok
}

oom_score_apply :: proc() -> bool {
	if !config_oom_base_read {
		if v, ok := oom_score_read(); ok {
			config_oom_base = v
		}
		config_oom_base_read = true
	}
	val := config_oom_base
	switch cfg.oom_score_adj {
	case 1:
		val = config_oom_base + config_oom_values[0]
	case 2:
		val = config_oom_values[0]
	}
	val = clamp(val, -1000, 1000)
	cur, ok := oom_score_read()
	if ok && cur == val {
		return true
	}
	buf: [64]u8
	fd, err := linux.open(persist_cstr("/proc/self/oom_score_adj", buf[:]), {.WRONLY, .CLOEXEC})
	if err != .NONE {
		plog(LOG_WARNING, "Unable to write oom_score_adj: ", errno_text(err))
		return false
	}
	defer linux.close(fd)
	tmp: [24]u8
	n := format_i64(&tmp[0], val)
	if _, werr := linux.write(fd, tmp[:n]); werr != .NONE {
		plog(LOG_WARNING, "Unable to write oom_score_adj: ", errno_text(werr))
		return false
	}
	return true
}

debug_allowed :: proc(c: ^Conn) -> bool {
	return protected_allowed(cfg.enable_debug_command, c)
}

ERR_DEBUG_NOT_ALLOWED :: "ERR DEBUG command not allowed. If the enable-debug-command option is set to \"local\", you can run it from a local connection, otherwise you need to set this option in the configuration file, and then restart the server."


clients_timeout_cron :: proc() {
	now := srv.now_ms / 1000
	for i := 0; i < len(srv.conns); i += 1 {
		c := srv.conns[i]
		if c == nil || c.kind != .Redis || c.blocked != .None || c.compute != nil || c.held || .Subscribed in c.ps {
			continue
		}
		if now - c.atime_ms / 1000 > cfg.timeout {
			plog(LOG_VERBOSE, "Closing idle client")
			conn_close(c)
		}
	}
}

config_startup :: proc() {
	if cfg.logfile != "" {
		buf: [4096]u8
		fd, err := linux.open(persist_cstr(cfg.logfile, buf[:]), {.WRONLY, .CREAT, .APPEND, .CLOEXEC}, {.IRUSR, .IWUSR, .IRGRP, .IROTH})
		if err != .NONE {
			config_fatal(0, "", concat_temp("Can't open the log file: ", errno_text(err)))
		}
		log_fd = fd
	}
	if cfg.daemonize {
		daemonize()
		if cfg.pidfile == "" {
			cfg.pidfile = "/var/run/redis.pid"
		}
	}
	if cfg.pidfile != "" {
		create_pid_file()
	}
	if cfg.oom_score_adj != 0 {
		oom_score_apply()
	}
	if len(cfg.locale_collate) > 0 {
		if e := config_apply_locale(); e != "" {
			config_fatal(0, "", e)
		}
	}
	obuf_normal_limited = obuf_limits[.Normal].hard != 0 || obuf_limits[.Normal].soft != 0
	evict_policy_changed()
	client_buckets_apply()
	hooks_update()
	adjust_open_files_limit()
}

@(private = "file")
daemonize :: proc() {
	pid, err := linux.fork()
	if err != .NONE {
		return
	}
	if pid != 0 {
		linux.exit_group(0)
	}
	linux.setsid()
	buf: [16]u8
	if fd, oerr := linux.open(persist_cstr("/dev/null", buf[:]), {.RDWR}); oerr == .NONE {
		linux.dup2(fd, 0)
		linux.dup2(fd, 1)
		linux.dup2(fd, 2)
		if fd > 2 {
			linux.close(fd)
		}
	}
}

@(private = "file")
create_pid_file :: proc() {
	buf: [4096]u8
	fd, err := linux.open(persist_cstr(cfg.pidfile, buf[:]), {.WRONLY, .CREAT, .TRUNC, .CLOEXEC}, {.IRUSR, .IWUSR, .IRGRP, .IROTH})
	if err != .NONE {
		plog(LOG_WARNING, "Failed to write PID file: ", errno_text(err))
		return
	}
	tmp: [24]u8
	n := format_i64(&tmp[0], i64(linux.getpid()))
	tmp[n] = '\n'
	linux.write(fd, tmp[:n + 1])
	linux.close(fd)
}

remove_pid_file :: proc() {
	if cfg.pidfile != "" {
		buf: [4096]u8
		linux.unlink(persist_cstr(cfg.pidfile, buf[:]))
	}
}
