package ldfloat

import "core:testing"

Outcome :: enum {
	Text,
	Not_Float,
	Nan_Or_Infinity,
}

Reply :: struct {
	incr:    string,
	text:    string,
	outcome: Outcome,
}

increment_from :: proc(old: F80, incr: string, buf: []u8) -> (text: string, outcome: Outcome) {
	step, ok := parse(transmute([]u8)incr)
	if !ok {
		return "", .Not_Float
	}
	if !is_finite(step) {
		return "", .Nan_Or_Infinity
	}
	total := add(old, step)
	if !is_finite(total) {
		return "", .Nan_Or_Infinity
	}
	n := format_human(total, buf)
	return string(buf[:n]), .Text
}

increment_text :: proc(stored, incr: string, buf: []u8) -> (text: string, outcome: Outcome) {
	old, ok := parse(transmute([]u8)stored)
	if !ok {
		return "", .Not_Float
	}
	return increment_from(old, incr, buf)
}

check_reply :: proc(t: ^testing.T, c: Reply, loc := #caller_location) {
	buf: [MAX_LONG_DOUBLE_CHARS]u8
	text, outcome := increment_from(zero(false), c.incr, buf[:])
	testing.expectf(
		t,
		outcome == c.outcome && text == c.text,
		"increment of a missing value by %q gave %q (%v) but the reference server replied %q (%v)",
		c.incr,
		text,
		outcome,
		c.text,
		c.outcome,
		loc = loc,
	)
}

