@(test)
infinite_spellings_cannot_be_added_as_observed_on_redis :: proc(t: ^testing.T) {
	cases := [?]Reply{
		{"inf", "", .Nan_Or_Infinity},
		{"INF", "", .Nan_Or_Infinity},
		{"Inf", "", .Nan_Or_Infinity},
		{"+inf", "", .Nan_Or_Infinity},
		{"-inf", "", .Nan_Or_Infinity},
		{"infinity", "", .Nan_Or_Infinity},
		{"INFINITY", "", .Nan_Or_Infinity},
		{"Infinity", "", .Nan_Or_Infinity},
		{"-Infinity", "", .Nan_Or_Infinity},
		{"+infinity", "", .Nan_Or_Infinity},
	}
	for c in cases {
		check_reply(t, c)
	}
}

@(test)
results_with_thousands_of_digits_observed_on_redis :: proc(t: ^testing.T) {
	cases := [?]Reply{
		{"1e308", reply_1e308, .Text},
		{"1e400", reply_1e400, .Text},
		{"1e1000", reply_1e1000, .Text},
		{"1e4000", reply_1e4000, .Text},
		{"1e4900", reply_1e4900, .Text},
		{"1e4932", reply_1e4932, .Text},
		{"3.5e4931", reply_3_5e4931, .Text},
		{"1e4931", reply_1e4931, .Text},
		{"-1e4932", reply_neg_1e4932, .Text},
		{"1.18973149535723176502e4932", reply_1_18973149535723176502e4932, .Text},
		{"1.18973149535723176503e4932", reply_1_18973149535723176502e4932, .Text},
		{"1.1897314953572317650212638530309702e4932", reply_1_18973149535723176502e4932, .Text},
		{"1.18973149535723176502126385303097021e4932", reply_1_18973149535723176502e4932, .Text},
		{"0x1p1000", reply_0x1p1000, .Text},
		{"0x1p10000", reply_0x1p10000, .Text},
		{"0x1p16382", reply_0x1p16382, .Text},
		{"0x1p16383", reply_0x1p16383, .Text},
		{"0x1.fffffffffffffffep16383", reply_1_18973149535723176502e4932, .Text},
		{"0xffffffffffffffffp16320", reply_1_18973149535723176502e4932, .Text},
		{"0x1.fffffffffffffffe8p16383", reply_1_18973149535723176502e4932, .Text},
		{"0x1.fffffffffffffffe9p16383", reply_1_18973149535723176502e4932, .Text},
		{"0xfffffffffffffffe.8p16320", reply_0xfffffffffffffffe_8p16320, .Text},
		{"0xffffffffffffffff.7p16320", reply_1_18973149535723176502e4932, .Text},
	}
	for c in cases {
		check_reply(t, c)
	}
}
