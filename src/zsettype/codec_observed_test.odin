package zsettype

import "core:testing"
import rdb "../rdb"

Expected_Member :: struct {
	member: string,
	bits: u64,
}

Codec_Case :: struct {
	payload: string,
	type: int,
	deep, lenient: bool,
	entries, member_limit: int,
	status: int,
	pos: int,
	consumed: i64,
	reason: string,
	nil_result: bool,
	size: int,
	encoding: string,
	items: []Expected_Member,
	reject_promotion: bool,
}

@(test)
codec_observations_and_integrity_rejections :: proc(t: ^testing.T) {
	saved_entries, saved_value := zset_max_listpack_entries, zset_max_listpack_value
	defer {
		zset_max_listpack_entries = saved_entries
		zset_max_listpack_value = saved_value
	}
