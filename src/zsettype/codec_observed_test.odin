			testing.expect(t, length(z) == c.size && encoding_name(z) == c.encoding)
			it := iter_make(z, false)
			item: Item
			for expected in c.items {
				testing.expect(t, iter_next(&it, &item))
				buf: [21]u8
				testing.expect(t, string(item_bytes(&item, &buf)) == expected.member && transmute(u64)item.score == expected.bits)
			}
			testing.expect(t, !iter_next(&it, &item))
			destroy(z)
		}
		rdb.reader_destroy(&r)
	}
	testing.expect(t, len(cases) == 948 && rejections == 20)
	drain_maintenance(t)
}
