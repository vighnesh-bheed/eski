package zsettype

import "core:testing"

Setop_Edge_Case :: struct {
	op: Setop,
	agg: Aggregate,
	n: int,
	cards: [3]int,
	scores, weights: [3]f64,
	bits: u64,
	order: [3]int,
	check_order: bool,
}

@(test)
setop_nan_and_order_observations :: proc(t: ^testing.T) {
