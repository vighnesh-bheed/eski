	}
	for c in cases {
		objects: [3]Zset
		sources: [3]Source
		for i in 0 ..< c.n {
			objects[i] = create_skiplist(c.cards[i])
			_, _, _ = add(objects[i], c.scores[i], []u8{'x'}, {})
			for extra in 1 ..< c.cards[i] {
				member := [2]u8{u8('a' + i), u8(extra)}
				_, _, _ = add(objects[i], 0, member[:], {})
			}
			sources[i] = source_make(objects[i], c.weights[i])
		}
		dst, card, _, _ := setop_compute(sources[:c.n], c.op, c.agg, false, 0)
		value, found := score(dst, []u8{'x'})
		testing.expect(t, card == 0 && dst.encoding == .Skiplist && found && transmute(u64)value == c.bits)
		if c.check_order {
			for i in 0 ..< c.n {
				testing.expect(t, sources[i].id == rawptr(objects[c.order[i]]))
			}
		}
		destroy(dst)
		for i in 0 ..< c.n {
			destroy(objects[i])
		}
	}
	testing.expect(t, len(cases) == 360)
	drain_maintenance(t)
}
