package main

import ht "hashtype"
import lt "listtype"
import st "settype"
import strt "streamtype"
import zt "zsettype"

INT_MAX_CFG :: i64(max(i32))
INT_MIN_CFG :: i64(min(i32))
LLONG_MAX_CFG :: u64(max(i64))
UINT_MAX_CFG :: u64(max(u32))
ULLONG_MAX_CFG :: max(u64)

SHUTDOWN_SAVE :: 1
SHUTDOWN_NOSAVE :: 2
SHUTDOWN_NOW :: 4
SHUTDOWN_FORCE :: 8

Config_Values :: struct {
	daemonize:                         bool,
	always_show_logo:                  bool,
	protected_mode:                    bool,
	activerehashing:                   bool,
	set_proc_title:                    bool,
	dynamic_hz:                        bool,
	lazyfree_lazy_eviction:            bool,
	lazyfree_lazy_expire:              bool,
	lazyfree_lazy_server_del:          bool,
	lazyfree_lazy_user_del:            bool,
	lazyfree_lazy_user_flush:          bool,
	repl_disable_tcp_nodelay:          bool,
	repl_diskless_sync:                bool,
	cluster_require_full_coverage:     bool,
	rdb_save_incremental_fsync:        bool,
	cluster_replica_no_failover:       bool,
	replica_lazy_flush:                bool,
	replica_serve_stale_data:          bool,
	replica_read_only:                 bool,
	replica_ignore_maxmemory:          bool,
	jemalloc_bg_thread:                bool,
	activedefrag:                      bool,
	syslog_enabled:                    bool,
	cluster_enabled:                   bool,
	cluster_allow_reads_when_down:     bool,
	cluster_allow_pubsubshard_down:    bool,
	crash_log_enabled:                 bool,
	crash_memcheck_enabled:            bool,
	use_exit_on_panic:                 bool,
	disable_thp:                       bool,
	cluster_allow_replica_migration:   bool,
	replica_announced:                 bool,
	latency_tracking:                  bool,
	replica_ignore_disk_write_errors:  bool,
	hide_user_data_from_log:           bool,
	io_threads_do_reads:               bool,
	tls_cluster:                       bool,
	tls_replication:                   bool,
	tls_prefer_server_ciphers:         bool,
	tls_session_caching:               bool,
	aclfile:                           string,
	unixsocket:                        string,
	pidfile:                           string,
	replica_announce_ip:               string,
	masteruser:                        string,
	masterauth:                        string,
	requirepass:                       string,
	cluster_announce_ip:               string,
	cluster_config_file:               string,
	cluster_announce_hostname:         string,
	cluster_announce_human_nodename:   string,
	syslog_ident:                      string,
	dbfilename:                        string,
	server_cpulist:                    string,
	bio_cpulist:                       string,
	aof_rewrite_cpulist:               string,
	bgsave_cpulist:                    string,
	ignore_warnings:                   string,
	proc_title_template:               string,
	bind_source_addr:                  string,
	logfile:                           string,
	locale_collate:                    string,
	tls_cert_file:                     string,
	tls_key_file:                      string,
	tls_key_file_pass:                 string,
	tls_client_cert_file:              string,
	tls_client_key_file:               string,
	tls_client_key_file_pass:          string,
	tls_dh_params_file:                string,
	tls_ca_cert_file:                  string,
	tls_ca_cert_dir:                   string,
	tls_protocols:                     string,
	tls_ciphers:                       string,
	tls_ciphersuites:                  string,
	supervised:                        u8,
	syslog_facility:                   u8,
	repl_diskless_load:                u8,
	loglevel:                          u8,
	oom_score_adj:                     u8,
	acl_pubsub_default:                u8,
	enable_debug_command:              u8,
	enable_module_command:             u8,
	cluster_preferred_endpoint_type:   u8,
	propagation_error_behavior:        u8,
	shutdown_on_sigint:                u8,
	shutdown_on_sigterm:               u8,
	tls_auth_clients:                  u8,
	io_threads:                        i64,
	cluster_replica_validity_factor:   i64,
	tcp_keepalive:                     i64,
	cluster_migration_barrier:         i64,
	active_defrag_cycle_min:           i64,
	active_defrag_cycle_max:           i64,
	active_defrag_threshold_lower:     i64,
	active_defrag_threshold_upper:     i64,
	replica_priority:                  i64,
	repl_diskless_sync_delay:          i64,
	maxmemory_eviction_tenacity:       i64,
	timeout:                           i64,
	replica_announce_port:             i64,
	tcp_backlog:                       i64,
	cluster_port:                      i64,
	cluster_announce_bus_port:         i64,
	cluster_announce_port:             i64,
	cluster_announce_tls_port:         i64,
	repl_timeout:                      i64,
	repl_ping_replica_period:          i64,
	key_load_delay:                    i64,
	active_expire_effort:              i64,
	hz:                                i64,
	min_replicas_to_write:             i64,
	min_replicas_max_lag:              i64,
	watchdog_period:                   i64,
	shutdown_timeout:                  i64,
	repl_diskless_sync_max_replicas:   i64,
	tls_port:                          i64,
	tls_session_cache_size:            i64,
	tls_session_cache_timeout:         i64,
	maxclients:                        i64,
	unixsocketperm:                    i64,
	socket_mark_id:                    i64,
	max_new_connections_per_cycle:     i64,
	max_new_tls_connections_per_cycle: i64,
	active_defrag_max_scan_fields:     i64,
	slowlog_max_len:                   i64,
	acllog_max_len:                    i64,
	busy_reply_threshold:              i64,
	cluster_node_timeout:              i64,
	cluster_ping_interval:             i64,
	slowlog_log_slower_than:           i64,
	latency_monitor_threshold:         i64,
	proto_max_bulk_len:                i64,
	repl_backlog_size:                 i64,
	cluster_link_sendbuf_limit:        u64,
	active_defrag_ignore_bytes:        i64,
	client_query_buffer_limit:         i64,
	maxmemory_clients:                 i64,
	repl_backlog_ttl:                  i64,
	loading_events_interval_bytes:     i64,
}

cfg: Config_Values

enum_supervised := []Config_Enum{{"upstart", 1}, {"systemd", 2}, {"auto", 3}, {"no", 0}}
enum_syslog_facility := []Config_Enum {
	{"user", 8},
	{"local0", 128},
	{"local1", 136},
	{"local2", 144},
	{"local3", 152},
	{"local4", 160},
	{"local5", 168},
	{"local6", 176},
	{"local7", 184},
}
enum_repl_diskless_load := []Config_Enum{{"disabled", 0}, {"on-empty-db", 1}, {"swapdb", 2}}
enum_loglevel := []Config_Enum{{"debug", 0}, {"verbose", 1}, {"notice", 2}, {"warning", 3}, {"nothing", 4}}
enum_maxmemory_policy := []Config_Enum {
	{"volatile-lru", int(Evict_Policy.Volatile_Lru)},
	{"volatile-lfu", int(Evict_Policy.Volatile_Lfu)},
	{"volatile-random", int(Evict_Policy.Volatile_Random)},
	{"volatile-ttl", int(Evict_Policy.Volatile_Ttl)},
	{"allkeys-lru", int(Evict_Policy.Allkeys_Lru)},
	{"allkeys-lfu", int(Evict_Policy.Allkeys_Lfu)},
	{"allkeys-random", int(Evict_Policy.Allkeys_Random)},
	{"noeviction", int(Evict_Policy.Noeviction)},
}
enum_appendfsync := []Config_Enum{{"everysec", int(Aof_Fsync.Everysec)}, {"always", int(Aof_Fsync.Always)}, {"no", int(Aof_Fsync.No)}}
enum_oom_score_adj := []Config_Enum{{"no", 0}, {"yes", 1}, {"relative", 1}, {"absolute", 2}}
enum_acl_pubsub_default := []Config_Enum{{"allchannels", 1}, {"resetchannels", 0}}
enum_protected := []Config_Enum{{"no", 0}, {"yes", 1}, {"local", 2}}
enum_endpoint_type := []Config_Enum{{"ip", 0}, {"hostname", 1}, {"unknown-endpoint", 2}}
enum_propagation_error := []Config_Enum{{"ignore", 0}, {"panic", 1}, {"panic-on-replicas", 2}}
enum_shutdown_on_sig := []Config_Enum {
	{"default", 0},
	{"save", SHUTDOWN_SAVE},
	{"nosave", SHUTDOWN_NOSAVE},
	{"now", SHUTDOWN_NOW},
	{"force", SHUTDOWN_FORCE},
}
enum_tls_auth_clients := []Config_Enum{{"no", 0}, {"yes", 1}, {"optional", 2}}
enum_sanitize := []Config_Enum{{"no", int(Persist_Sanitize.No)}, {"yes", int(Persist_Sanitize.Yes)}, {"clients", int(Persist_Sanitize.Clients)}}

special_dir := Config_Special{config_dir_set, config_dir_get, config_dir_rewrite}
special_save := Config_Special{config_save_set, config_save_get, config_save_rewrite}
special_obuf := Config_Special{config_obuf_set, config_obuf_get, config_obuf_rewrite}
special_oom_values := Config_Special{config_oom_values_set, config_oom_values_get, config_oom_values_rewrite}
special_notify := Config_Special{config_notify_set, config_notify_get, config_notify_rewrite}
special_bind := Config_Special{config_bind_set, config_bind_get, config_bind_rewrite}
special_replicaof := Config_Special{config_replicaof_set, config_replicaof_get, config_replicaof_rewrite}
special_percentiles := Config_Special{config_percentiles_set, config_percentiles_get, config_percentiles_rewrite}
special_appendonly := Config_Special{config_appendonly_set, config_appendonly_get, config_appendonly_rewrite}
special_mc_port := Config_Special{config_mc_port_set, config_mc_port_get, config_mc_port_rewrite}
special_mc_item_size := Config_Special{config_mc_item_size_set, config_mc_item_size_get, config_mc_item_size_rewrite}
special_databases := Config_Special{config_databases_set, config_databases_get, config_databases_rewrite}

CONFIG_TABLE_LEN :: 210

configs: [CONFIG_TABLE_LEN]Config

config_table_init :: proc() {
	t := [?]Config {
		{name = "lua-max-memory", type = .Num, flags = {.Hidden, .Memory}, def = i64(LLONG_MAX_CFG), lo = 4096, hi = LLONG_MAX_CFG, store = &lua_max_memory},
		{name = "lua-max-output", type = .Num, flags = {.Hidden, .Memory}, def = 512 * 1024 * 1024, lo = 4096, hi = LLONG_MAX_CFG, store = &lua_max_output},
		{name = "lua-max-bridge-memory", type = .Num, flags = {.Hidden, .Memory}, def = i64(LLONG_MAX_CFG), lo = 4096, hi = LLONG_MAX_CFG, store = &lua_max_bridge_memory},
		{name = "lua-max-cache-memory", type = .Num, flags = {.Hidden, .Memory}, def = i64(LLONG_MAX_CFG), lo = 4096, hi = LLONG_MAX_CFG, store = &lua_max_cache_memory, check = lua_cache_limit_check},
		{name = "keyspace-threads", type = .Num, flags = {.Immutable, .Hidden}, def = 0, lo = 0, hi = 64, store = &keyspace_threads},
		{name = "keyspace-max-memory", type = .Num, flags = {.Immutable, .Hidden, .Memory}, def = 128 * 1024 * 1024, lo = 0, hi = LLONG_MAX_CFG, store = &keyspace_max_memory},
		{name = "compute-threads", type = .Num, flags = {.Immutable, .Hidden}, def = 0, lo = 0, hi = 64, store = &compute_threads},
		{name = "compute-max-memory", type = .Num, flags = {.Immutable, .Hidden, .Memory}, def = 128 * 1024 * 1024, lo = 0, hi = LLONG_MAX_CFG, store = &compute_max_memory},
		{name = "rdbchecksum", type = .Bool, flags = {.Immutable}, def = 1, store = &pst.checksum},
		{name = "daemonize", type = .Bool, flags = {.Immutable}, def = 0, store = &cfg.daemonize},
		{name = "always-show-logo", type = .Bool, flags = {.Immutable}, def = 0, store = &cfg.always_show_logo},
		{name = "lua-enable-deprecated-api", type = .Bool, flags = {.Hidden, .Immutable}, def = 0, store = &lua_enable_deprecated_api},
		{name = "protected-mode", type = .Bool, def = 1, store = &cfg.protected_mode},
		{name = "rdbcompression", type = .Bool, def = 1, store = &pst.compression},
		{name = "rdb-del-sync-files", type = .Bool, def = 0, store = &pst.del_sync_files},
		{name = "activerehashing", type = .Bool, def = 1, store = &cfg.activerehashing},
		{name = "stop-writes-on-bgsave-error", type = .Bool, def = 1, store = &pst.stop_writes, apply = config_apply_persist_gate},
		{name = "set-proc-title", type = .Bool, flags = {.Immutable}, def = 1, store = &cfg.set_proc_title},
		{name = "dynamic-hz", type = .Bool, def = 1, store = &cfg.dynamic_hz},
		{name = "lazyfree-lazy-eviction", type = .Bool, def = 0, store = &cfg.lazyfree_lazy_eviction},
		{name = "lazyfree-lazy-expire", type = .Bool, def = 0, store = &cfg.lazyfree_lazy_expire},
		{name = "lazyfree-lazy-server-del", type = .Bool, def = 0, store = &cfg.lazyfree_lazy_server_del},
		{name = "lazyfree-lazy-user-del", type = .Bool, def = 0, store = &cfg.lazyfree_lazy_user_del},
		{name = "lazyfree-lazy-user-flush", type = .Bool, def = 0, store = &cfg.lazyfree_lazy_user_flush},
		{name = "vset-force-single-threaded-execution", type = .Bool, flags = {.Hidden}, def = 0, store = &vset_force_single_threaded},
		{name = "repl-disable-tcp-nodelay", type = .Bool, def = 0, store = &cfg.repl_disable_tcp_nodelay},
		{name = "repl-diskless-sync", type = .Bool, def = 1, store = &cfg.repl_diskless_sync},
		{name = "aof-rewrite-incremental-fsync", type = .Bool, def = 1, store = &aof.incremental_fsync},
		{name = "no-appendfsync-on-rewrite", type = .Bool, def = 0, store = &aof.no_fsync_on_rewrite},
		{name = "cluster-require-full-coverage", type = .Bool, def = 1, store = &cfg.cluster_require_full_coverage},
		{name = "rdb-save-incremental-fsync", type = .Bool, def = 1, store = &cfg.rdb_save_incremental_fsync},
		{name = "aof-load-truncated", type = .Bool, def = 1, store = &aof.load_truncated},
		{name = "aof-use-rdb-preamble", type = .Bool, def = 1, store = &aof.preamble},
		{name = "aof-timestamp-enabled", type = .Bool, def = 0, store = &aof.timestamps},
		{name = "cluster-replica-no-failover", alias = "cluster-slave-no-failover", type = .Bool, def = 0, store = &cfg.cluster_replica_no_failover},
		{name = "replica-lazy-flush", alias = "slave-lazy-flush", type = .Bool, def = 0, store = &cfg.replica_lazy_flush},
		{name = "replica-serve-stale-data", alias = "slave-serve-stale-data", type = .Bool, def = 1, store = &cfg.replica_serve_stale_data},
		{name = "replica-read-only", alias = "slave-read-only", type = .Bool, def = 1, store = &cfg.replica_read_only},
		{name = "replica-ignore-maxmemory", alias = "slave-ignore-maxmemory", type = .Bool, def = 1, store = &cfg.replica_ignore_maxmemory},
		{name = "jemalloc-bg-thread", type = .Bool, def = 1, store = &cfg.jemalloc_bg_thread},
		{name = "activedefrag", type = .Bool, def = 0, store = &cfg.activedefrag, check = config_check_active_defrag},
		{name = "syslog-enabled", type = .Bool, flags = {.Immutable}, def = 0, store = &cfg.syslog_enabled},
		{name = "cluster-enabled", type = .Bool, flags = {.Immutable}, def = 0, store = &cfg.cluster_enabled},
		{name = "appendonly", type = .Special, flags = {.Deny_Loading}, def = 0, special = &special_appendonly, apply = config_apply_appendonly},
		{name = "cluster-allow-reads-when-down", type = .Bool, def = 0, store = &cfg.cluster_allow_reads_when_down},
		{name = "cluster-allow-pubsubshard-when-down", type = .Bool, def = 1, store = &cfg.cluster_allow_pubsubshard_down},
		{name = "crash-log-enabled", type = .Bool, def = 1, store = &cfg.crash_log_enabled, apply = config_apply_diagnostics},
		{name = "crash-memcheck-enabled", type = .Bool, def = 1, store = &cfg.crash_memcheck_enabled, apply = config_apply_diagnostics},
		{name = "use-exit-on-panic", type = .Bool, flags = {.Hidden}, def = 0, store = &cfg.use_exit_on_panic, apply = config_apply_diagnostics},
		{name = "disable-thp", type = .Bool, flags = {.Immutable}, def = 1, store = &cfg.disable_thp},
		{name = "cluster-allow-replica-migration", type = .Bool, def = 1, store = &cfg.cluster_allow_replica_migration},
		{name = "replica-announced", type = .Bool, def = 1, store = &cfg.replica_announced},
		{name = "latency-tracking", type = .Bool, def = 1, store = &cfg.latency_tracking, apply = config_apply_stat_limits},
		{name = "aof-disable-auto-gc", type = .Bool, flags = {.Hidden}, def = 0, store = &aof.disable_auto_gc, apply = aof_apply_gc},
		{name = "replica-ignore-disk-write-errors", type = .Bool, def = 0, store = &cfg.replica_ignore_disk_write_errors},
		{name = "hide-user-data-from-log", type = .Bool, def = 0, store = &cfg.hide_user_data_from_log, apply = config_apply_diagnostics},
		{name = "io-threads-do-reads", type = .Bool, flags = {.Immutable}, def = 0, store = &cfg.io_threads_do_reads},
		{name = "aclfile", type = .Str, flags = {.Immutable}, store = &cfg.aclfile},
		{name = "unixsocket", type = .Str, flags = {.Immutable, .Null_Empty}, store = &cfg.unixsocket},
		{name = "pidfile", type = .Str, flags = {.Immutable, .Null_Empty}, store = &cfg.pidfile},
		{name = "replica-announce-ip", alias = "slave-announce-ip", type = .Str, flags = {.Null_Empty}, store = &cfg.replica_announce_ip},
		{name = "masteruser", type = .Str, flags = {.Sensitive, .Null_Empty}, store = &cfg.masteruser},
		{name = "cluster-announce-ip", type = .Str, flags = {.Null_Empty}, store = &cfg.cluster_announce_ip, check = config_check_announce_ip},
		{name = "cluster-config-file", type = .Str, flags = {.Immutable}, sdef = "nodes.conf", store = &cfg.cluster_config_file},
		{name = "cluster-announce-hostname", type = .Str, flags = {.Null_Empty}, store = &cfg.cluster_announce_hostname, check = config_check_hostname},
		{name = "cluster-announce-human-nodename", type = .Str, flags = {.Null_Empty}, store = &cfg.cluster_announce_human_nodename, check = config_check_nodename},
		{name = "syslog-ident", type = .Str, flags = {.Immutable}, sdef = "eski", store = &cfg.syslog_ident},
		{name = "dbfilename", type = .Str, flags = {.Protected}, sdef = "dump.rdb", store = &cfg.dbfilename, check = config_check_dbfilename},
		{name = "appendfilename", type = .Str, flags = {.Immutable}, sdef = "appendonly.aof", store = &aof.filename, check = config_check_appendfilename},
		{name = "appenddirname", type = .Str, flags = {.Immutable}, sdef = "appendonlydir", store = &aof.dirname, check = config_check_appenddirname},
		{name = "server-cpulist", alias = "server_cpulist", type = .Str, flags = {.Immutable, .Null_Empty}, store = &cfg.server_cpulist},
		{name = "bio-cpulist", alias = "bio_cpulist", type = .Str, flags = {.Immutable, .Null_Empty}, store = &cfg.bio_cpulist},
		{name = "aof-rewrite-cpulist", alias = "aof_rewrite_cpulist", type = .Str, flags = {.Immutable, .Null_Empty}, store = &cfg.aof_rewrite_cpulist},
		{name = "bgsave-cpulist", alias = "bgsave_cpulist", type = .Str, flags = {.Immutable, .Null_Empty}, store = &cfg.bgsave_cpulist},
		{name = "ignore-warnings", type = .Str, store = &cfg.ignore_warnings},
		{name = "proc-title-template", type = .Str, sdef = "{title} {listen-addr} {server-mode}", store = &cfg.proc_title_template, check = config_check_proc_title, apply = config_apply_proc_title},
		{name = "bind-source-addr", type = .Str, flags = {.Null_Empty}, store = &cfg.bind_source_addr},
		{name = "logfile", type = .Str, flags = {.Immutable}, store = &cfg.logfile},
		{name = "locale-collate", type = .Str, store = &cfg.locale_collate, apply = config_apply_locale},
		{name = "masterauth", type = .Str, flags = {.Sensitive, .Null_Empty}, store = &cfg.masterauth},
		{name = "requirepass", type = .Str, flags = {.Sensitive, .Null_Empty}, store = &cfg.requirepass, apply = config_apply_requirepass},
		{name = "supervised", type = .Enum, flags = {.Immutable}, def = 0, enums = enum_supervised, store = &cfg.supervised},
		{name = "syslog-facility", type = .Enum, flags = {.Immutable}, def = 128, enums = enum_syslog_facility, store = &cfg.syslog_facility},
		{name = "repl-diskless-load", type = .Enum, flags = {.Deny_Loading}, def = 0, enums = enum_repl_diskless_load, store = &cfg.repl_diskless_load},
		{name = "loglevel", type = .Enum, def = 2, enums = enum_loglevel, store = &cfg.loglevel},
		{name = "maxmemory-policy", type = .Enum, def = i64(Evict_Policy.Noeviction), enums = enum_maxmemory_policy, store = (^u8)(&maxmemory_policy), apply = config_apply_policy},
		{name = "appendfsync", type = .Enum, def = i64(Aof_Fsync.Everysec), enums = enum_appendfsync, store = (^u8)(&aof.fsync)},
		{name = "oom-score-adj", type = .Enum, def = 0, enums = enum_oom_score_adj, store = &cfg.oom_score_adj, apply = config_apply_oom_score},
		{name = "acl-pubsub-default", type = .Enum, def = 0, enums = enum_acl_pubsub_default, store = &cfg.acl_pubsub_default},
		{name = "enable-protected-configs", type = .Enum, flags = {.Immutable}, def = 0, enums = enum_protected, store = (^u8)(&pst.protected)},
		{name = "enable-debug-command", type = .Enum, flags = {.Immutable}, def = 0, enums = enum_protected, store = &cfg.enable_debug_command},
		{name = "enable-module-command", type = .Enum, flags = {.Immutable}, def = 0, enums = enum_protected, store = &cfg.enable_module_command},
		{name = "cluster-preferred-endpoint-type", type = .Enum, def = 0, enums = enum_endpoint_type, store = &cfg.cluster_preferred_endpoint_type},
		{name = "propagation-error-behavior", type = .Enum, def = 0, enums = enum_propagation_error, store = &cfg.propagation_error_behavior},
		{name = "shutdown-on-sigint", type = .Enum, flags = {.Multi_Arg}, def = 0, enums = enum_shutdown_on_sig, store = &cfg.shutdown_on_sigint, check = config_check_shutdown_flags},
		{name = "shutdown-on-sigterm", type = .Enum, flags = {.Multi_Arg}, def = 0, enums = enum_shutdown_on_sig, store = &cfg.shutdown_on_sigterm, check = config_check_shutdown_flags},
		{name = "sanitize-dump-payload", type = .Enum, def = i64(Persist_Sanitize.No), enums = enum_sanitize, store = (^u8)(&pst.sanitize)},
		{name = "databases", type = .Special, flags = {.Immutable}, def = 16, special = &special_databases},
		{name = "port", type = .Num, def = 6379, lo = 0, hi = 65535, store = &srv.port, apply = config_apply_port},
		{name = "io-threads", type = .Num, flags = {.Immutable}, def = 1, lo = 1, hi = 128, store = &cfg.io_threads},
		{name = "auto-aof-rewrite-percentage", type = .Num, def = 100, lo = 0, hi = u64(INT_MAX_CFG), store = &aof.auto_pct},
