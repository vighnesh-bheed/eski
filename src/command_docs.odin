	{
		name = "client|kill",
		summary = "Terminates open connections.",
		since = "2.4.0",
		group = .Connection,
		complexity = "O(N) where N is the number of client connections",
		acl = {.Admin, .Slow, .Dangerous, .Connection},
		history = {
			{"2.8.12", "Added new filter format."},
			{"2.8.12", "`ID` option."},
			{"3.2.0", "Added `master` type in for `TYPE` option."},
			{"5.0.0", "Replaced `slave` `TYPE` with `replica`. `slave` still supported for backward compatibility."},
			{"6.2.0", "`LADDR` option."},
			{"7.4.0", "`MAXAGE` filter that selects clients connected for at least the given number of seconds."},
		},
		args = {
			{
				name = "filter",
				kind = .Oneof,
				args = {
					{name = "old-format", kind = .String, display = "ip:port", deprecated_since = "2.8.12"},
					{
						name = "new-format",
						kind = .Oneof,
						flags = {.Multiple},
						args = {
							{name = "client-id", kind = .Integer, token = "ID", since = "2.8.12", flags = {.Optional}},
							{
								name = "client-type",
								kind = .Oneof,
								token = "TYPE",
								since = "2.8.12",
								flags = {.Optional},
								args = {
									{name = "normal", kind = .Pure_Token, token = "NORMAL"},
									{name = "master", kind = .Pure_Token, token = "MASTER", since = "3.2.0"},
									{name = "slave", kind = .Pure_Token, token = "SLAVE"},
									{name = "replica", kind = .Pure_Token, token = "REPLICA", since = "5.0.0"},
									{name = "pubsub", kind = .Pure_Token, token = "PUBSUB"},
								},
							},
