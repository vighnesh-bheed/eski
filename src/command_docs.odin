package main

cmd_docs := [?]Cmd_Doc {
	{
		name = "acl",
		summary = "A container for Access List Control commands.",
		since = "6.0.0",
		group = .Server,
		complexity = "Depends on subcommand.",
		acl = {.Slow},
	},
	{
		name = "acl|cat",
		summary = "Lists the ACL categories, or the commands inside a category.",
		since = "6.0.0",
		group = .Server,
		complexity = "O(1) since the categories and commands are a fixed set.",
		acl = {.Slow},
		args = {
			{name = "category", kind = .String, flags = {.Optional}},
		},
	},
	{
		name = "acl|deluser",
		summary = "Deletes ACL users, and terminates their connections.",
		since = "6.0.0",
		group = .Server,
		complexity = "O(1) amortized time considering the typical user.",
		acl = {.Admin, .Slow, .Dangerous},
		tips = {"request_policy:all_nodes", "response_policy:all_succeeded"},
		args = {
			{name = "username", kind = .String, flags = {.Multiple}},
		},
	},
	{
		name = "acl|dryrun",
