		complexity = "O(1).",
		acl = {.Admin, .Slow, .Dangerous},
		args = {
			{name = "username", kind = .String},
			{name = "command", kind = .String},
			{name = "arg", kind = .String, flags = {.Optional, .Multiple}},
		},
	},
	{
		name = "acl|genpass",
		summary = "Generates a pseudorandom, secure password that can be used to identify ACL users.",
		since = "6.0.0",
		group = .Server,
		complexity = "O(1)",
		acl = {.Slow},
		args = {
			{name = "bits", kind = .Integer, flags = {.Optional}},
		},
	},
	{
		name = "acl|getuser",
		summary = "Lists the ACL rules of a user.",
		since = "6.0.0",
		group = .Server,
		complexity = "O(N). Where N is the number of password, command and pattern rules that the user has.",
		acl = {.Admin, .Slow, .Dangerous},
		history = {
			{"6.2.0", "Added Pub/Sub channel patterns."},
			{"7.0.0", "Added selectors and changed the format of key and channel patterns from a list to their rule representation."},
		},
		args = {
			{name = "username", kind = .String},
		},
	},
	{
		name = "acl|help",
		summary = "Returns helpful text about the different subcommands.",
		since = "6.0.0",
		group = .Server,
		complexity = "O(1)",
		acl = {.Slow},
	},
	{
		name = "acl|list",
