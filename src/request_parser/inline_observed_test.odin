		{"\x69\x6e\x6c\x69\x6e\x65\x2d\x63\x6f\x6e\x74\x65\x78\x74\x2d\x32\x32\x34\x31\x32\x32\x32\x30\x34\x32", "\x45\x43\x48\x4f\x20\x22\x41\x22\x20\x42\x0d\x0a", .Command, {"\x45\x43\x48\x4f", "\x41", "\x42"}, .None, 12},
		{"\x69\x6e\x6c\x69\x6e\x65\x2d\x63\x6f\x6e\x74\x65\x78\x74\x2d\x32\x32\x34\x31\x32\x32\x35\x63", "\x45\x43\x48\x4f\x20\x22\x41\x22\x5c\x0d\x0a", .Error, {}, .Unbalanced_Quotes, 0},
		{"\x69\x6e\x6c\x69\x6e\x65\x2d\x63\x6f\x6e\x74\x65\x78\x74\x2d\x32\x32\x34\x31\x32\x32\x31\x66", "\x45\x43\x48\x4f\x20\x22\x41\x22\x1f\x0d\x0a", .Error, {}, .Unbalanced_Quotes, 0},
		{"\x69\x6e\x6c\x69\x6e\x65\x2d\x63\x6f\x6e\x74\x65\x78\x74\x2d\x34\x31\x31\x66\x34\x32", "\x45\x43\x48\x4f\x20\x41\x1f\x42\x0d\x0a", .Command, {"\x45\x43\x48\x4f", "\x41\x1f\x42"}, .None, 10},
	}
	scratch: Scratch
	defer destroy(&scratch)
	owner: ^Inline_Owner
	defer inline_release(&owner)
	for fixture in fixtures {
		actual := parse_inline(transmute([]u8)fixture.wire, &scratch, &owner, normal_limits())
		if actual.kind != fixture.kind || actual.fault != fixture.fault || actual.argc != len(fixture.args) || actual.consumed != fixture.consumed {
			fmt.eprintf("inline fixture=%s kind=%v expected=%v fault=%v argc=%d expected_argc=%d consumed=%d expected_consumed=%d\n", fixture.label, actual.kind, fixture.kind, actual.fault, actual.argc, len(fixture.args), actual.consumed, fixture.consumed)
			testing.expect(t, false)
			continue
		}
		for expected, index in fixture.args {
			expect_equal(t, scratch.args[index], transmute([]u8)expected)
		}
	}
}
