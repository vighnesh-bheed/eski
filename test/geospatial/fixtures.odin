	second: f64,
	unit:   string,
	text:   string,
}

Storedist_Row :: struct {
	lon:        f64,
	lat:        f64,
	score:      f64,
	conversion: f64,
	stored:     f64,
}

Step_Row :: struct {
	meters: f64,
	lat:    f64,
	step:   u8,
}

