package blockingops

import "core:fmt"
import "core:strings"
import "core:testing"
import eski "../../src"

bulk :: proc(s: string) -> string {
	return fmt.tprintf("$%d\r\n%s\r\n", len(s), s)
}

pair :: proc(key, value: string) -> string {
	return strings.concatenate({"*2\r\n", bulk(key), bulk(value)}, context.temp_allocator)
}

@(test)
serving_fifty_waiters_in_blocking_order :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	waiters: [50]^Client
	for i in 0 ..< 50 {
		waiters[i] = connect()
		if i % 2 == 0 {
			start_cmd(t, waiters[i], "BLPOP", "fifty", "0")
		} else {
			start_cmd(t, waiters[i], "BRPOP", "other", "fifty", "0")
		}
	}
	testing.expect_value(t, info_field(w, "clients", "blocked_clients"), "50")
	testing.expect_value(t, info_field(w, "clients", "total_blocking_keys"), "2")
	args: [dynamic]string
	defer delete(args)
	append(&args, "RPUSH", "fifty")
	for i in 0 ..< 50 {
		append(&args, fmt.tprintf("e%d", i))
	}
	expect_call(t, w, ":50\r\n", ..args[:])
	got: [50]string
	for i in 0 ..< 50 {
		got[i] = reply(waiters[i])
	}
	front, back := 0, 49
	for i in 0 ..< 50 {
		want := ""
		if i % 2 == 0 {
			want = pair("fifty", fmt.tprintf("e%d", front))
			front += 1
		} else {
			want = pair("fifty", fmt.tprintf("e%d", back))
			back -= 1
		}
		testing.expectf(t, got[i] == want, "waiter %d got %q want %q", i, got[i], want)
		delete(got[i])
	}
	expect_call(t, w, ":0\r\n", "EXISTS", "fifty")
	for i in 0 ..< 50 {
		disconnect(waiters[i])
	}
	disconnect(w)
	idle_state(t)
}

@(test)
serving_multi_key_waiter_and_duplicates :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	a := connect()
	start_cmd(t, a, "BLPOP", "k1", "k2", "k3", "0")
	expect_call(t, w, ":1\r\n", "RPUSH", "k3", "v3")
	expect_reply(t, a, pair("k3", "v3"))
	start_cmd(t, a, "BLPOP", "list1", "list2", "list2", "list1", "0")
	testing.expect_value(t, eski.block_total_keys(), 2)
	expect_call(t, w, ":1\r\n", "LPUSH", "list1", "a")
	expect_reply(t, a, pair("list1", "a"))
	start_cmd(t, a, "BLPOP", "list1", "list2", "list2", "list1", "0")
	expect_call(t, w, ":1\r\n", "LPUSH", "list2", "b")
	expect_reply(t, a, pair("list2", "b"))
	expect_call(t, w, ":1\r\n", "LPUSH", "list1", "a")
	expect_call(t, w, ":1\r\n", "LPUSH", "list2", "b")
	expect_call(t, a, pair("list1", "a"), "BLPOP", "list1", "list2", "list2", "list1", "0")
	expect_call(t, a, pair("list2", "b"), "BLPOP", "list1", "list2", "list2", "list1", "0")
	start_cmd(t, a, "BLPOP", "blist", "0")
	expect_call(t, w, ":2\r\n", "LPUSH", "blist", "foo", "bar")
	expect_reply(t, a, pair("blist", "bar"))
	expect_call(t, w, "*1\r\n$3\r\nfoo\r\n", "LRANGE", "blist", "0", "-1")
	disconnect(a)
	disconnect(w)
	idle_state(t)
}

@(test)
serving_fairness_while_pipelining :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	rd1 := connect()
	rd2 := connect()
	start_cmd(t, rd1, "BLPOP", "mylist", "0")
	buf := strings.concatenate({string(encode("LPUSH", "mylist", "1")), string(encode("BLPOP", "mylist", "0"))}, context.temp_allocator)
	send_raw(rd2, transmute([]u8)buf)
	expect_reply(t, rd1, pair("mylist", "1"))
	expect_reply(t, rd2, ":1\r\n")
	wait_blocked(t, rd2)
	testing.expect_value(t, eski.block_count(), 1)
	expect_call(t, w, ":1\r\n", "LPUSH", "mylist", "2")
	expect_reply(t, rd2, pair("mylist", "2"))
	disconnect(rd2)
	disconnect(rd1)
	disconnect(w)
	idle_state(t)
}

@(test)
serving_nested_unblock_keeps_ready_order :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	rd1 := connect()
	rd2 := connect()
	rd3 := connect()
	start_cmd(t, rd1, "BRPOPLPUSH", "l1", "l3", "0")
	start_cmd(t, rd2, "BLPOP", "l2", "0")
	start_cmd(t, rd3, "BLMPOP", "0", "2", "l2", "l3", "LEFT", "COUNT", "1")
	expect_call(t, w, OK, "MULTI")
	expect_call(t, w, "+QUEUED\r\n", "LPUSH", "l1", "1")
	expect_call(t, w, "+QUEUED\r\n", "LPUSH", "l2", "2")
	expect_call(t, w, "*2\r\n:1\r\n:1\r\n", "EXEC")
	expect_reply(t, rd1, "$1\r\n1\r\n")
	expect_reply(t, rd2, pair("l2", "2"))
	expect_reply(t, rd3, "*2\r\n$2\r\nl3\r\n*1\r\n$1\r\n1\r\n")
	disconnect(rd3)
	disconnect(rd2)
	disconnect(rd1)
	disconnect(w)
	idle_state(t)
}

@(test)
serving_served_before_next_pipelined_command :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	rd1 := connect()
	rd2 := connect()
	start_cmd(t, rd1, "BLMOVE", "src", "dst", "LEFT", "RIGHT", "0")
	start_cmd(t, rd2, "BLMOVE", "dst", "src", "RIGHT", "LEFT", "0")
	buf := strings.concatenate({string(encode("SET", "key1", "v1")), string(encode("LPUSH", "src", "dummy")), string(encode("LRANGE", "src", "0", "-1")), string(encode("EXISTS", "dst"))}, context.temp_allocator)
	send_raw(w, transmute([]u8)buf)
	expect_reply(t, w, OK)
	expect_reply(t, w, ":1\r\n")
	expect_reply(t, w, "*1\r\n$5\r\ndummy\r\n")
	expect_reply(t, w, ":0\r\n")
	expect_reply(t, rd1, "$5\r\ndummy\r\n")
	expect_reply(t, rd2, "$5\r\ndummy\r\n")
	a := connect()
	raw := strings.concatenate({string(encode("BLPOP", "pq", "0")), string(encode("PING"))}, context.temp_allocator)
	send_raw(a, transmute([]u8)raw)
	wait_blocked(t, a)
	expect_silent(t, a)
	expect_call(t, w, ":1\r\n", "RPUSH", "pq", "v")
	expect_reply(t, a, pair("pq", "v"))
	expect_reply(t, a, "+PONG\r\n")
	disconnect(a)
	disconnect(rd2)
	disconnect(rd1)
	disconnect(w)
	idle_state(t)
}

@(test)
serving_blmove_chains :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	rd1 := connect()
	rd2 := connect()
	start_cmd(t, rd1, "BLMOVE", "list1", "list2", "RIGHT", "LEFT", "0")
	start_cmd(t, rd2, "BLMOVE", "list2", "list3", "LEFT", "RIGHT", "0")
	expect_call(t, w, ":1\r\n", "RPUSH", "list1", "foo")
	expect_call(t, w, "*0\r\n", "LRANGE", "list1", "0", "-1")
	expect_call(t, w, "*0\r\n", "LRANGE", "list2", "0", "-1")
	expect_call(t, w, "*1\r\n$3\r\nfoo\r\n", "LRANGE", "list3", "0", "-1")
	expect_reply(t, rd1, "$3\r\nfoo\r\n")
	expect_reply(t, rd2, "$3\r\nfoo\r\n")
	start_cmd(t, rd1, "BRPOPLPUSH", "c1", "c2", "0")
	start_cmd(t, rd2, "BRPOPLPUSH", "c2", "c1", "0")
	expect_call(t, w, ":1\r\n", "RPUSH", "c1", "foo")
	expect_call(t, w, "*1\r\n$3\r\nfoo\r\n", "LRANGE", "c1", "0", "-1")
	expect_call(t, w, "*0\r\n", "LRANGE", "c2", "0", "-1")
	expect_reply(t, rd1, "$3\r\nfoo\r\n")
	expect_reply(t, rd2, "$3\r\nfoo\r\n")
	start_cmd(t, rd1, "BRPOPLPUSH", "self", "self", "0")
	expect_call(t, w, ":1\r\n", "RPUSH", "self", "foo")
	expect_reply(t, rd1, "$3\r\nfoo\r\n")
	expect_call(t, w, "*1\r\n$3\r\nfoo\r\n", "LRANGE", "self", "0", "-1")
	start_cmd(t, rd2, "BLPOP", "target", "0")
	start_cmd(t, rd1, "BLMOVE", "blist", "target", "LEFT", "RIGHT", "0")
	expect_call(t, w, ":1\r\n", "RPUSH", "blist", "foo")
	expect_reply(t, rd1, "$3\r\nfoo\r\n")
	expect_reply(t, rd2, pair("target", "foo"))
	expect_call(t, w, ":0\r\n", "EXISTS", "target")
	disconnect(rd2)
	disconnect(rd1)
	disconnect(w)
	idle_state(t)
}

@(test)
serving_wrong_destination_type :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	rd1 := connect()
	rd2 := connect()
	expect_call(t, w, OK, "SET", "target", "nolist")
	start_cmd(t, rd1, "BRPOPLPUSH", "blist", "target", "0")
	expect_call(t, w, ":3\r\n", "RPUSH", "blist", "a", "b", "c")
	expect_reply(t, rd1, WRONGTYPE)
	expect_call(t, w, "*3\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n", "LRANGE", "blist", "0", "-1")
	expect_call(t, w, ":1\r\n", "DEL", "blist")
	expect_call(t, w, OK, "SET", "target1", "nolist")
	start_cmd(t, rd1, "BRPOPLPUSH", "blist", "target1", "0")
	start_cmd(t, rd2, "BRPOPLPUSH", "blist", "target2", "0")
	expect_call(t, w, ":1\r\n", "LPUSH", "blist", "foo")
	expect_reply(t, rd1, WRONGTYPE)
	expect_reply(t, rd2, "$3\r\nfoo\r\n")
	expect_call(t, w, "*1\r\n$3\r\nfoo\r\n", "LRANGE", "target2", "0", "-1")
	expect_call(t, rd1, WRONGTYPE, "BRPOPLPUSH", "target1", "x", "1")
	disconnect(rd2)
	disconnect(rd1)
	disconnect(w)
	idle_state(t)
}

@(test)
serving_bzmpop_several_waiters :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	rd1 := connect()
	rd2 := connect()
	rd3 := connect()
	rd4 := connect()
	start_cmd(t, rd1, "BZMPOP", "0", "2", "myzset", "myzset2", "MIN", "COUNT", "1")
	start_cmd(t, rd2, "BZMPOP", "0", "2", "myzset", "myzset2", "MAX", "COUNT", "10")
	start_cmd(t, rd3, "BZMPOP", "0", "2", "myzset", "myzset2", "MIN", "COUNT", "10")
	start_cmd(t, rd4, "BZMPOP", "0", "2", "myzset", "myzset2", "MAX", "COUNT", "1")
	expect_call(t, w, OK, "MULTI")
	expect_call(t, w, "+QUEUED\r\n", "ZADD", "myzset", "1", "a", "2", "b", "3", "c", "4", "d", "5", "e")
	expect_call(t, w, "+QUEUED\r\n", "ZADD", "myzset2", "1", "a", "2", "b", "3", "c", "4", "d", "5", "e")
	expect_call(t, w, "*2\r\n:5\r\n:5\r\n", "EXEC")
	zp :: proc(m, s: string) -> string {
		return strings.concatenate({"*2\r\n", bulk(m), bulk(s)}, context.temp_allocator)
	}
	expect_reply(t, rd1, strings.concatenate({"*2\r\n", bulk("myzset"), "*1\r\n", zp("a", "1")}, context.temp_allocator))
	expect_reply(t, rd2, strings.concatenate({"*2\r\n", bulk("myzset"), "*4\r\n", zp("e", "5"), zp("d", "4"), zp("c", "3"), zp("b", "2")}, context.temp_allocator))
	expect_reply(t, rd3, strings.concatenate({"*2\r\n", bulk("myzset2"), "*5\r\n", zp("a", "1"), zp("b", "2"), zp("c", "3"), zp("d", "4"), zp("e", "5")}, context.temp_allocator))
	expect_silent(t, rd4)
	expect_call(t, w, ":3\r\n", "ZADD", "myzset2", "1", "a", "2", "b", "3", "c")
	expect_reply(t, rd4, strings.concatenate({"*2\r\n", bulk("myzset2"), "*1\r\n", zp("c", "3")}, context.temp_allocator))
	start_cmd(t, rd1, "BZPOPMIN", "zset", "0")
	expect_call(t, w, ":2\r\n", "ZADD", "zset", "-1", "foo", "1", "bar")
	expect_reply(t, rd1, "*3\r\n$4\r\nzset\r\n$3\r\nfoo\r\n$2\r\n-1\r\n")
	expect_call(t, w, "*1\r\n$3\r\nbar\r\n", "ZRANGE", "zset", "0", "-1")
	start_cmd(t, rd1, "BZPOPMAX", "z1", "z2", "z2", "z1", "0")
	expect_call(t, w, ":1\r\n", "ZADD", "z2", "1", "b")
	expect_reply(t, rd1, "*3\r\n$2\r\nz2\r\n$1\r\nb\r\n$1\r\n1\r\n")
	disconnect(rd4)
	disconnect(rd3)
	disconnect(rd2)
	disconnect(rd1)
	disconnect(w)
	idle_state(t)
}

@(test)
serving_transactions_and_type_gating :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	rd := connect()
	start_cmd(t, rd, "BLPOP", "blist", "0")
	expect_call(t, w, OK, "MULTI")
	expect_call(t, w, "+QUEUED\r\n", "LPUSH", "blist", "a")
	expect_call(t, w, "+QUEUED\r\n", "LPUSH", "blist", "b")
	expect_call(t, w, "+QUEUED\r\n", "LPUSH", "blist", "c")
	expect_call(t, w, "*3\r\n:1\r\n:2\r\n:3\r\n", "EXEC")
	expect_reply(t, rd, pair("blist", "c"))
	start_cmd(t, rd, "BLPOP", "list", "0")
	expect_call(t, w, OK, "MULTI")
	expect_call(t, w, "+QUEUED\r\n", "LPUSH", "list", "a")
	expect_call(t, w, "+QUEUED\r\n", "DEL", "list")
	expect_call(t, w, "*2\r\n:1\r\n:1\r\n", "EXEC")
	expect_silent(t, rd)
	expect_call(t, w, OK, "MULTI")
	expect_call(t, w, "+QUEUED\r\n", "LPUSH", "list", "a")
	expect_call(t, w, "+QUEUED\r\n", "DEL", "list")
	expect_call(t, w, "+QUEUED\r\n", "SET", "list", "foo")
	expect_call(t, w, "*3\r\n:1\r\n:1\r\n+OK\r\n", "EXEC")
	expect_silent(t, rd)
	expect_call(t, w, ":1\r\n", "DEL", "list")
	expect_call(t, w, ":1\r\n", "LPUSH", "list", "b")
	expect_reply(t, rd, pair("list", "b"))
	xr := connect()
	start_cmd(t, rd, "BLPOP", "mixed", "0")
	testing.expect_value(t, info_field(w, "clients", "total_blocking_keys"), "1")
	testing.expect_value(t, info_field(w, "clients", "total_blocking_keys_on_nokey"), "0")
	expect_call(t, w, "$5\r\n666-0\r\n", "XADD", "mixed", "666", "key", "value")
	expect_call(t, w, OK, "XGROUP", "CREATE", "mixed", "mygroup", "$", "MKSTREAM")
	start_cmd(t, xr, "XREADGROUP", "GROUP", "mygroup", "myconsumer", "BLOCK", "0", "STREAMS", "mixed", ">")
	testing.expect_value(t, info_field(w, "clients", "blocked_clients"), "2")
	testing.expect_value(t, info_field(w, "clients", "total_blocking_keys"), "1")
	testing.expect_value(t, info_field(w, "clients", "total_blocking_keys_on_nokey"), "1")
	expect_call(t, w, ":1\r\n", "DEL", "mixed")
	expect_reply(t, xr, "-NOGROUP No such key 'mixed' or consumer group 'mygroup' in XREADGROUP with GROUP option\r\n")
	testing.expect_value(t, info_field(w, "clients", "total_blocking_keys"), "1")
	testing.expect_value(t, info_field(w, "clients", "total_blocking_keys_on_nokey"), "0")
	testing.expect_value(t, rd.conn.blocked, eski.Block_Type.List)
	expect_call(t, w, ":1\r\n", "ZADD", "mixed", "1", "m")
	expect_silent(t, rd)
	expect_call(t, w, ":1\r\n", "DEL", "mixed")
	expect_call(t, w, ":1\r\n", "RPUSH", "mixed", "ok")
	expect_reply(t, rd, pair("mixed", "ok"))
	disconnect(xr)
	disconnect(rd)
	disconnect(w)
	idle_state(t)
}

@(test)
serving_keyspace_paths_and_databases :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	a := connect()
	start_cmd(t, a, "BLPOP", "foo", "5")
	expect_call(t, w, ":3\r\n", "LPUSH", "bob", "abc", "def", "hij")
	expect_call(t, w, OK, "RENAME", "bob", "foo")
	expect_reply(t, a, pair("foo", "hij"))
	start_cmd(t, a, "BLMPOP", "5", "1", "sorted", "LEFT")
	expect_call(t, w, ":3\r\n", "RPUSH", "unsorted", "3", "1", "2")
	expect_call(t, w, ":3\r\n", "SORT", "unsorted", "STORE", "sorted")
	expect_reply(t, a, "*2\r\n$6\r\nsorted\r\n*1\r\n$1\r\n1\r\n")
	start_cmd(t, a, "BLPOP", "cp", "0")
	expect_call(t, w, ":1\r\n", "RPUSH", "cpsrc", "v")
	expect_call(t, w, ":1\r\n", "COPY", "cpsrc", "cp")
	expect_reply(t, a, pair("cp", "v"))
	start_cmd(t, a, "BZPOPMIN", "moved", "0")
	expect_call(t, w, OK, "SELECT", "2")
	expect_call(t, w, ":1\r\n", "ZADD", "moved", "7", "m")
	expect_call(t, w, ":1\r\n", "MOVE", "moved", "0")
	expect_call(t, w, OK, "SELECT", "0")
	expect_reply(t, a, "*3\r\n$5\r\nmoved\r\n$1\r\nm\r\n$1\r\n7\r\n")
	expect_call(t, a, OK, "SELECT", "1")
	start_cmd(t, a, "BLPOP", "dbk", "0")
	expect_call(t, w, ":1\r\n", "RPUSH", "dbk", "zero")
	expect_silent(t, a)
	expect_call(t, w, OK, "SELECT", "1")
	expect_call(t, w, ":1\r\n", "RPUSH", "dbk", "one")
	expect_reply(t, a, pair("dbk", "one"))
	expect_call(t, w, OK, "SELECT", "0")
	expect_call(t, a, OK, "SELECT", "9")
	start_cmd(t, a, "BRPOP", "k", "5")
	expect_call(t, w, OK, "SELECT", "4")
	expect_call(t, w, ":1\r\n", "RPUSH", "k", "hello")
	expect_call(t, w, OK, "SWAPDB", "4", "9")
	expect_reply(t, a, pair("k", "hello"))
	expect_call(t, w, OK, "SELECT", "0")
	disconnect(a)
	disconnect(w)
	idle_state(t)
}

@(test)
serving_group_readers_on_missing_or_retyped_keys :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	rd := connect()
	setup_group :: proc(t: ^testing.T, w: ^Client) {
		r := call(w, "DEL", "mystream")
		delete(r)
		expect_call(t, w, "$5\r\n666-0\r\n", "XADD", "mystream", "666", "f", "v")
		expect_call(t, w, OK, "XGROUP", "CREATE", "mystream", "mygroup", "$")
	}
	nogroup :: "-NOGROUP No such key 'mystream' or consumer group 'mygroup' in XREADGROUP with GROUP option\r\n"
	setup_group(t, w)
	start_cmd(t, rd, "XREADGROUP", "GROUP", "mygroup", "Alice", "BLOCK", "0", "STREAMS", "mystream", ">")
	expect_call(t, w, OK, "SET", "mystream", "val1")
	expect_reply(t, rd, WRONGTYPE)
	setup_group(t, w)
	start_cmd(t, rd, "XREADGROUP", "GROUP", "mygroup", "Alice", "BLOCK", "0", "STREAMS", "mystream", ">")
	expect_call(t, w, OK, "MULTI")
	expect_call(t, w, "+QUEUED\r\n", "DEL", "mystream")
	expect_call(t, w, "+QUEUED\r\n", "SADD", "mystream", "e1")
	expect_call(t, w, "*2\r\n:1\r\n:1\r\n", "EXEC")
	expect_reply(t, rd, WRONGTYPE)
	setup_group(t, w)
	start_cmd(t, rd, "XREADGROUP", "GROUP", "mygroup", "Alice", "BLOCK", "0", "STREAMS", "mystream", ">")
	expect_call(t, w, OK, "FLUSHALL")
	expect_reply(t, rd, nogroup)
	expect_call(t, w, OK, "SELECT", "4")
	expect_call(t, w, OK, "FLUSHDB")
	expect_call(t, w, OK, "SELECT", "0")
	setup_group(t, w)
	start_cmd(t, rd, "XREADGROUP", "GROUP", "mygroup", "Alice", "BLOCK", "0", "STREAMS", "mystream", ">")
	expect_call(t, w, OK, "SWAPDB", "4", "0")
	expect_reply(t, rd, nogroup)
	expect_call(t, w, OK, "SWAPDB", "4", "0")
	expect_call(t, w, OK, "SELECT", "4")
	expect_call(t, w, ":1\r\n", "LPUSH", "mystream", "e1")
	expect_call(t, w, OK, "SELECT", "0")
	setup_group(t, w)
	start_cmd(t, rd, "XREADGROUP", "GROUP", "mygroup", "Alice", "BLOCK", "0", "STREAMS", "mystream", ">")
	expect_call(t, w, OK, "SWAPDB", "4", "0")
	expect_reply(t, rd, WRONGTYPE)
	expect_call(t, w, OK, "SWAPDB", "4", "0")
	expect_call(t, w, OK, "XGROUP", "CREATE", "mystream2", "mygroup", "$", "MKSTREAM")
	expect_call(t, w, "$5\r\n100-0\r\n", "XADD", "mystream2", "100", "f1", "v1")
	start_cmd(t, rd, "XREADGROUP", "GROUP", "mygroup", "Alice", "BLOCK", "0", "STREAMS", "mystream", ">")
	expect_call(t, w, OK, "RENAME", "mystream2", "mystream")
	expect_reply(t, rd, "*1\r\n*2\r\n$8\r\nmystream\r\n*1\r\n*2\r\n$5\r\n100-0\r\n*2\r\n$2\r\nf1\r\n$2\r\nv1\r\n")
	r1 := connect()
	r2 := connect()
	r3 := connect()
	expect_call(t, w, ":1\r\n", "DEL", "mystream")
	expect_call(t, w, OK, "XGROUP", "CREATE", "mystream", "mygroup", "$", "MKSTREAM")
	for r in ([]^Client{r1, r2, r3}) {
		start_cmd(t, r, "XREADGROUP", "GROUP", "mygroup", "myuser", "COUNT", "10", "BLOCK", "10000", "STREAMS", "mystream", ">")
	}
	expect_call(t, w, "$5\r\n700-0\r\n", "XADD", "mystream", "700", "field1", "value1")
	expect_reply(t, r1, "*1\r\n*2\r\n$8\r\nmystream\r\n*1\r\n*2\r\n$5\r\n700-0\r\n*2\r\n$6\r\nfield1\r\n$6\r\nvalue1\r\n")
	testing.expect_value(t, eski.block_count(), 2)
	expect_call(t, w, "+PONG\r\n", "PING")
	disconnect(r3)
	disconnect(r2)
	disconnect(r1)
	disconnect(rd)
	disconnect(w)
	idle_state(t)
}

@(test)
serving_reparses_inline_and_large_commands :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	a := connect()
	send_raw(a, transmute([]u8)string("BLPOP iq 0\r\nPING\r\n"))
	wait_blocked(t, a)
	expect_call(t, w, ":1\r\n", "RPUSH", "iq", "v")
	expect_reply(t, a, pair("iq", "v"))
	expect_reply(t, a, "+PONG\r\n")
	big := strings.repeat("k", 300000, context.temp_allocator)
	value := strings.repeat("v", 200000, context.temp_allocator)
	raw := strings.concatenate({string(encode("BRPOP", "other", big, "0")), string(encode("ECHO", "after"))}, context.temp_allocator)
	send_raw(a, transmute([]u8)raw)
	wait_blocked(t, a)
	expect_call(t, w, ":1\r\n", "RPUSH", "other2", "x")
	expect_silent(t, a)
	expect_call(t, w, ":1\r\n", "RPUSH", big, value)
	expect_reply(t, a, pair(big, value))
	expect_reply(t, a, "$5\r\nafter\r\n")
	start_cmd(t, a, "BLPOP", big, "0")
	expect_call(t, w, ":1\r\n", "CLIENT", "UNBLOCK", id_of(a))
	expect_reply(t, a, NULL_ARRAY)
	expect_call(t, a, "+PONG\r\n", "PING")
	disconnect(a)
	disconnect(w)
	idle_state(t)
}
