package blockingops

import "core:strings"
import "core:testing"
import "core:time"
import eski "../../src"

@(test)
transcript_timeouts_and_argument_errors :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	a := connect()
	timed :: proc(t: ^testing.T, a: ^Client, lo, hi: f64, args: ..string, loc := #caller_location) {
		start := time.tick_now()
		expect_call(t, a, NULL_ARRAY, ..args, loc = loc)
		ms := elapsed_ms(start)
		testing.expectf(t, ms >= lo && ms < hi, "elapsed %v outside [%v, %v)", ms, lo, hi, loc = loc)
	}
	timed(t, a, 95, 400, "BLPOP", "l", "0.1")
	expect_call(t, a, "-ERR timeout is negative\r\n", "BLPOP", "l", "-1")
	expect_call(t, a, "-ERR timeout is not a float or out of range\r\n", "BLPOP", "l", "x")
	expect_call(t, a, "-ERR timeout is out of range\r\n", "BLPOP", "l", "1e30")
	expect_call(t, a, "-ERR wrong number of arguments for 'blpop' command\r\n", "BLPOP", "l")
	timed(t, a, 95, 400, "BRPOPLPUSH", "l", "d", "0.1")
	timed(t, a, 95, 400, "BLMOVE", "l", "d", "LEFT", "RIGHT", "0.1")
	expect_call(t, a, "-ERR syntax error\r\n", "BLMOVE", "l", "d", "UP", "RIGHT", "0.1")
	timed(t, a, 95, 400, "BLMPOP", "0.1", "2", "l", "l2", "LEFT", "COUNT", "2")
	expect_call(t, a, "-ERR wrong number of arguments for 'blmpop' command\r\n", "BLMPOP", "0.1", "0", "LEFT")
	expect_call(t, a, "-ERR count should be greater than 0\r\n", "BLMPOP", "0.1", "1", "l", "LEFT", "COUNT", "0")
	timed(t, a, 95, 400, "BZPOPMIN", "z", "0.1")
	timed(t, a, 95, 400, "BZMPOP", "0.1", "1", "z", "MIN", "COUNT", "2")
	timed(t, a, 95, 400, "XREAD", "BLOCK", "100", "STREAMS", "s", "$")
	timed(t, a, 95, 400, "XREAD", "BLOCK", "100", "STREAMS", "nokey", "0")
	expect_call(t, w, OK, "SET", "str", "x")
	expect_call(t, a, WRONGTYPE, "BLPOP", "str", "0.1")
	expect_call(t, a, WRONGTYPE, "BLPOP", "l", "str", "0.1")
	expect_call(t, a, WRONGTYPE, "BZPOPMIN", "str", "0.1")
	expect_call(t, a, WRONGTYPE, "XREAD", "BLOCK", "100", "STREAMS", "str", "$")
	timed(t, a, 45, 350, "BLPOP", "l", "0.05")
	timed(t, a, 95, 400, "BLPOP", "l", "00.1")
	timed(t, a, 95, 400, "BLPOP", "l", ".1")
	timed(t, a, 995, 1400, "BLPOP", "l", "1.")
	expect_call(t, a, "-ERR timeout is out of range\r\n", "BLPOP", "l", "inf")
	timed(t, a, 0, 300, "BLPOP", "l", "0.0001")
	disconnect(a)
	disconnect(w)
	idle_state(t)
}

@(test)
transcript_wake_up_order_and_serving :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	a := connect()
	b := connect()
	c := connect()
	start_cmd(t, a, "BLPOP", "q", "0")
	start_cmd(t, b, "BLPOP", "q", "q2", "0")
	start_cmd(t, c, "BRPOP", "q", "0")
	testing.expect_value(t, info_field(w, "clients", "blocked_clients"), "3")
	testing.expect_value(t, info_field(w, "clients", "total_blocking_keys"), "2")
	testing.expect_value(t, info_field(w, "clients", "total_blocking_keys_on_nokey"), "0")
	expect_call(t, w, ":2\r\n", "RPUSH", "q", "x1", "x2")
	expect_reply(t, a, "*2\r\n$1\r\nq\r\n$2\r\nx1\r\n")
	expect_reply(t, b, "*2\r\n$1\r\nq\r\n$2\r\nx2\r\n")
	expect_silent(t, c)
	expect_call(t, w, ":1\r\n", "LPUSH", "q2", "y")
	expect_silent(t, c)
	expect_call(t, w, ":1\r\n", "RPUSH", "q", "x3")
	expect_reply(t, c, "*2\r\n$1\r\nq\r\n$2\r\nx3\r\n")
	expect_call(t, w, "*1\r\n$1\r\ny\r\n", "LRANGE", "q2", "0", "-1")
	start_cmd(t, a, "BLPOP", "q", "0")
	start_cmd(t, b, "BLMOVE", "q", "dst", "LEFT", "RIGHT", "0")
	expect_call(t, w, OK, "MULTI")
	expect_call(t, w, "+QUEUED\r\n", "RPUSH", "q", "a")
	expect_call(t, w, "+QUEUED\r\n", "RPUSH", "q", "b")
	expect_call(t, w, "*2\r\n:1\r\n:2\r\n", "EXEC")
	expect_reply(t, a, "*2\r\n$1\r\nq\r\n$1\r\na\r\n")
	expect_reply(t, b, "$1\r\nb\r\n")
	expect_call(t, w, "*1\r\n$1\r\nb\r\n", "LRANGE", "dst", "0", "-1")
	start_cmd(t, a, "BLMPOP", "0", "2", "m1", "m2", "RIGHT", "COUNT", "2")
	expect_call(t, w, ":3\r\n", "RPUSH", "m2", "1", "2", "3")
	expect_reply(t, a, "*2\r\n$2\r\nm2\r\n*2\r\n$1\r\n3\r\n$1\r\n2\r\n")
	expect_call(t, w, "*1\r\n$1\r\n1\r\n", "LRANGE", "m2", "0", "-1")
	start_cmd(t, a, "BZPOPMIN", "zz", "0")
	start_cmd(t, b, "BZMPOP", "0", "1", "zz", "MAX", "COUNT", "5")
	expect_call(t, w, ":3\r\n", "ZADD", "zz", "1", "a", "2", "b", "3", "c")
	expect_reply(t, a, "*3\r\n$2\r\nzz\r\n$1\r\na\r\n$1\r\n1\r\n")
	expect_reply(t, b, "*2\r\n$2\r\nzz\r\n*2\r\n*2\r\n$1\r\nc\r\n$1\r\n3\r\n*2\r\n$1\r\nb\r\n$1\r\n2\r\n")
	disconnect(c)
	disconnect(b)
	disconnect(a)
	disconnect(w)
	idle_state(t)
}

unblock_quiet :: proc(t: ^testing.T, w, cl: ^Client, want: string, loc := #caller_location) {
	expect_call(t, w, want, "CLIENT", "UNBLOCK", id_of(cl), loc = loc)
	pump(3, 2)
	clear(&cl.buf)
	_ = silent(cl, 20)
	clear(&cl.buf)
}

@(test)
transcript_deleted_type_changed_swapdb_flush :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	a := connect()
	start_cmd(t, a, "BLPOP", "k1", "0")
	expect_call(t, w, OK, "SET", "k1", "string")
	expect_silent(t, a)
	expect_call(t, w, ":1\r\n", "DEL", "k1")
	expect_call(t, w, ":1\r\n", "RPUSH", "k1", "v")
	expect_reply(t, a, "*2\r\n$2\r\nk1\r\n$1\r\nv\r\n")
	start_cmd(t, a, "XREAD", "BLOCK", "0", "STREAMS", "xs", "$")
	expect_call(t, w, "$3\r\n1-1\r\n", "XADD", "xs", "1-1", "f", "v")
	expect_reply(t, a, "*1\r\n*2\r\n$2\r\nxs\r\n*1\r\n*2\r\n$3\r\n1-1\r\n*2\r\n$1\r\nf\r\n$1\r\nv\r\n")
	start_cmd(t, a, "XREAD", "BLOCK", "0", "STREAMS", "xs", "$")
	expect_call(t, w, ":1\r\n", "DEL", "xs")
	expect_silent(t, a)
	expect_call(t, w, "$3\r\n2-1\r\n", "XADD", "xs", "2-1", "f", "v")
	expect_reply(t, a, "*1\r\n*2\r\n$2\r\nxs\r\n*1\r\n*2\r\n$3\r\n2-1\r\n*2\r\n$1\r\nf\r\n$1\r\nv\r\n")
	unblock_quiet(t, w, a, ":0\r\n")
	start_cmd(t, a, "XREAD", "BLOCK", "0", "STREAMS", "xs", "$")
	expect_call(t, w, OK, "SET", "xs", "str")
	expect_silent(t, a)
	unblock_quiet(t, w, a, ":1\r\n")
	expect_call(t, w, ":1\r\n", "DEL", "xs")
	expect_call(t, w, "$3\r\n1-1\r\n", "XADD", "gs", "1-1", "f", "v")
	expect_call(t, w, OK, "XGROUP", "CREATE", "gs", "g", "$")
	start_cmd(t, a, "XREADGROUP", "GROUP", "g", "c1", "BLOCK", "0", "STREAMS", "gs", ">")
	expect_call(t, w, ":1\r\n", "XGROUP", "DESTROY", "gs", "g")
	expect_reply(t, a, "-NOGROUP No such key 'gs' or consumer group 'g' in XREADGROUP with GROUP option\r\n")
	unblock_quiet(t, w, a, ":0\r\n")
	expect_call(t, w, OK, "XGROUP", "CREATE", "gs", "g", "$")
	start_cmd(t, a, "XREADGROUP", "GROUP", "g", "c1", "BLOCK", "0", "STREAMS", "gs", ">")
	expect_call(t, w, ":1\r\n", "DEL", "gs")
	expect_reply(t, a, "-NOGROUP No such key 'gs' or consumer group 'g' in XREADGROUP with GROUP option\r\n")
	unblock_quiet(t, w, a, ":0\r\n")
	start_cmd(t, a, "BLPOP", "sw", "0")
	expect_call(t, w, OK, "SELECT", "1")
	expect_call(t, w, ":1\r\n", "RPUSH", "sw", "from-db1")
	expect_call(t, w, OK, "SELECT", "0")
	expect_call(t, w, OK, "SWAPDB", "0", "1")
	expect_reply(t, a, "*2\r\n$2\r\nsw\r\n$8\r\nfrom-db1\r\n")
	unblock_quiet(t, w, a, ":0\r\n")
	expect_call(t, w, OK, "SWAPDB", "0", "1")
	expect_call(t, w, OK, "SELECT", "1")
	expect_call(t, w, ":0\r\n", "DEL", "sw")
	expect_call(t, w, OK, "SELECT", "0")
	start_cmd(t, a, "BLPOP", "fl", "0")
	expect_call(t, w, ":1\r\n", "RPUSH", "fl", "v")
	expect_reply(t, a, "*2\r\n$2\r\nfl\r\n$1\r\nv\r\n")
	start_cmd(t, a, "BLPOP", "fl", "0")
	expect_call(t, w, OK, "FLUSHALL")
	expect_silent(t, a)
	expect_call(t, w, ":1\r\n", "RPUSH", "fl", "v2")
	expect_reply(t, a, "*2\r\n$2\r\nfl\r\n$2\r\nv2\r\n")
	unblock_quiet(t, w, a, ":0\r\n")
	disconnect(a)
	disconnect(w)
	idle_state(t)
}

@(test)
transcript_client_unblock_kill_disconnect :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	a := connect()
	start_cmd(t, a, "BLPOP", "u", "0")
	expect_call(t, w, ":0\r\n", "CLIENT", "UNBLOCK", id_of(w))
	unblock_quiet(t, w, a, ":1\r\n")
	a2 := connect()
	start_cmd(t, a2, "BLPOP", "u", "0")
	expect_call(t, w, ":1\r\n", "CLIENT", "UNBLOCK", id_of(a2))
	expect_reply(t, a2, NULL_ARRAY)
	start_cmd(t, a2, "BLPOP", "u", "0")
	expect_call(t, w, ":1\r\n", "CLIENT", "UNBLOCK", id_of(a2), "TIMEOUT")
	expect_reply(t, a2, NULL_ARRAY)
	start_cmd(t, a2, "BLPOP", "u", "0")
	expect_call(t, w, ":1\r\n", "CLIENT", "UNBLOCK", id_of(a2), "ERROR")
	expect_reply(t, a2, "-UNBLOCKED client unblocked via CLIENT UNBLOCK\r\n")
	expect_call(t, w, ":0\r\n", "CLIENT", "UNBLOCK", id_of(a2))
	expect_call(t, w, ":0\r\n", "CLIENT", "UNBLOCK", "999999")
	expect_call(t, w, "-ERR CLIENT UNBLOCK reason should be TIMEOUT or ERROR\r\n", "CLIENT", "UNBLOCK", id_of(a2), "BOGUS")
	expect_call(t, w, "-ERR value is not an integer or out of range\r\n", "CLIENT", "UNBLOCK", "x")
	start_cmd(t, a2, "XREAD", "BLOCK", "0", "STREAMS", "ux", "$")
	expect_call(t, w, ":1\r\n", "CLIENT", "UNBLOCK", id_of(a2))
	expect_reply(t, a2, NULL_ARRAY)
	start_cmd(t, a2, "BZPOPMIN", "uz", "0")
	expect_call(t, w, ":1\r\n", "CLIENT", "UNBLOCK", id_of(a2), "ERROR")
	expect_reply(t, a2, "-UNBLOCKED client unblocked via CLIENT UNBLOCK\r\n")
	start_cmd(t, a2, "BRPOPLPUSH", "u", "v", "0")
	expect_call(t, w, ":1\r\n", "CLIENT", "UNBLOCK", id_of(a2))
	expect_reply(t, a2, NULL_ARRAY)
	start_cmd(t, a, "BLPOP", "u", "0")
	testing.expect_value(t, info_field(w, "clients", "blocked_clients"), "1")
	testing.expect_value(t, info_field(w, "clients", "total_blocking_keys"), "1")
	testing.expect_value(t, info_field(w, "clients", "total_blocking_keys_on_nokey"), "0")
	list := call(w, "CLIENT", "LIST", "TYPE", "normal")
	defer delete(list)
	found_a, found_a2 := false, false
	rest := list
	for line in strings.split_lines_iterator(&rest) {
		if strings.contains(line, strings.concatenate({"id=", id_of(a), " "}, context.temp_allocator)) {
			found_a = true
			testing.expect(t, strings.contains(line, " flags=b "), line)
			testing.expect(t, strings.contains(line, " cmd=blpop "), line)
		}
		if strings.contains(line, strings.concatenate({"id=", id_of(a2), " "}, context.temp_allocator)) {
			found_a2 = true
			testing.expect(t, strings.contains(line, " flags=N "), line)
			testing.expect(t, strings.contains(line, " cmd=brpoplpush "), line)
		}
	}
	testing.expect(t, found_a && found_a2, "client list lines missing")
	expect_call(t, w, ":1\r\n", "CLIENT", "KILL", "ID", id_of(a2))
	disconnect(a)
	pump(3, 2)
	testing.expect_value(t, info_field(w, "clients", "blocked_clients"), "0")
	testing.expect_value(t, info_field(w, "clients", "total_blocking_keys"), "0")
	testing.expect_value(t, info_field(w, "clients", "total_blocking_keys_on_nokey"), "0")
	disconnect(a2)
	disconnect(w)
	idle_state(t)
}

@(test)
transcript_multi_reply_modes_pause_expiry :: proc(t: ^testing.T) {
	context.allocator = begin()
	w := fresh()
	e := connect()
	expect_call(t, e, OK, "MULTI")
	expect_call(t, e, "+QUEUED\r\n", "BLPOP", "nolist", "0")
	expect_call(t, e, "+QUEUED\r\n", "BLMPOP", "0", "1", "nolist", "LEFT")
	expect_call(t, e, "+QUEUED\r\n", "XREAD", "BLOCK", "0", "STREAMS", "nostream", "$")
	expect_call(t, e, "*3\r\n*-1\r\n*-1\r\n*-1\r\n", "EXEC")
	send(e, "CLIENT", "REPLY", "OFF")
	pump(3, 2)
	start_cmd(t, e, "BLPOP", "rm", "0")
	expect_call(t, w, ":1\r\n", "RPUSH", "rm", "v")
	expect_silent(t, e, 100)
	expect_call(t, e, OK, "CLIENT", "REPLY", "ON")
	expect_call(t, e, "+PONG\r\n", "PING")
	expect_call(t, w, OK, "CLIENT", "PAUSE", "300", "WRITE")
	send(e, "BLPOP", "pz", "0")
	pump(3, 5)
	expect_call(t, w, OK, "CLIENT", "UNPAUSE")
	wait_blocked(t, e)
	expect_call(t, w, ":1\r\n", "RPUSH", "pz", "v")
	expect_reply(t, e, "*2\r\n$2\r\npz\r\n$1\r\nv\r\n")
	expect_call(t, w, ":1\r\n", "RPUSH", "exp", "v")
	expect_call(t, w, ":1\r\n", "PEXPIRE", "exp", "100")
	time.sleep(200 * time.Millisecond)
	start := time.tick_now()
	expect_call(t, e, NULL_ARRAY, "BLPOP", "exp", "0.3")
	ms := elapsed_ms(start)
	testing.expectf(t, ms >= 295 && ms < 700, "expired list wait %v", ms)
	expect_call(t, w, ":5\r\n", "RPUSH", "big", "0", "1", "2", "3", "4")
	expect_call(t, e, "*2\r\n$3\r\nbig\r\n*5\r\n$1\r\n0\r\n$1\r\n1\r\n$1\r\n2\r\n$1\r\n3\r\n$1\r\n4\r\n", "BLMPOP", "0", "1", "big", "LEFT", "COUNT", "10")
	testing.expect_value(t, info_field(w, "clients", "blocked_clients"), "0")
	testing.expect_value(t, info_field(w, "clients", "total_blocking_keys"), "0")
	disconnect(e)
	disconnect(w)
	idle_state(t)
	_ = eski.block_count
}
