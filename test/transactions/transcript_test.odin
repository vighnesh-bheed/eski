package transactions

import "core:fmt"
import "core:strconv"
import "core:strings"
import "core:testing"
import j "../../src"

EXECABORT_PREVIOUS :: "-EXECABORT Transaction discarded because of previous errors.\r\n"

OOM_REPLY :: "-OOM command not allowed when used memory > 'maxmemory'.\r\n"

rdb_changes :: proc(cl: Client) -> int {
	v, _ := strconv.parse_int(info_field(cl, "persistence", "rdb_changes_since_last_save"))
	return v
}

client_list_line :: proc(listing: string, id: i64) -> string {
	want := fmt.tprintf("id=%d ", id)
	rest := listing
	for line in strings.split_lines_iterator(&rest) {
		if strings.has_prefix(line, want) {
			return line
		}
	}
	return ""
}

exec_ping_wire :: proc(t: ^testing.T, a: Client, want: string, loc := #caller_location) {
	expect_wire(t, a, "MULTI", "+OK\r\n", loc)
	expect_wire(t, a, "PING", "+QUEUED\r\n", loc)
	expect_wire(t, a, "EXEC", want, loc)
}

@(test)
transcript_basic_and_queue_errors :: proc(t: ^testing.T) {
	context.allocator = boot()
	a := open_client()
	defer close_client(a)
	expect_wire(t, a, "FLUSHALL", "+OK\r\n")
	expect_wire(t, a, "EXEC", "-ERR EXEC without MULTI\r\n")
	expect_wire(t, a, "DISCARD", "-ERR DISCARD without MULTI\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "MULTI", "-ERR MULTI calls can not be nested\r\n")
	expect_wire(t, a, "SET k 1", "+QUEUED\r\n")
	expect_wire(t, a, "INCR k", "+QUEUED\r\n")
	expect_wire(t, a, "GET k", "+QUEUED\r\n")
	expect_wire(t, a, "WATCH k", "-ERR WATCH inside MULTI is not allowed\r\n")
	expect_wire(t, a, "EXEC", "*3\r\n+OK\r\n:2\r\n$1\r\n2\r\n")
	expect_wire(t, a, "GET k", "$1\r\n2\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "SET k 2", "+QUEUED\r\n")
	expect_wire(t, a, "DISCARD", "+OK\r\n")
	expect_wire(t, a, "GET k", "$1\r\n2\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "EXEC", "*0\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "DISCARD x", "-ERR wrong number of arguments for 'discard' command\r\n")
	expect_wire(t, a, "EXEC x", "-EXECABORT Transaction discarded because of: wrong number of arguments for 'exec' command\r\n")
	expect_wire(t, a, "MULTI x", "-ERR wrong number of arguments for 'multi' command\r\n")
	expect_wire(t, a, "EXEC", "-ERR EXEC without MULTI\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "SET k", "-ERR wrong number of arguments for 'set' command\r\n")
	expect_wire(t, a, "GET k", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", EXECABORT_PREVIOUS)
	expect_wire(t, a, "GET k", "$1\r\n2\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "BOGUSCMD x", "-ERR unknown command 'BOGUSCMD', with args beginning with: 'x' \r\n")
	expect_wire(t, a, "GET k", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", EXECABORT_PREVIOUS)
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "CONFIG BOGUS", "-ERR unknown subcommand 'BOGUS'. Try CONFIG HELP.\r\n")
	expect_wire(t, a, "EXEC", EXECABORT_PREVIOUS)
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "CLIENT LIST TYPE", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", "*1\r\n-ERR syntax error\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "XGROUP CREATE x", "-ERR wrong number of arguments for 'xgroup|create' command\r\n")
	expect_wire(t, a, "EXEC", EXECABORT_PREVIOUS)
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "SET k 1", "+QUEUED\r\n")
	expect_wire(t, a, "DISCARD", "+OK\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "INCR k", "+QUEUED\r\n")
	expect_wire(t, a, "LPUSH k x", "+QUEUED\r\n")
	expect_wire(t, a, "INCR k", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", "*3\r\n:3\r\n-WRONGTYPE Operation against a key holding the wrong kind of value\r\n:4\r\n")
	expect_wire(t, a, "GET k", "$1\r\n4\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "BLPOP nolist 0", "+QUEUED\r\n")
	expect_wire(t, a, "BRPOPLPUSH nolist dst 0", "+QUEUED\r\n")
	expect_wire(t, a, "XREAD BLOCK 0 STREAMS nostream $", "+QUEUED\r\n")
	expect_wire(t, a, "WAIT 1 1", "+QUEUED\r\n")
	expect_wire(t, a, "SELECT 2", "+QUEUED\r\n")
	expect_wire(t, a, "SET db2 v", "+QUEUED\r\n")
	expect_wire(t, a, "SELECT 0", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", "*7\r\n*-1\r\n$-1\r\n*-1\r\n:0\r\n+OK\r\n+OK\r\n+OK\r\n")
	expect_wire(t, a, "SELECT 2", "+OK\r\n")
	expect_wire(t, a, "GET db2", "$1\r\nv\r\n")
	expect_wire(t, a, "SELECT 0", "+OK\r\n")
}

@(test)
transcript_watch_semantics :: proc(t: ^testing.T) {
	context.allocator = boot()
	a := open_client()
	w := open_client()
	defer close_client(a)
	defer close_client(w)
	expect_wire(t, a, "FLUSHALL", "+OK\r\n")
	expect_wire(t, w, "SET wk 1", "+OK\r\n")
	expect_wire(t, a, "WATCH wk", "+OK\r\n")
	expect_wire(t, w, "SET wk 2", "+OK\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "GET wk", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", "*-1\r\n")
	expect_wire(t, a, "WATCH wk", "+OK\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "GET wk", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", "*1\r\n$1\r\n2\r\n")
	expect_wire(t, a, "WATCH wk", "+OK\r\n")
	expect_wire(t, w, "SET wk 2", "+OK\r\n")
	expect_wire(t, a, "UNWATCH", "+OK\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "GET wk", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", "*1\r\n$1\r\n2\r\n")
	expect_wire(t, a, "WATCH wk", "+OK\r\n")
	expect_wire(t, a, "SET wk 3", "+OK\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "GET wk", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", "*-1\r\n")
	expect_wire(t, a, "WATCH wk", "+OK\r\n")
	expect_wire(t, w, "SET wk 3", "+OK\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "GET wk", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", "*-1\r\n")
	expect_wire(t, a, "WATCH wk wk2", "+OK\r\n")
	expect_wire(t, w, "DEL nonexist", ":0\r\n")
	expect_wire(t, w, "SET wk2 1", "+OK\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "EXEC", "*-1\r\n")
	expect_wire(t, a, "WATCH missing", "+OK\r\n")
	expect_wire(t, w, "SET missing 1", "+OK\r\n")
	expect_wire(t, w, "DEL missing", ":1\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "EXEC", "*-1\r\n")
	expect_wire(t, a, "WATCH wk", "+OK\r\n")
	expect_wire(t, a, "WATCH wk", "+OK\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "WATCH wk", "-ERR WATCH inside MULTI is not allowed\r\n")
	expect_wire(t, a, "EXEC", "*0\r\n")
	expect_wire(t, a, "WATCH", "-ERR wrong number of arguments for 'watch' command\r\n")
	expect_wire(t, a, "UNWATCH x", "-ERR wrong number of arguments for 'unwatch' command\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "UNWATCH", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", "*1\r\n+OK\r\n")
	expect_wire(t, w, "SET ex 1 PX 100", "+OK\r\n")
	expect_wire(t, a, "WATCH ex", "+OK\r\n")
	settle(150)
	exec_ping_wire(t, a, "*-1\r\n")
	expect_wire(t, w, "SET ex2 1 PX 100", "+OK\r\n")
	expect_wire(t, a, "WATCH ex2", "+OK\r\n")
	settle(150)
	expect_wire(t, w, "GET ex2", "$-1\r\n")
	exec_ping_wire(t, a, "*-1\r\n")
	expect_wire(t, a, "WATCH ex3", "+OK\r\n")
	expect_wire(t, w, "SET ex3 1 PX 100", "+OK\r\n")
	settle(150)
	exec_ping_wire(t, a, "*-1\r\n")
	expect_wire(t, w, "SET fk 1", "+OK\r\n")
	expect_wire(t, a, "WATCH fk", "+OK\r\n")
	expect_wire(t, w, "FLUSHDB", "+OK\r\n")
	exec_ping_wire(t, a, "*-1\r\n")
	expect_wire(t, a, "WATCH fk", "+OK\r\n")
	expect_wire(t, w, "FLUSHDB", "+OK\r\n")
	exec_ping_wire(t, a, "*1\r\n+PONG\r\n")
	expect_wire(t, w, "SET fk 1", "+OK\r\n")
	expect_wire(t, a, "WATCH fk", "+OK\r\n")
	expect_wire(t, w, "FLUSHALL", "+OK\r\n")
	exec_ping_wire(t, a, "*-1\r\n")
	expect_wire(t, w, "SET sk 1", "+OK\r\n")
	expect_wire(t, a, "WATCH sk", "+OK\r\n")
	expect_wire(t, w, "SWAPDB 0 1", "+OK\r\n")
	exec_ping_wire(t, a, "*-1\r\n")
	expect_wire(t, w, "SWAPDB 0 1", "+OK\r\n")
	expect_wire(t, a, "WATCH nosuch", "+OK\r\n")
	expect_wire(t, w, "SWAPDB 0 1", "+OK\r\n")
	exec_ping_wire(t, a, "*1\r\n+PONG\r\n")
	expect_wire(t, w, "SWAPDB 0 1", "+OK\r\n")
	expect_wire(t, a, "SELECT 3", "+OK\r\n")
	expect_wire(t, a, "WATCH dbk", "+OK\r\n")
	expect_wire(t, w, "SET dbk 1", "+OK\r\n")
	exec_ping_wire(t, a, "*1\r\n+PONG\r\n")
	expect_wire(t, a, "WATCH dbk", "+OK\r\n")
	expect_wire(t, w, "SELECT 3", "+OK\r\n")
	expect_wire(t, w, "SET dbk 1", "+OK\r\n")
	expect_wire(t, w, "SELECT 0", "+OK\r\n")
	exec_ping_wire(t, a, "*-1\r\n")
	expect_wire(t, a, "SELECT 0", "+OK\r\n")
	expect_wire(t, w, "SET ren 1", "+OK\r\n")
	expect_wire(t, a, "WATCH ren ren2", "+OK\r\n")
	expect_wire(t, w, "RENAME ren ren2", "+OK\r\n")
	exec_ping_wire(t, a, "*-1\r\n")
	expect_wire(t, w, "SET ro 1", "+OK\r\n")
	expect_wire(t, a, "WATCH ro", "+OK\r\n")
	expect_wire(t, w, "GET ro", "$1\r\n1\r\n")
	expect_wire(t, w, "EXPIRE ro 1000", ":1\r\n")
	exec_ping_wire(t, a, "*-1\r\n")
	expect_wire(t, a, "WATCH ro", "+OK\r\n")
	expect_wire(t, w, "SET ro 1", "+OK\r\n")
	exec_ping_wire(t, a, "*-1\r\n")
}

@(test)
transcript_introspection_dirty_and_oom :: proc(t: ^testing.T) {
	context.allocator = boot()
	a := open_client()
	w := open_client()
	defer close_client(w)
	expect_wire(t, w, "FLUSHALL", "+OK\r\n")
	expect_wire(t, a, "WATCH i1 i2", "+OK\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "PING", "+QUEUED\r\n")
	expect_wire(t, a, "PING", "+QUEUED\r\n")
	testing.expect_value(t, info_field(w, "clients", "watching_clients"), "1")
	testing.expect_value(t, info_field(w, "clients", "total_watched_keys"), "2")
	listing := wire(w, "CLIENT", "LIST")
	mine := client_list_line(listing, a.c.id)
	testing.expect(t, strings.contains(mine, " multi=2 watch=2 "), mine)
	testing.expect_value(t, client_field(mine, "multi-mem"), "24")
	testing.expect_value(t, client_field(mine, "cmd"), "ping")
	theirs := client_list_line(listing, w.c.id)
	testing.expect(t, strings.contains(theirs, " multi=-1 watch=0 "), theirs)
	testing.expect_value(t, client_field(theirs, "multi-mem"), "0")
	testing.expect_value(t, client_field(theirs, "cmd"), "client|list")
	expect_wire(t, a, "RESET", "+RESET\r\n")
	expect_wire(t, a, "EXEC", "-ERR EXEC without MULTI\r\n")
	testing.expect_value(t, info_field(w, "clients", "watching_clients"), "0")
	testing.expect_value(t, info_field(w, "clients", "total_watched_keys"), "0")
	expect_wire(t, a, "WATCH i1", "+OK\r\n")
	close_client(a)
	testing.expect_value(t, info_field(w, "clients", "watching_clients"), "0")
	testing.expect_value(t, info_field(w, "clients", "total_watched_keys"), "0")
	a = open_client()
	defer close_client(a)
	d0 := rdb_changes(w)
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "SET d1 1", "+QUEUED\r\n")
	expect_wire(t, a, "SET d2 2", "+QUEUED\r\n")
	expect_wire(t, a, "GET d1", "+QUEUED\r\n")
	expect_wire(t, a, "INCR d1", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", "*4\r\n+OK\r\n+OK\r\n$1\r\n1\r\n:2\r\n")
	testing.expect_value(t, rdb_changes(w) - d0, 3)
	d0 = rdb_changes(w)
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "GET d1", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", "*1\r\n$1\r\n2\r\n")
	testing.expect_value(t, rdb_changes(w) - d0, 0)
	d0 = rdb_changes(w)
	expect_wire(t, a, "WATCH d1", "+OK\r\n")
	expect_wire(t, w, "SET d1 x", "+OK\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "SET d3 1", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", "*-1\r\n")
	testing.expect_value(t, rdb_changes(w) - d0 - 1, 0)
	expect_wire(t, w, "CONFIG SET maxmemory 1", "+OK\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "SET oom 1", OOM_REPLY)
	expect_wire(t, a, "GET oom", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", EXECABORT_PREVIOUS)
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "GET oom", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", "*1\r\n$-1\r\n")
	expect_wire(t, a, "SET oom2 1", OOM_REPLY)
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "SET oom 1", OOM_REPLY)
	expect_wire(t, w, "CONFIG SET maxmemory 0", "+OK\r\n")
	expect_wire(t, a, "EXEC", EXECABORT_PREVIOUS)
	expect_wire(t, w, "CONFIG SET maxmemory 1", "+OK\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "GET oom", "+QUEUED\r\n")
	expect_wire(t, w, "CONFIG SET maxmemory 0", "+OK\r\n")
	expect_wire(t, a, "EXEC", "*1\r\n$-1\r\n")
}

@(test)
transcript_subscribe_monitor_and_misc :: proc(t: ^testing.T) {
	context.allocator = boot()
	a := open_client()
	defer close_client(a)
	saved_debug := j.cfg.enable_debug_command
	j.cfg.enable_debug_command = 1
	defer j.cfg.enable_debug_command = saved_debug
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "SUBSCRIBE ch", "+QUEUED\r\n")
	expect_wire(t, a, "PING", "+QUEUED\r\n")
	expect_wire(t, a, "UNSUBSCRIBE", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", "*3\r\n*3\r\n$9\r\nsubscribe\r\n$2\r\nch\r\n:1\r\n*2\r\n$4\r\npong\r\n$0\r\n\r\n*3\r\n$11\r\nunsubscribe\r\n$2\r\nch\r\n:0\r\n")
	expect_wire(t, a, "PING", "+PONG\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "MONITOR", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", "*1\r\n-ERR MONITOR isn't allowed for DENY BLOCKING client\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "AUTH x", "+QUEUED\r\n")
	expect_wire(t, a, "HELLO 3", "+QUEUED\r\n")
	got := wire(a, "EXEC")
	head := "*2\r\n-ERR AUTH <password> called without any password configured for the default user. Are you sure your configuration is correct?\r\n%7\r\n$6\r\nserver\r\n"
	testing.expect(t, strings.has_prefix(got, head), got)
	testing.expect(t, strings.contains(got, "$5\r\nproto\r\n:3\r\n"), got)
	hello := wire(a, "HELLO", "2")
	testing.expect(t, strings.has_prefix(hello, "*14\r\n$6\r\nserver\r\n"), hello)
	testing.expect(t, strings.contains(hello, "$5\r\nproto\r\n:2\r\n"), hello)
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "SHUTDOWN ABORT", "-ERR Command not allowed inside a transaction\r\n")
	expect_wire(t, a, "DEBUG SLEEP 0", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", EXECABORT_PREVIOUS)
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "FLUSHALL ASYNC", "+QUEUED\r\n")
	expect_wire(t, a, "EXEC", "*1\r\n+OK\r\n")
	expect_wire(t, a, "MULTI", "+OK\r\n")
	expect_wire(t, a, "QUIT", "+OK\r\n")
	testing.expect(t, !client_alive(a))
}
