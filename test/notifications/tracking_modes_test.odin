package notifications

import "base:runtime"
import "core:fmt"
import "core:strings"
import "core:testing"
import m "../../src"

@(test)
test_tracking_default_mode :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	tc := client_open(3)
	w := client_open()
	expect_bytes(t, run(tc, "CLIENT TRACKING ON"), "+OK\r\n")
	testing.expect_value(t, m.tracking_clients, 1)
	testing.expect_value(t, m.tracking_on, true)
	testing.expect_value(t, m.key_hooks, true)
	testing.expect_value(t, m.cmd_hooks, true)
	expect_bytes(t, run(tc, "GET dm:k1"), "_\r\n")
	expect_bytes(t, run(tc, "MGET dm:k2 dm:k3"), "*2\r\n_\r\n_\r\n")
	expect_bytes(t, stats(), "tracking_total_keys:3\r\ntracking_total_items:3\r\ntracking_total_prefixes:0\r\n")
	expect_bytes(t, run(tc, "GET dm:k1"), "_\r\n")
	expect_bytes(t, stats(), "tracking_total_keys:3\r\ntracking_total_items:3\r\ntracking_total_prefixes:0\r\n")
	expect_bytes(t, run(w, "SET dm:k1 v"), "+OK\r\n")
	expect_bytes(t, take(tc), push_inv("dm:k1"))
	expect_bytes(t, run(w, "SET dm:k1 v2"), "+OK\r\n")
	expect_bytes(t, take(tc), "")
	expect_bytes(t, run(tc, "GET dm:k1"), "$2\r\nv2\r\n")
	expect_bytes(t, run(w, "DEL dm:k1"), ":1\r\n")
	expect_bytes(t, take(tc), push_inv("dm:k1"))
	expect_bytes(t, run(w, "MSET dm:k2 a dm:k3 b"), "+OK\r\n")
	expect_bytes(t, take(tc), strings.concatenate({push_inv("dm:k2"), push_inv("dm:k3")}, context.temp_allocator))
	expect_bytes(t, run(tc, "SET dm:own 1"), "+OK\r\n")
	expect_bytes(t, run(tc, "GET dm:own"), "$1\r\n1\r\n")
	expect_bytes(t, run(tc, "SET dm:own 2"), strings.concatenate({"+OK\r\n", push_inv("dm:own")}, context.temp_allocator))
	expect_bytes(t, stats(), "tracking_total_keys:0\r\ntracking_total_items:0\r\ntracking_total_prefixes:0\r\n")
	other := client_open(3)
	expect_bytes(t, run(other, "CLIENT TRACKING ON"), "+OK\r\n")
	expect_bytes(t, run(tc, "GET dm:shared"), "_\r\n")
	expect_bytes(t, run(other, "GET dm:shared"), "_\r\n")
	expect_bytes(t, stats(), "tracking_total_keys:1\r\ntracking_total_items:2\r\ntracking_total_prefixes:0\r\n")
	expect_bytes(t, run(w, "SET dm:shared 1"), "+OK\r\n")
	expect_bytes(t, take(tc), push_inv("dm:shared"))
	expect_bytes(t, take(other), push_inv("dm:shared"))
	expect_bytes(t, run(tc, "HGET dm:h f"), "_\r\n")
	expect_bytes(t, run(tc, "SET dm:written 1"), "+OK\r\n")
	expect_bytes(t, stats(), "tracking_total_keys:1\r\ntracking_total_items:1\r\ntracking_total_prefixes:0\r\n")
	expect_bytes(t, run(w, "HSET dm:h f v"), ":1\r\n")
	expect_bytes(t, take(tc), push_inv("dm:h"))
	r2 := client_open()
	expect_bytes(t, run(r2, "CLIENT TRACKING ON"), "+OK\r\n")
	expect_bytes(t, run(r2, "GET dm:resp2"), "$-1\r\n")
	expect_bytes(t, stats(), "tracking_total_keys:1\r\ntracking_total_items:1\r\ntracking_total_prefixes:0\r\n")
	expect_bytes(t, run(w, "SET dm:resp2 1"), "+OK\r\n")
	expect_bytes(t, take(r2), "")
	expect_bytes(t, stats(), "tracking_total_keys:0\r\ntracking_total_items:0\r\ntracking_total_prefixes:0\r\n")
	client_close(r2)
	client_close(other)
	client_close(tc)
	client_close(w)
	env_check_clean(t)
}

@(test)
test_tracking_noloop :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	tc := client_open(3)
	w := client_open()
	expect_bytes(t, run(tc, "CLIENT TRACKING ON NOLOOP"), "+OK\r\n")
	expect_bytes(t, run(tc, "GET nl:own"), "_\r\n")
	expect_bytes(t, run(tc, "SET nl:own 3"), "+OK\r\n")
	expect_bytes(t, stats(), "tracking_total_keys:0\r\ntracking_total_items:0\r\ntracking_total_prefixes:0\r\n")
	expect_bytes(t, run(w, "SET nl:own 4"), "+OK\r\n")
	expect_bytes(t, take(tc), "")
	expect_bytes(t, run(tc, "GET nl:other"), "_\r\n")
	expect_bytes(t, run(w, "SET nl:other 1"), "+OK\r\n")
	expect_bytes(t, take(tc), push_inv("nl:other"))
	expect_bytes(t, run(tc, "GET nl:exp"), "_\r\n")
	m.signal_key_expired(transmute([]u8)string("nl:exp"), &m.dbs[0])
	expect_bytes(t, take(tc), push_inv("nl:exp"))
	expect_bytes(t, run(tc, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "noloop"}, 0, {}))
	client_close(tc)
	client_close(w)
	env_check_clean(t)
}

@(test)
test_tracking_optin_optout :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	tc := client_open(3)
	w := client_open()
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTIN"), "+OK\r\n")
	expect_bytes(t, run(tc, "GET oi"), "_\r\n")
	expect_bytes(t, run(w, "SET oi 1"), "+OK\r\n")
	expect_bytes(t, take(tc), "")
	expect_bytes(t, run(tc, "CLIENT CACHING YES"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "optin", "caching-yes"}, 0, {}))
	expect_bytes(t, run(tc, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "optin", "caching-yes"}, 0, {}))
	expect_bytes(t, run(tc, "CLIENT CACHING YES"), "+OK\r\n")
	expect_bytes(t, run(tc, "GET oi"), "$1\r\n1\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "optin"}, 0, {}))
	expect_bytes(t, run(w, "SET oi 2"), "+OK\r\n")
	expect_bytes(t, take(tc), push_inv("oi"))
	expect_bytes(t, run(tc, "CLIENT CACHING NO"), err_line(m.ERR_TRK_CACHING_NO))
	expect_bytes(t, run(tc, "CLIENT CACHING YES"), "+OK\r\n")
	expect_bytes(t, run(tc, "PING"), "+PONG\r\n")
	expect_bytes(t, run(tc, "GET oi"), "$1\r\n2\r\n")
	expect_bytes(t, run(w, "SET oi 3"), "+OK\r\n")
	expect_bytes(t, take(tc), "")
	expect_bytes(t, run(tc, "CLIENT CACHING maybe"), err_line(m.ERR_SYNTAX))
	expect_bytes(t, run(tc, "CLIENT TRACKING OFF"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTOUT"), "+OK\r\n")
	expect_bytes(t, run(tc, "GET oo"), "_\r\n")
	expect_bytes(t, run(w, "SET oo 1"), "+OK\r\n")
	expect_bytes(t, take(tc), push_inv("oo"))
	expect_bytes(t, run(tc, "CLIENT CACHING NO"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "optout", "caching-no"}, 0, {}))
	expect_bytes(t, run(tc, "CLIENT CACHING NO"), "+OK\r\n")
	expect_bytes(t, run(tc, "GET oo"), "$1\r\n1\r\n")
	expect_bytes(t, run(w, "SET oo 2"), "+OK\r\n")
	expect_bytes(t, take(tc), "")
	expect_bytes(t, run(tc, "GET oo"), "$1\r\n2\r\n")
	expect_bytes(t, run(w, "SET oo 3"), "+OK\r\n")
	expect_bytes(t, take(tc), push_inv("oo"))
	expect_bytes(t, run(tc, "CLIENT CACHING YES"), err_line(m.ERR_TRK_CACHING_YES))
	client_close(tc)
	client_close(w)
	env_check_clean(t)
}

@(test)
test_caching_flag_lifetime :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	tc := client_open(3)
	w := client_open()
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTIN"), "+OK\r\n")
	Case :: struct {
		between: []string,
		tracked: bool,
	}
	cases := [?]Case {
		{{"CLIENT TRACKINGINFO"}, true},
		{{"CLIENT ID"}, true},
		{{"CLIENT GETNAME"}, true},
		{{"CLIENT CACHING YES"}, true},
		{{"CLIENT GETREDIR", "CLIENT ID"}, true},
		{{"PING"}, false},
		{{"ECHO x"}, false},
		{{"SET cf:other 1"}, false},
	}
	for cs, i in cases {
		key := fmt.tprintf("cf:k%d", i)
		expect_bytes(t, run(tc, "CLIENT CACHING YES"), "+OK\r\n")
		for line in cs.between {
			run(tc, line)
		}
		expect_bytes(t, run(tc, fmt.tprintf("GET %s", key)), "_\r\n")
		expect_bytes(t, run(w, fmt.tprintf("SET %s 1", key)), "+OK\r\n")
		expect_bytes(t, take(tc), push_inv(key) if cs.tracked else "")
	}
	expect_bytes(t, run(tc, "CLIENT CACHING YES"), "+OK\r\n")
	expect_bytes(t, run(tc, "MULTI"), "+OK\r\n")
	expect_bytes(t, run(tc, "GET cf:m"), "+QUEUED\r\n")
	expect_bytes(t, run(tc, "EXEC"), "*1\r\n_\r\n")
	expect_bytes(t, run(w, "SET cf:m 1"), "+OK\r\n")
	expect_bytes(t, take(tc), push_inv("cf:m"))
	expect_bytes(t, run(tc, "GET cf:m"), "$1\r\n1\r\n")
	expect_bytes(t, run(w, "SET cf:m 2"), "+OK\r\n")
	expect_bytes(t, take(tc), "")
	expect_bytes(t, run(tc, "CLIENT TRACKING OFF"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTOUT"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT CACHING NO"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT ID"), fmt.tprintf(":%d\r\n", tc.c.id))
	expect_bytes(t, run(tc, "GET cf:o1"), "_\r\n")
	expect_bytes(t, run(w, "SET cf:o1 1"), "+OK\r\n")
	expect_bytes(t, take(tc), "")
	expect_bytes(t, run(tc, "CLIENT CACHING NO"), "+OK\r\n")
	expect_bytes(t, run(tc, "PING"), "+PONG\r\n")
	expect_bytes(t, run(tc, "GET cf:o2"), "_\r\n")
	expect_bytes(t, run(w, "SET cf:o2 1"), "+OK\r\n")
	expect_bytes(t, take(tc), push_inv("cf:o2"))
	client_close(tc)
	client_close(w)
	env_check_clean(t)
}

@(test)
test_tracking_option_errors :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	tc := client_open(3)
	w := client_open()
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTOUT"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTIN"), "-ERR You can't switch OPTIN/OPTOUT mode before disabling tracking for this client, and then re-enabling it with a different mode.\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON BCAST"), "-ERR You can't switch BCAST mode on/off before disabling tracking for this client, and then re-enabling it with a different mode.\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTIN OPTOUT"), "-ERR You can't specify both OPTIN mode and OPTOUT mode\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON PREFIX a"), "-ERR PREFIX option requires BCAST mode to be enabled\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON BCAST OPTIN"), "-ERR You can't switch BCAST mode on/off before disabling tracking for this client, and then re-enabling it with a different mode.\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON REDIRECT 999999"), "-ERR The client ID you want redirect to does not exist\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON REDIRECT x"), "-ERR value is not an integer or out of range\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON BOGUS"), "-ERR syntax error\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING MAYBE"), "-ERR syntax error\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING"), "-ERR wrong number of arguments for 'client|tracking' command\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "optout"}, 0, {}))
	expect_bytes(t, run(tc, "CLIENT GETREDIR"), ":0\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTOUT"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING OFF"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"off"}, -1, {}))
	expect_bytes(t, run(tc, "CLIENT CACHING YES"), "-ERR CLIENT CACHING can be called only when the client is in tracking mode with OPTIN or OPTOUT mode enabled\r\n")
	expect_bytes(t, run(tc, "CLIENT GETREDIR"), ":-1\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON BCAST OPTIN"), "-ERR OPTIN and OPTOUT are not compatible with BCAST\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTOUT BCAST"), "-ERR OPTIN and OPTOUT are not compatible with BCAST\r\n")
	expect_bytes(t, run(tc, fmt.tprintf("CLIENT TRACKING ON REDIRECT %d REDIRECT %d", w.c.id, w.c.id)), "-ERR A client can only redirect to a single other client\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON REDIRECT"), "-ERR syntax error\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON BCAST PREFIX"), "-ERR syntax error\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING OFF BOGUS"), "-ERR syntax error\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON REDIRECT 0"), "-ERR The client ID you want redirect to does not exist\r\n")
	testing.expect_value(t, m.tracking_clients, 0)
	expect_bytes(t, run(tc, "client tracking on optin noloop"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "optin", "noloop"}, 0, {}))
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTIN"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "optin"}, 0, {}))
	expect_bytes(t, run(tc, "CLIENT TRACKING OFF"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING OFF"), "+OK\r\n")
	client_close(tc)
	client_close(w)
	env_check_clean(t)
}

@(test)
test_tracking_mode_retention :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	tc := client_open(3)
	w := client_open()
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTIN"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "optin"}, 0, {}))
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTIN"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "optin"}, 0, {}))
	expect_bytes(t, run(tc, "CLIENT TRACKING ON NOLOOP"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "optin", "noloop"}, 0, {}))
	testing.expect_value(t, m.tracking_clients, 1)
	expect_bytes(t, run(tc, "GET mr:k1"), "_\r\n")
	expect_bytes(t, run(w, "SET mr:k1 1"), "+OK\r\n")
	expect_bytes(t, take(tc), "")
	expect_bytes(t, run(tc, "CLIENT CACHING YES"), "+OK\r\n")
	expect_bytes(t, run(tc, "GET mr:k1"), "$1\r\n1\r\n")
	expect_bytes(t, run(w, "SET mr:k1 2"), "+OK\r\n")
	expect_bytes(t, take(tc), push_inv("mr:k1"))
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTOUT"), err_line(m.ERR_TRK_SWITCH_OPT))
	expect_bytes(t, run(tc, "CLIENT TRACKING ON BCAST"), err_line(m.ERR_TRK_SWITCH_BCAST))
	expect_bytes(t, run(tc, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "optin", "noloop"}, 0, {}))
	expect_bytes(t, run(tc, "CLIENT TRACKING OFF"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTOUT"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTOUT"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "optout"}, 0, {}))
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTIN"), err_line(m.ERR_TRK_SWITCH_OPT))
	expect_bytes(t, run(tc, "CLIENT CACHING NO"), "+OK\r\n")
	expect_bytes(t, run(tc, "GET mr:k2"), "_\r\n")
	expect_bytes(t, run(w, "SET mr:k2 1"), "+OK\r\n")
	expect_bytes(t, take(tc), "")
	expect_bytes(t, run(tc, "GET mr:k3"), "_\r\n")
	expect_bytes(t, run(w, "SET mr:k3 1"), "+OK\r\n")
	expect_bytes(t, take(tc), push_inv("mr:k3"))
	expect_bytes(t, run(tc, "CLIENT TRACKING OFF"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON BCAST"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON BCAST"), "+OK\r\n")
	expect_bytes(t, run(tc, "CLIENT TRACKING ON"), err_line(m.ERR_TRK_SWITCH_BCAST))
	expect_bytes(t, run(tc, "CLIENT TRACKING ON OPTIN"), err_line(m.ERR_TRK_SWITCH_BCAST))
	expect_bytes(t, run(tc, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "bcast"}, 0, {""}))
	client_close(tc)
	client_close(w)
	env_check_clean(t)
}

@(test)
test_trackinginfo_and_flags :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	a := client_open()
	b := client_open(3)
	expect_bytes(t, run(a, "CLIENT TRACKINGINFO"), "*6\r\n$5\r\nflags\r\n*1\r\n$3\r\noff\r\n$8\r\nredirect\r\n:-1\r\n$8\r\nprefixes\r\n*0\r\n")
	expect_bytes(t, run(b, "CLIENT TRACKINGINFO"), "%3\r\n$5\r\nflags\r\n~1\r\n$3\r\noff\r\n$8\r\nredirect\r\n:-1\r\n$8\r\nprefixes\r\n*0\r\n")
	expect_bytes(t, run(a, fmt.tprintf("CLIENT TRACKING ON REDIRECT %d", b.c.id)), "+OK\r\n")
	expect_bytes(t, run(a, "CLIENT TRACKINGINFO"), trackinginfo_reply(false, {"on"}, b.c.id, {}))
	expect_bytes(t, run(a, "CLIENT GETREDIR"), fmt.tprintf(":%d\r\n", b.c.id))
	testing.expect_value(t, m.tracking_redirect_of(a.c), b.c.id)
	testing.expect_value(t, m.tracking_redirect_of(b.c), -1)
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST NOLOOP PREFIX p:"), "+OK\r\n")
	expect_bytes(t, run(b, "CLIENT TRACKINGINFO"), "%3\r\n$5\r\nflags\r\n~3\r\n$2\r\non\r\n$5\r\nbcast\r\n$6\r\nnoloop\r\n$8\r\nredirect\r\n:0\r\n$8\r\nprefixes\r\n*1\r\n$2\r\np:\r\n")
	flags: [dynamic]u8
	defer delete(flags)
	m.tracking_client_flags(&flags, b.c)
	expect_bytes(t, string(flags[:]), "tB")
	clear(&flags)
	m.tracking_client_flags(&flags, a.c)
	expect_bytes(t, string(flags[:]), "t")
	nobody := client_open()
	clear(&flags)
	m.tracking_client_flags(&flags, nobody.c)
	expect_bytes(t, string(flags[:]), "")
	list := run(nobody, "CLIENT LIST")
	testing.expect_value(t, list_field(list, a.c.id, "flags"), "t")
	testing.expect_value(t, list_field(list, b.c.id, "flags"), "tB")
	testing.expect_value(t, list_field(list, nobody.c.id, "flags"), "N")
	testing.expect_value(t, list_field(list, a.c.id, "redir"), fmt.tprintf("%d", b.c.id))
	testing.expect_value(t, list_field(list, b.c.id, "redir"), "0")
	testing.expect_value(t, list_field(list, nobody.c.id, "redir"), "-1")
	broken_id := b.c.id
	client_close(b)
	clear(&flags)
	m.tracking_client_flags(&flags, a.c)
	expect_bytes(t, string(flags[:]), "t")
	expect_bytes(t, run(a, "GET tf:k"), "$-1\r\n")
	expect_bytes(t, run(nobody, "SET tf:k 1"), "+OK\r\n")
	clear(&flags)
	m.tracking_client_flags(&flags, a.c)
	expect_bytes(t, string(flags[:]), "tR")
	expect_bytes(t, run(a, "CLIENT TRACKINGINFO"), trackinginfo_reply(false, {"on", "broken_redirect"}, broken_id, {}))
	client_close(a)
	client_close(nobody)
	env_check_clean(t)
}
