package notifications

import "base:runtime"
import "core:fmt"
import "core:strings"
import "core:testing"
import "core:time"
import m "../../src"

OVERLAP_TAIL :: "'. Prefixes for a single client must not overlap.\r\n"

@(test)
test_bcast_prefixes_transcript :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	b := client_open(3)
	w := client_open()
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX user: PREFIX cart:"), "+OK\r\n")
	expect_bytes(t, run(b, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "bcast"}, 0, {"cart:", "user:"}))
	expect_bytes(t, run(w, "SET user:1 x"), "+OK\r\n")
	sleep_cycle()
	expect_bytes(t, run(w, "SET other y"), "+OK\r\n")
	sleep_cycle()
	expect_bytes(t, run(w, "MSET cart:1 a user:2 b"), "+OK\r\n")
	sleep_cycle()
	expect_bytes(t, take(b), strings.concatenate({push_inv("user:1"), push_inv("cart:1"), push_inv("user:2")}, context.temp_allocator))
	expect_bytes(t, run(b, "SET user:9 self"), "+OK\r\n")
	sleep_cycle()
	expect_bytes(t, take(b), push_inv("user:9"))
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX use"), strings.concatenate({"-ERR Prefix 'use' overlaps with an existing prefix 'user:", OVERLAP_TAIL}, context.temp_allocator))
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX user:12"), strings.concatenate({"-ERR Prefix 'user:12' overlaps with an existing prefix 'user:", OVERLAP_TAIL}, context.temp_allocator))
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX zzz"), "+OK\r\n")
	expect_bytes(t, run(b, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "bcast"}, 0, {"cart:", "user:", "zzz"}))
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX a PREFIX ab"), strings.concatenate({"-ERR Prefix 'a' overlaps with another provided prefix 'ab", OVERLAP_TAIL}, context.temp_allocator))
	expect_bytes(t, run(b, "CLIENT TRACKING ON OPTIN"), err_line(m.ERR_TRK_SWITCH_BCAST))
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST NOLOOP"), "+OK\r\n")
	expect_bytes(t, run(b, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "bcast", "noloop"}, 0, {"", "cart:", "user:", "zzz"}))
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST"), "+OK\r\n")
	expect_bytes(t, run(b, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "bcast"}, 0, {"", "cart:", "user:", "zzz"}))
	expect_bytes(t, run(w, "SET any 1"), "+OK\r\n")
	sleep_cycle()
	expect_bytes(t, take(b), push_inv("any"))
	b2 := client_open(3)
	expect_bytes(t, run(b2, "CLIENT TRACKING ON BCAST PREFIX user:"), "+OK\r\n")
	expect_bytes(t, run(w, "SET user:3 x"), "+OK\r\n")
	sleep_cycle()
	expect_bytes(t, take(b), strings.concatenate({push_inv("user:3"), push_inv("user:3")}, context.temp_allocator))
	expect_bytes(t, take(b2), push_inv("user:3"))
	expect_bytes(t, stats(), "tracking_total_keys:0\r\ntracking_total_items:0\r\ntracking_total_prefixes:4\r\n")
	testing.expect_value(t, info_line(run(w, "INFO clients"), "tracking_clients:"), "tracking_clients:2")
	expect_bytes(t, run(b, "GET user:1"), "$1\r\nx\r\n")
	expect_bytes(t, stats(), "tracking_total_keys:0\r\ntracking_total_items:0\r\ntracking_total_prefixes:4\r\n")
	expect_bytes(t, run(b, "CLIENT TRACKING OFF"), "+OK\r\n")
	expect_bytes(t, stats(), "tracking_total_keys:0\r\ntracking_total_items:0\r\ntracking_total_prefixes:1\r\n")
	expect_bytes(t, run(b2, "CLIENT TRACKING OFF"), "+OK\r\n")
	expect_bytes(t, stats(), "tracking_total_keys:0\r\ntracking_total_items:0\r\ntracking_total_prefixes:0\r\n")
	expect_bytes(t, run(w, "SET user:4 x"), "+OK\r\n")
	sleep_cycle()
	expect_bytes(t, take(b), "")
	expect_bytes(t, take(b2), "")
	client_close(b2)
	client_close(b)
	client_close(w)
	env_check_clean(t)
}

@(test)
test_bcast_batching_and_noloop :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	b := client_open(3)
	c := client_open(3)
	w := client_open()
	s := client_open()
	r := client_open()
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX bt:"), "+OK\r\n")
	expect_bytes(t, run(c, "CLIENT TRACKING ON BCAST NOLOOP PREFIX bt:"), "+OK\r\n")
	expect_bytes(t, run(s, "SUBSCRIBE __redis__:invalidate"), "*3\r\n$9\r\nsubscribe\r\n$20\r\n__redis__:invalidate\r\n:1\r\n")
	expect_bytes(t, run(r, fmt.tprintf("CLIENT TRACKING ON BCAST PREFIX bt: REDIRECT %d", s.c.id)), "+OK\r\n")
	expect_bytes(t, run(w, "SET bt:1 a"), "+OK\r\n")
	expect_bytes(t, run(w, "SET bt:2 a"), "+OK\r\n")
	expect_bytes(t, run(w, "SET bt:1 b"), "+OK\r\n")
	expect_bytes(t, run(c, "SET bt:3 a"), "+OK\r\n")
	expect_bytes(t, run(b, "SET bt:4 a"), "+OK\r\n")
	expect_bytes(t, run(c, "SET bt:4 b"), "+OK\r\n")
	expect_bytes(t, run(c, "SET bt:5 a"), "+OK\r\n")
	expect_bytes(t, run(c, "SET bt:5 b"), "+OK\r\n")
	expect_bytes(t, run(c, "SET bt:8 a"), "+OK\r\n")
	expect_bytes(t, run(w, "SET bt:8 b"), "+OK\r\n")
	expect_bytes(t, run(w, "SET other:1 a"), "+OK\r\n")
	expect_bytes(t, take(b), "")
	sleep_cycle()
	expect_bytes(t, take(b), push_inv("bt:1", "bt:2", "bt:3", "bt:4", "bt:5", "bt:8"))
	expect_bytes(t, take(c), push_inv("bt:1", "bt:2", "bt:8"))
	expect_bytes(t, take(s), msg_inv("bt:1", "bt:2", "bt:3", "bt:4", "bt:5", "bt:8"))
	expect_bytes(t, take(r), "")
	sleep_cycle()
	expect_bytes(t, take(b), "")
	expect_bytes(t, take(c), "")
	expect_bytes(t, run(w, "MSET bt:z 1 bt:a 2 bt:m 3 bt: 4"), "+OK\r\n")
	sleep_cycle()
	expect_bytes(t, take(b), push_inv("bt:", "bt:a", "bt:m", "bt:z"))
	expect_bytes(t, take(c), push_inv("bt:", "bt:a", "bt:m", "bt:z"))
	expect_bytes(t, take(s), msg_inv("bt:", "bt:a", "bt:m", "bt:z"))
	expect_bytes(t, run(w, "MSET bt:9 1 bt:10 2 bt:1 3"), "+OK\r\n")
	expect_bytes(t, run(c, "SET bt:0 x"), "+OK\r\n")
	sleep_cycle()
	expect_bytes(t, take(b), push_inv("bt:0", "bt:1", "bt:10", "bt:9"))
	expect_bytes(t, take(c), push_inv("bt:1", "bt:10", "bt:9"))
	expect_bytes(t, take(s), msg_inv("bt:0", "bt:1", "bt:10", "bt:9"))
	expect_bytes(t, run(c, "SET bt:6 a"), "+OK\r\n")
	sleep_cycle()
	expect_bytes(t, take(c), "")
	expect_bytes(t, take(b), push_inv("bt:6"))
	expect_bytes(t, take(s), msg_inv("bt:6"))
	m.signal_key_expired(transmute([]u8)string("bt:7"), &m.dbs[0])
	sleep_cycle()
	expect_bytes(t, take(c), push_inv("bt:7"))
	expect_bytes(t, take(b), push_inv("bt:7"))
	expect_bytes(t, take(s), msg_inv("bt:7"))
	client_close(r)
	client_close(s)
	client_close(w)
	client_close(c)
	client_close(b)
	env_check_clean(t)
}

@(test)
test_prefix_overlap_rules :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	b := client_open(3)
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX FOOBAR PREFIX FOO"), strings.concatenate({"-ERR Prefix 'FOOBAR' overlaps with another provided prefix 'FOO", OVERLAP_TAIL}, context.temp_allocator))
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX FOO PREFIX FOOBAR"), strings.concatenate({"-ERR Prefix 'FOO' overlaps with another provided prefix 'FOOBAR", OVERLAP_TAIL}, context.temp_allocator))
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX X PREFIX Y PREFIX X"), strings.concatenate({"-ERR Prefix 'X' overlaps with another provided prefix 'X", OVERLAP_TAIL}, context.temp_allocator))
	testing.expect_value(t, m.tracking_clients, 0)
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX FOO PREFIX BAR"), "+OK\r\n")
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX FO"), strings.concatenate({"-ERR Prefix 'FO' overlaps with an existing prefix 'FOO", OVERLAP_TAIL}, context.temp_allocator))
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX BARB"), strings.concatenate({"-ERR Prefix 'BARB' overlaps with an existing prefix 'BAR", OVERLAP_TAIL}, context.temp_allocator))
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX ZED PREFIX BARB"), strings.concatenate({"-ERR Prefix 'BARB' overlaps with an existing prefix 'BAR", OVERLAP_TAIL}, context.temp_allocator))
	expect_bytes(t, run(b, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "bcast"}, 0, {"BAR", "FOO"}))
	raw := [][]u8{transmute([]u8)string("CLIENT"), transmute([]u8)string("TRACKING"), transmute([]u8)string("ON"), transmute([]u8)string("BCAST"), transmute([]u8)string("PREFIX"), transmute([]u8)string("FOO\r\nX")}
	expect_bytes(t, run_argv(b, raw), strings.concatenate({"-ERR Prefix 'FOO  X' overlaps with an existing prefix 'FOO", OVERLAP_TAIL}, context.temp_allocator))
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST"), "+OK\r\n")
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX QQ"), strings.concatenate({"-ERR Prefix 'QQ' overlaps with an existing prefix '", OVERLAP_TAIL}, context.temp_allocator))
	expect_bytes(t, run(b, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "bcast"}, 0, {"", "BAR", "FOO"}))
	expect_bytes(t, run(b, "CLIENT TRACKING OFF"), "+OK\r\n")
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX FO"), "+OK\r\n")
	expect_bytes(t, run(b, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "bcast"}, 0, {"FO"}))
	client_close(b)
	env_check_clean(t)
}

@(test)
test_redirect_resp2_subscriber_and_broken :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	w := client_open()
	s2 := client_open()
	r2 := client_open()
	expect_bytes(t, run(s2, "SUBSCRIBE __redis__:invalidate"), "*3\r\n$9\r\nsubscribe\r\n$20\r\n__redis__:invalidate\r\n:1\r\n")
	s2id := s2.c.id
	expect_bytes(t, run(r2, fmt.tprintf("CLIENT TRACKING ON REDIRECT %d", s2id)), "+OK\r\n")
	expect_bytes(t, run(r2, "CLIENT GETREDIR"), fmt.tprintf(":%d\r\n", s2id))
	expect_bytes(t, run(r2, "GET rd:rk"), "$-1\r\n")
	expect_bytes(t, run(w, "SET rd:rk 1"), "+OK\r\n")
	expect_bytes(t, take(s2), msg_inv("rd:rk"))
	expect_bytes(t, take(r2), "")
	expect_bytes(t, run(r2, "CLIENT TRACKINGINFO"), trackinginfo_reply(false, {"on"}, s2id, {}))
	expect_bytes(t, run(r2, "GET rd:rk"), "$1\r\n1\r\n")
	client_close(s2)
	expect_bytes(t, run(w, "SET rd:rk 2"), "+OK\r\n")
	expect_bytes(t, take(r2), "")
	expect_bytes(t, run(r2, "GET rd:rk2"), "$-1\r\n")
	expect_bytes(t, run(w, "SET rd:rk2 2"), "+OK\r\n")
	expect_bytes(t, take(r2), "")
	expect_bytes(t, run(r2, "CLIENT TRACKINGINFO"), trackinginfo_reply(false, {"on", "broken_redirect"}, s2id, {}))
	expect_bytes(t, run(r2, fmt.tprintf("CLIENT TRACKING ON REDIRECT %d", s2id)), err_line(m.ERR_TRK_REDIRECT_MISSING))
	r3 := client_open(3)
	expect_bytes(t, run(r3, fmt.tprintf("CLIENT TRACKING ON REDIRECT %d", w.c.id)), "+OK\r\n")
	expect_bytes(t, run(r3, "GET rd:rk3"), "_\r\n")
	expect_bytes(t, run(w, "SET rd:rk3 1"), "+OK\r\n")
	expect_bytes(t, take(r3), "")
	expect_bytes(t, take(w), "")
	other := client_open()
	expect_bytes(t, run(other, "SUBSCRIBE some:channel"), "*3\r\n$9\r\nsubscribe\r\n$12\r\nsome:channel\r\n:1\r\n")
	r5 := client_open()
	expect_bytes(t, run(r5, fmt.tprintf("CLIENT TRACKING ON REDIRECT %d", other.c.id)), "+OK\r\n")
	expect_bytes(t, run(r5, "GET rd:rk5"), "$-1\r\n")
	expect_bytes(t, run(w, "SET rd:rk5 1"), "+OK\r\n")
	expect_bytes(t, take(other), msg_inv("rd:rk5"))
	expect_bytes(t, take(r5), "")
	pat := client_open()
	expect_bytes(t, run(pat, "PSUBSCRIBE __redis__:*"), "*3\r\n$10\r\npsubscribe\r\n$11\r\n__redis__:*\r\n:1\r\n")
	r7 := client_open()
	expect_bytes(t, run(r7, fmt.tprintf("CLIENT TRACKING ON REDIRECT %d", pat.c.id)), "+OK\r\n")
	expect_bytes(t, run(r7, "MGET rd:p1 rd:p2"), "*2\r\n$-1\r\n$-1\r\n")
	expect_bytes(t, run(w, "MSET rd:p1 1 rd:p2 2"), "+OK\r\n")
	expect_bytes(t, take(pat), strings.concatenate({msg_inv("rd:p1"), msg_inv("rd:p2")}, context.temp_allocator))
	expect_bytes(t, take(r7), "")
	expect_bytes(t, run(pat, "PUNSUBSCRIBE"), "*3\r\n$12\r\npunsubscribe\r\n$11\r\n__redis__:*\r\n:0\r\n")
	expect_bytes(t, run(r7, "GET rd:p3"), "$-1\r\n")
	expect_bytes(t, run(w, "SET rd:p3 1"), "+OK\r\n")
	expect_bytes(t, take(pat), "")
	client_close(r7)
	client_close(pat)
	expect_bytes(t, stats(), "tracking_total_keys:0\r\ntracking_total_items:0\r\ntracking_total_prefixes:0\r\n")
	testing.expect_value(t, info_line(run(w, "INFO clients"), "tracking_clients:"), "tracking_clients:3")
	client_close(r5)
	client_close(other)
	client_close(r3)
	client_close(r2)
	client_close(w)
	env_check_clean(t)
}

@(test)
test_resp2_subscriber_without_redirect :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	w := client_open()
	plain := client_open()
	expect_bytes(t, run(plain, "CLIENT TRACKING ON"), "+OK\r\n")
	expect_bytes(t, run(plain, "GET ns:k"), "$-1\r\n")
	expect_bytes(t, run(plain, "SUBSCRIBE __redis__:invalidate"), "*3\r\n$9\r\nsubscribe\r\n$20\r\n__redis__:invalidate\r\n:1\r\n")
	expect_bytes(t, run(w, "SET ns:k 1"), "+OK\r\n")
	sleep_cycle()
	expect_bytes(t, take(plain), "")
	bcast := client_open()
	expect_bytes(t, run(bcast, "CLIENT TRACKING ON BCAST PREFIX nb:"), "+OK\r\n")
	expect_bytes(t, run(bcast, "SUBSCRIBE __redis__:invalidate"), "*3\r\n$9\r\nsubscribe\r\n$20\r\n__redis__:invalidate\r\n:1\r\n")
	expect_bytes(t, run(w, "SET nb:k 1"), "+OK\r\n")
	sleep_cycle()
	expect_bytes(t, take(bcast), "")
	looped := client_open()
	expect_bytes(t, run(looped, fmt.tprintf("CLIENT TRACKING ON REDIRECT %d", looped.c.id)), "+OK\r\n")
	expect_bytes(t, run(looped, "GET ns:self"), "$-1\r\n")
	expect_bytes(t, run(looped, "SUBSCRIBE __redis__:invalidate"), "*3\r\n$9\r\nsubscribe\r\n$20\r\n__redis__:invalidate\r\n:1\r\n")
	expect_bytes(t, run(w, "SET ns:self 1"), "+OK\r\n")
	sleep_cycle()
	expect_bytes(t, take(looped), msg_inv("ns:self"))
	client_close(looped)
	client_close(bcast)
	client_close(plain)
	client_close(w)
	env_check_clean(t)
}

@(test)
test_redirect_resp3_targets :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	w := client_open()
	s3 := client_open(3)
	r4 := client_open()
	expect_bytes(t, run(r4, fmt.tprintf("CLIENT TRACKING ON REDIRECT %d", s3.c.id)), "+OK\r\n")
	expect_bytes(t, run(r4, "GET r3:rk4"), "$-1\r\n")
	expect_bytes(t, run(w, "SET r3:rk4 1"), "+OK\r\n")
	expect_bytes(t, take(s3), "")
	sleep_cycle()
	expect_bytes(t, take(s3), push_inv("r3:rk4"))
	expect_bytes(t, take(r4), "")
	r6 := client_open(3)
	expect_bytes(t, run(r6, fmt.tprintf("CLIENT TRACKING ON REDIRECT %d", s3.c.id)), "+OK\r\n")
	expect_bytes(t, run(r6, "GET r3:rk6"), "_\r\n")
	expect_bytes(t, run(r4, "GET r3:rk6"), "$-1\r\n")
	expect_bytes(t, stats(), "tracking_total_keys:1\r\ntracking_total_items:2\r\ntracking_total_prefixes:0\r\n")
	expect_bytes(t, run(w, "SET r3:rk6 1"), "+OK\r\n")
	sleep_cycle()
	expect_bytes(t, take(s3), strings.concatenate({push_inv("r3:rk6"), push_inv("r3:rk6")}, context.temp_allocator))
	s3id := s3.c.id
	client_close(s3)
	expect_bytes(t, run(r6, "GET r3:rk7"), "_\r\n")
	expect_bytes(t, run(r4, "GET r3:rk7"), "$-1\r\n")
	expect_bytes(t, run(w, "SET r3:rk7 1"), "+OK\r\n")
	expect_bytes(t, take(r6), push_broken(s3id))
	expect_bytes(t, take(r4), "")
	expect_bytes(t, run(r6, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on", "broken_redirect"}, s3id, {}))
	expect_bytes(t, run(r6, "GET r3:rk8"), "_\r\n")
	expect_bytes(t, run(r6, "SET r3:rk8 1"), strings.concatenate({"+OK\r\n", push_broken(s3id)}, context.temp_allocator))
	expect_bytes(t, run(r6, "CLIENT TRACKING ON"), "+OK\r\n")
	expect_bytes(t, run(r6, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on"}, 0, {}))
	expect_bytes(t, run(r6, "GET r3:rk9"), "_\r\n")
	expect_bytes(t, run(w, "SET r3:rk9 1"), "+OK\r\n")
	expect_bytes(t, take(r6), push_inv("r3:rk9"))
	client_close(r6)
	client_close(r4)
	client_close(w)
	env_check_clean(t)
}

@(test)
test_deferred_delivery_to_executing_target :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	tgt := client_open(3)
	r := client_open()
	w := client_open()
	expect_bytes(t, run(r, fmt.tprintf("CLIENT TRACKING ON REDIRECT %d", tgt.c.id)), "+OK\r\n")
	expect_bytes(t, run(r, "MGET df:a df:b"), "*2\r\n$-1\r\n$-1\r\n")
	expect_bytes(t, run(tgt, "MSET df:a 1 df:b 2"), "+OK\r\n")
	testing.expect_value(t, m.tracking_pending(), true)
	expect_bytes(t, run(tgt, "GET df:a"), "$1\r\n1\r\n")
	sleep_cycle()
	testing.expect_value(t, m.tracking_pending(), false)
	expect_bytes(t, take(tgt), strings.concatenate({push_inv("df:a"), push_inv("df:b")}, context.temp_allocator))
	expect_bytes(t, run(r, "GET df:x"), "$-1\r\n")
	m.key_expired_event(transmute([]u8)string("df:x"), &m.dbs[0])
	testing.expect_value(t, m.tracking_pending(), true)
	expect_bytes(t, take(tgt), "")
	sleep_cycle()
	testing.expect_value(t, m.tracking_pending(), false)
	expect_bytes(t, take(tgt), push_inv("df:x"))
	expect_bytes(t, run(r, "GET df:y"), "$-1\r\n")
	m.signal_key_expired(transmute([]u8)string("df:y"), &m.dbs[0])
	m.tracking_flush_pending(r.c)
	expect_bytes(t, take(tgt), push_inv("df:y"))
	expect_bytes(t, run(r, "GET df:z"), "$-1\r\n")
	expect_bytes(t, run(w, "SET df:z 1"), "+OK\r\n")
	expect_bytes(t, take(tgt), "")
	expect_bytes(t, run(r, "PING"), "+PONG\r\n")
	expect_bytes(t, take(tgt), push_inv("df:z"))
	expect_bytes(t, run(r, "GET df:q"), "$-1\r\n")
	expect_bytes(t, run(w, "SET df:q 1"), "+OK\r\n")
	expect_bytes(t, run(r, "GET df:z"), "$1\r\n1\r\n")
	expect_bytes(t, run(w, "SET df:z 2"), "+OK\r\n")
	expect_bytes(t, run(r, "PING"), "+PONG\r\n")
	expect_bytes(t, take(tgt), strings.concatenate({push_inv("df:q"), push_inv("df:z")}, context.temp_allocator))
	expect_bytes(t, run(r, "GET df:gone"), "$-1\r\n")
	expect_bytes(t, run(w, "SET df:gone 1"), "+OK\r\n")
	testing.expect_value(t, m.tracking_pending(), true)
	client_close(tgt)
	sleep_cycle()
	testing.expect_value(t, m.tracking_pending(), false)
	client_close(w)
	client_close(r)
	env_check_clean(t)
}

@(test)
test_flush_sends_null :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	t2 := client_open(3)
	s := client_open()
	r := client_open()
	b := client_open(3)
	pat := client_open()
	rp := client_open()
	expect_bytes(t, run(pat, "PSUBSCRIBE __redis__:*"), "*3\r\n$10\r\npsubscribe\r\n$11\r\n__redis__:*\r\n:1\r\n")
	expect_bytes(t, run(rp, fmt.tprintf("CLIENT TRACKING ON REDIRECT %d", pat.c.id)), "+OK\r\n")
	expect_bytes(t, run(t2, "CLIENT TRACKING ON"), "+OK\r\n")
	expect_bytes(t, run(s, "SUBSCRIBE __redis__:invalidate"), "*3\r\n$9\r\nsubscribe\r\n$20\r\n__redis__:invalidate\r\n:1\r\n")
	expect_bytes(t, run(r, fmt.tprintf("CLIENT TRACKING ON REDIRECT %d", s.c.id)), "+OK\r\n")
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX fl:"), "+OK\r\n")
	expect_bytes(t, run(t2, "GET fl:f1"), "_\r\n")
	expect_bytes(t, run(r, "GET fl:f1"), "$-1\r\n")
	expect_bytes(t, stats(), "tracking_total_keys:1\r\ntracking_total_items:2\r\ntracking_total_prefixes:1\r\n")
	m.tracking_flush()
	expect_bytes(t, take(t2), push_null())
	expect_bytes(t, take(s), msg_null())
	expect_bytes(t, take(b), push_null())
	expect_bytes(t, take(pat), msg_null())
	expect_bytes(t, stats(), "tracking_total_keys:0\r\ntracking_total_items:0\r\ntracking_total_prefixes:1\r\n")
	client_close(rp)
	client_close(pat)
	sub3 := client_open(3)
	expect_bytes(t, run(sub3, "SUBSCRIBE __redis__:invalidate"), ">3\r\n$9\r\nsubscribe\r\n$20\r\n__redis__:invalidate\r\n:1\r\n")
	r2to3 := client_open()
	r3to3 := client_open(3)
	r3to2 := client_open(3)
	expect_bytes(t, run(r2to3, fmt.tprintf("CLIENT TRACKING ON REDIRECT %d", sub3.c.id)), "+OK\r\n")
	expect_bytes(t, run(r3to3, fmt.tprintf("CLIENT TRACKING ON REDIRECT %d", sub3.c.id)), "+OK\r\n")
	expect_bytes(t, run(r3to2, fmt.tprintf("CLIENT TRACKING ON REDIRECT %d", s.c.id)), "+OK\r\n")
	m.tracking_flush()
	expect_bytes(t, take(sub3), strings.concatenate({">2\r\n$10\r\ninvalidate\r\n$-1\r\n", ">2\r\n$10\r\ninvalidate\r\n_\r\n"}, context.temp_allocator))
	expect_bytes(t, take(s), strings.concatenate({msg_null(), "*3\r\n$7\r\nmessage\r\n$20\r\n__redis__:invalidate\r\n_\r\n"}, context.temp_allocator))
	expect_bytes(t, take(t2), push_null())
	expect_bytes(t, take(b), push_null())
	client_close(r3to2)
	client_close(r3to3)
	client_close(r2to3)
	client_close(sub3)
	expect_bytes(t, run(t2, "GET fl:f2"), "_\r\n")
	flusher := client_open()
	run(flusher, "FLUSHDB")
	expect_bytes(t, take(t2), push_null())
	expect_bytes(t, take(s), msg_null())
	expect_bytes(t, take(b), push_null())
	expect_bytes(t, run(t2, "GET fl:f3"), "_\r\n")
	m.tracking_flush()
	expect_bytes(t, run(t2, "PING"), strings.concatenate({push_null(), "+PONG\r\n"}, context.temp_allocator))
	expect_bytes(t, take(s), msg_null())
	expect_bytes(t, take(b), push_null())
	expect_bytes(t, run(t2, "MULTI"), "+OK\r\n")
	expect_bytes(t, run(t2, "GET fl:f4"), "+QUEUED\r\n")
	expect_bytes(t, run(t2, "FLUSHDB"), "+QUEUED\r\n")
	expect_bytes(t, run(t2, "EXEC"), "*2\r\n_\r\n+OK\r\n")
	sleep_cycle()
	expect_bytes(t, take(t2), push_null())
	expect_bytes(t, take(s), msg_null())
	expect_bytes(t, take(b), push_null())
	expect_bytes(t, run(t2, "GET fl:f5"), "_\r\n")
	expect_bytes(t, run(t2, "FLUSHDB"), "")
	testing.expect_value(t, t2.c.blocked, m.Block_Type.Lazyfree)
	testing.expect_value(t, m.tracking_pending(), true)
	sleep_cycle()
	expect_bytes(t, take(t2), "")
	expect_bytes(t, take(s), msg_null())
	expect_bytes(t, take(b), push_null())
	expect_bytes(t, stats(), "tracking_total_keys:0\r\ntracking_total_items:0\r\ntracking_total_prefixes:1\r\n")
	client_close(t2)
	sleep_cycle()
	testing.expect_value(t, m.tracking_pending(), false)
	client_close(flusher)
	client_close(b)
	client_close(r)
	client_close(s)
	env_check_clean(t)
}

@(test)
test_expired_and_evicted_keys_invalidate :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	t2 := client_open(3)
	w := client_open()
	expect_bytes(t, run(t2, "CLIENT TRACKING ON"), "+OK\r\n")
	expect_bytes(t, run(w, "SET ex:k 1 PX 1"), "+OK\r\n")
	expect_bytes(t, run(t2, "GET ex:k"), "$1\r\n1\r\n")
	time.sleep(5 * time.Millisecond)
	m.update_clock()
	expect_bytes(t, run(w, "GET ex:k"), "$-1\r\n")
	expect_bytes(t, take(t2), push_inv("ex:k"))
	expect_bytes(t, run(t2, "GET ev:k"), "_\r\n")
	m.signal_key_expired(transmute([]u8)string("ev:k"), &m.dbs[5])
	expect_bytes(t, take(t2), push_inv("ev:k"))
	expect_bytes(t, run(t2, "GET ev:own"), "_\r\n")
	expect_bytes(t, run(w, "SET ev:own 1 PX 1"), "+OK\r\n")
	expect_bytes(t, take(t2), push_inv("ev:own"))
	expect_bytes(t, run(t2, "GET ev:own"), "$1\r\n1\r\n")
	time.sleep(5 * time.Millisecond)
	m.update_clock()
	expect_bytes(t, run(t2, "GET ev:own"), strings.concatenate({"_\r\n", push_inv("ev:own")}, context.temp_allocator))
	expect_bytes(t, stats(), "tracking_total_keys:1\r\ntracking_total_items:1\r\ntracking_total_prefixes:0\r\n")
	client_close(w)
	client_close(t2)
	env_check_clean(t)
}

@(test)
test_multi_exec_and_reset :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	t2 := client_open(3)
	w := client_open()
	expect_bytes(t, run(t2, "CLIENT TRACKING ON"), "+OK\r\n")
	expect_bytes(t, run(t2, "MULTI"), "+OK\r\n")
	expect_bytes(t, run(t2, "GET mx:m1"), "+QUEUED\r\n")
	expect_bytes(t, stats(), "tracking_total_keys:0\r\ntracking_total_items:0\r\ntracking_total_prefixes:0\r\n")
	expect_bytes(t, run(t2, "SET mx:m1 x"), "+QUEUED\r\n")
	expect_bytes(t, run(t2, "EXEC"), strings.concatenate({"*2\r\n_\r\n+OK\r\n", push_inv("mx:m1")}, context.temp_allocator))
	expect_bytes(t, run(w, "SET mx:m1 y"), "+OK\r\n")
	expect_bytes(t, take(t2), "")
	expect_bytes(t, run(t2, "MULTI"), "+OK\r\n")
	expect_bytes(t, run(t2, "GET mx:m2"), "+QUEUED\r\n")
	expect_bytes(t, run(t2, "EXEC"), "*1\r\n_\r\n")
	expect_bytes(t, run(w, "MULTI"), "+OK\r\n")
	expect_bytes(t, run(w, "SET mx:m2 1"), "+QUEUED\r\n")
	expect_bytes(t, run(w, "SET mx:m2 2"), "+QUEUED\r\n")
	expect_bytes(t, run(w, "EXEC"), "*2\r\n+OK\r\n+OK\r\n")
	expect_bytes(t, take(t2), push_inv("mx:m2"))
	expect_bytes(t, run(t2, "CLIENT TRACKINGINFO"), trackinginfo_reply(true, {"on"}, 0, {}))
	expect_bytes(t, run(t2, "GET mx:m3"), "_\r\n")
	expect_bytes(t, run(t2, "RESET"), "+RESET\r\n")
	expect_bytes(t, run(t2, "CLIENT TRACKINGINFO"), trackinginfo_reply(false, {"off"}, -1, {}))
	testing.expect_value(t, m.tracking_clients, 0)
	expect_bytes(t, run(w, "SET mx:m3 1"), "+OK\r\n")
	expect_bytes(t, take(t2), "")
	client_close(w)
	client_close(t2)
	env_check_clean(t)
}

@(test)
test_tracking_table_limit :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	defer env_reset()
	t2 := client_open(3)
	w := client_open()
	expect_bytes(t, run(t2, "CLIENT TRACKING ON"), "+OK\r\n")
	expect_bytes(t, run(w, "CONFIG SET tracking-table-max-keys 3"), "+OK\r\n")
	expect_bytes(t, run(w, "CONFIG GET tracking-table-max-keys"), "*2\r\n$23\r\ntracking-table-max-keys\r\n$1\r\n3\r\n")
	tracked: [dynamic]string
	defer delete(tracked)
	evicted: [dynamic]string
	defer delete(evicted)
	for i in 1 ..= 6 {
		key := fmt.tprintf("lm:l%d", i)
		expect_bytes(t, run(t2, fmt.tprintf("GET %s", key)), "_\r\n")
		append(&tracked, key)
		sleep_cycle()
		got := take(t2)
		if i <= 3 {
			expect_bytes(t, got, "")
			continue
		}
		victim := ""
		for k in tracked {
			if got == push_inv(k) {
				victim = k
			}
		}
		testing.expectf(t, victim != "", "eviction frame %q did not name a tracked key", got)
		for k, j in tracked {
			if k == victim {
				ordered_remove(&tracked, j)
				break
			}
		}
		append(&evicted, victim)
	}
	testing.expect_value(t, len(evicted), 3)
	expect_bytes(t, stats(), "tracking_total_keys:3\r\ntracking_total_items:3\r\ntracking_total_prefixes:0\r\n")
	for k in evicted {
		expect_bytes(t, run(w, fmt.tprintf("SET %s 1", k)), "+OK\r\n")
		expect_bytes(t, take(t2), "")
	}
	for k in tracked {
		expect_bytes(t, run(w, fmt.tprintf("SET %s 1", k)), "+OK\r\n")
		expect_bytes(t, take(t2), push_inv(k))
	}
	expect_bytes(t, run(w, "CONFIG SET tracking-table-max-keys 0"), "+OK\r\n")
	for i in 1 ..= 10 {
		expect_bytes(t, run(t2, fmt.tprintf("GET lm:u%d", i)), "_\r\n")
	}
	sleep_cycle()
	expect_bytes(t, take(t2), "")
	expect_bytes(t, stats(), "tracking_total_keys:10\r\ntracking_total_items:10\r\ntracking_total_prefixes:0\r\n")
	expect_bytes(t, run(w, "CONFIG SET tracking-table-max-keys 1"), "+OK\r\n")
	sleep_cycle()
	frames := take(t2)
	testing.expect_value(t, strings.count(frames, ">2\r\n$10\r\ninvalidate\r\n*1\r\n"), 9)
	expect_bytes(t, stats(), "tracking_total_keys:1\r\ntracking_total_items:1\r\ntracking_total_prefixes:0\r\n")
	expect_bytes(t, run(w, "CONFIG SET tracking-table-max-keys 1000000"), "+OK\r\n")
	client_close(w)
	client_close(t2)
	env_check_clean(t)
}

@(test)
test_cleanup_on_off_and_close :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	a := client_open(3)
	b := client_open(3)
	w := client_open()
	expect_bytes(t, run(a, "CLIENT TRACKING ON"), "+OK\r\n")
	expect_bytes(t, run(b, "CLIENT TRACKING ON"), "+OK\r\n")
	expect_bytes(t, run(a, "GET cl:k"), "_\r\n")
	expect_bytes(t, run(a, "CLIENT TRACKING OFF"), "+OK\r\n")
	expect_bytes(t, stats(), "tracking_total_keys:1\r\ntracking_total_items:1\r\ntracking_total_prefixes:0\r\n")
	expect_bytes(t, run(w, "SET cl:k 1"), "+OK\r\n")
	expect_bytes(t, take(a), "")
	expect_bytes(t, stats(), "tracking_total_keys:0\r\ntracking_total_items:0\r\ntracking_total_prefixes:0\r\n")
	expect_bytes(t, run(b, "GET cl:k2"), "_\r\n")
	expect_bytes(t, run(a, "CLIENT TRACKING ON BCAST PREFIX cl:"), "+OK\r\n")
	expect_bytes(t, run(a, "GET cl:k2"), "_\r\n")
	expect_bytes(t, stats(), "tracking_total_keys:1\r\ntracking_total_items:1\r\ntracking_total_prefixes:1\r\n")
	testing.expect_value(t, m.tracking_clients, 2)
	client_close(a)
	testing.expect_value(t, m.tracking_clients, 1)
	expect_bytes(t, stats(), "tracking_total_keys:1\r\ntracking_total_items:1\r\ntracking_total_prefixes:0\r\n")
	expect_bytes(t, run(w, "SET cl:k2 1"), "+OK\r\n")
	sleep_cycle()
	expect_bytes(t, take(b), push_inv("cl:k2"))
	expect_bytes(t, run(b, "GET cl:k3"), "_\r\n")
	expect_bytes(t, run(b, "GET cl:k4"), "_\r\n")
	client_close(b)
	testing.expect_value(t, m.tracking_clients, 0)
	expect_bytes(t, stats(), "tracking_total_keys:0\r\ntracking_total_items:0\r\ntracking_total_prefixes:0\r\n")
	testing.expect_value(t, m.key_hooks, false)
	expect_bytes(t, run(w, "SET cl:k3 1"), "+OK\r\n")
	client_close(w)
	env_check_clean(t)
}

@(test)
test_info_fields :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	w := client_open()
	a := client_open(3)
	b := client_open(3)
	stats_text := run(w, "INFO stats")
	testing.expect(t, strings.contains(stats_text, "\r\ntracking_total_keys:0\r\ntracking_total_items:0\r\ntracking_total_prefixes:0\r\n"))
	testing.expect_value(t, info_line(run(w, "INFO clients"), "tracking_clients:"), "tracking_clients:0")
	expect_bytes(t, run(a, "CLIENT TRACKING ON"), "+OK\r\n")
	expect_bytes(t, run(b, "CLIENT TRACKING ON BCAST PREFIX if: PREFIX ig:"), "+OK\r\n")
	expect_bytes(t, run(a, "MGET if:1 if:2"), "*2\r\n_\r\n_\r\n")
	testing.expect_value(t, info_line(run(w, "INFO clients"), "tracking_clients:"), "tracking_clients:2")
	stats_text = run(w, "INFO stats")
	testing.expect(t, strings.contains(stats_text, "\r\ntracking_total_keys:2\r\ntracking_total_items:2\r\ntracking_total_prefixes:2\r\n"))
	client_close(b)
	client_close(a)
	client_close(w)
	env_check_clean(t)
}

@(test)
test_self_push_order :: proc(t: ^testing.T) {
	context.allocator = runtime.heap_allocator()
	env_setup()
	s := client_open(3)
	w := client_open()
	expect_bytes(t, run(w, "CONFIG SET notify-keyspace-events KEA"), "+OK\r\n")
	expect_bytes(t, run(s, "PSUBSCRIBE __key*"), ">3\r\n$10\r\npsubscribe\r\n$6\r\n__key*\r\n:1\r\n")
	expect_bytes(t, run(s, "CLIENT TRACKING ON"), "+OK\r\n")
	expect_bytes(t, run(s, "GET so:a"), "_\r\n")
	pm :: proc(chan: string, payload: string) -> string {
		return frame('>', "pmessage", "__key*", chan, payload)
	}
	expect_bytes(t, run(s, "SET so:a 2"), strings.concatenate({"+OK\r\n", pm("__keyspace@0__:so:a", "set"), pm("__keyevent@0__:set", "so:a"), push_inv("so:a")}, context.temp_allocator))
	expect_bytes(t, run(s, "GET so:b"), "_\r\n")
	expect_bytes(t, run(w, "SET so:b 1"), "+OK\r\n")
	expect_bytes(t, take(s), strings.concatenate({push_inv("so:b"), pm("__keyspace@0__:so:b", "set"), pm("__keyevent@0__:set", "so:b")}, context.temp_allocator))
	expect_bytes(t, run(s, "GET so:c"), "_\r\n")
	expect_bytes(t, run(s, "MULTI"), "+OK\r\n")
	expect_bytes(t, run(s, "SET so:c 1"), "+QUEUED\r\n")
	expect_bytes(t, run(s, "LPUSH so:l x"), "+QUEUED\r\n")
	expect_bytes(t, run(s, "EXEC"), strings.concatenate({"*2\r\n+OK\r\n:1\r\n", pm("__keyspace@0__:so:c", "set"), pm("__keyevent@0__:set", "so:c"), pm("__keyspace@0__:so:l", "lpush"), pm("__keyevent@0__:lpush", "so:l"), push_inv("so:c")}, context.temp_allocator))
	expect_bytes(t, run(s, "MGET so:d so:e"), "*2\r\n_\r\n_\r\n")
	expect_bytes(t, run(s, "DEL so:d so:e so:a"), strings.concatenate({":1\r\n", pm("__keyspace@0__:so:a", "del"), pm("__keyevent@0__:del", "so:a")}, context.temp_allocator))
	expect_bytes(t, run(s, "MSET so:d 1 so:e 2"), strings.concatenate({"+OK\r\n", pm("__keyspace@0__:so:d", "set"), pm("__keyevent@0__:set", "so:d"), pm("__keyspace@0__:so:e", "set"), pm("__keyevent@0__:set", "so:e"), push_inv("so:d"), push_inv("so:e")}, context.temp_allocator))
	client_close(w)
	client_close(s)
	env_reset()
	env_check_clean(t)
}
