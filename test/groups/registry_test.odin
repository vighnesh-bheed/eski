package groups_test

import rx "../../src/rax"
import st "../../src/streamtype"
import "core:testing"

@(test)
group_registry_create_lookup_destroy :: proc(t: ^testing.T) {
	s := stream_1_to(t, 3)
	defer st.destroy(s)
	testing.expect_value(t, st.group_count(s), 0)
	testing.expect(t, st.lookup_cg(s, b("g")) == nil)
	before := baseline(s)
	g := st.create_cg(s, b("g"), id(0), st.SCG_INVALID_ENTRIES_READ)
	testing.expect(t, g != nil)
	testing.expect(t, st.create_cg(s, b("g"), id(5), 3) == nil)
	empty := st.create_cg(s, b(""), id(2), 7)
	testing.expect(t, empty != nil)
	testing.expect(t, st.create_cg(s, b("-5"), id(0), -1) != nil)
	testing.expect_value(t, st.group_count(s), 3)
	testing.expect(t, same_strings(group_names(s), {"", "-5", "g"}))
	testing.expect(t, st.lookup_cg(s, b("g")) == g)
	testing.expect(t, st.lookup_cg(s, b("")) == empty)
	testing.expect_value(t, empty.last_id, id(2))
	testing.expect_value(t, empty.entries_read, 7)
	testing.expect_value(t, g.entries_read, st.SCG_INVALID_ENTRIES_READ)
	testing.expect(t, s.cg_mem > before)
	testing.expect(t, st.destroy_cg(s, b("g")))
	testing.expect(t, !st.destroy_cg(s, b("g")))
	testing.expect(t, !st.destroy_cg(s, b("nog")))
	testing.expect(t, st.lookup_cg(s, b("g")) == nil)
	testing.expect_value(t, st.group_count(s), 2)
	st.free_groups(s)
	testing.expect(t, s.cgroups == nil)
	testing.expect_value(t, st.group_count(s), 0)
	testing.expect_value(t, s.cg_mem, 0)
	testing.expect(t, st.lookup_cg(nil, b("g")) == nil)
}

@(test)
consumer_registry_and_pending_bookkeeping :: proc(t: ^testing.T) {
	s := stream_1_to(t, 10)
	defer st.destroy(s)
	g := st.create_cg(s, b("g"), id(0), st.SCG_INVALID_ENTRIES_READ)
	alice := st.create_consumer(s, g, b("alice"), T0)
	testing.expect(t, alice != nil)
	testing.expect(t, st.create_consumer(s, g, b("alice"), T0 + 5) == nil)
	testing.expect_value(t, alice.seen_time, T0)
	testing.expect_value(t, alice.active_time, -1)
	testing.expect_value(t, string(alice.name), "alice")
	bob := st.create_consumer(s, g, b("bob"), T0)
	empty := st.create_consumer(s, g, b(""), T0)
	testing.expect(t, same_strings(consumer_names(g), {"", "alice", "bob"}))
	testing.expect(t, st.lookup_consumer(g, b("bob")) == bob)
	testing.expect(t, st.lookup_consumer(g, b("carol")) == nil)
	testing.expect(t, st.lookup_consumer(nil, b("bob")) == nil)
	got := deliver(s, g, alice, 3, false, T0 + 1)
	testing.expect(t, same_ids(got, ids({1, 0}, {2, 0}, {3, 0})))
	deliver(s, g, bob, 2, false, T0 + 2)
	testing.expect_value(t, g.pel.numele, 5)
	testing.expect(t, same_ids(pel_ids(alice.pel), ids({1, 0}, {2, 0}, {3, 0})))
	testing.expect(t, same_ids(pel_ids(bob.pel), ids({4, 0}, {5, 0})))
	n := st.lookup_nack(g, id(4))
	testing.expect(t, n != nil && n.consumer == bob && n.delivery_count == 1 && n.delivery_time == T0 + 2)
	k4 := pel_key(id(4))
	v, found := rx.find(bob.pel, k4[:])
	testing.expect(t, found && (^st.NACK)(v) == n)
	testing.expect(t, st.ack(s, g, id(2)))
	testing.expect(t, !st.ack(s, g, id(2)))
	testing.expect(t, !st.ack(s, g, id(99)))
	testing.expect(t, same_ids(pel_ids(alice.pel), ids({1, 0}, {3, 0})))
	testing.expect_value(t, g.pel.numele, 4)
	dropped := st.del_consumer(s, g, alice)
	testing.expect_value(t, dropped, 2)
	testing.expect(t, same_ids(pel_ids(g.pel), ids({4, 0}, {5, 0})))
	testing.expect(t, same_strings(consumer_names(g), {"", "bob"}))
	testing.expect_value(t, st.del_consumer(s, g, empty), 0)
	testing.expect(t, same_strings(consumer_names(g), {"bob"}))
	testing.expect(t, st.destroy_cg(s, b("g")))
	st.free_groups(s)
	testing.expect_value(t, s.cg_mem, 0)
}

pel_key :: proc(x: st.ID) -> (key: [16]u8) {
	st.encode_id(&key, x)
	return
}

@(test)
group_memory_is_accounted_and_released :: proc(t: ^testing.T) {
	s := stream_1_to(t, 200)
	defer st.destroy(s)
	base := st.memory_usage(s)
	for name in ([]string{"g1", "g2", "g3"}) {
		g := st.create_cg(s, b(name), id(0), -1)
		for cname in ([]string{"a", "bb", "a-much-longer-consumer-name-than-usual"}) {
			c := st.create_consumer(s, g, b(cname), T0)
			deliver(s, g, c, 50, false, T0)
		}
	}
	testing.expect(t, st.memory_usage(s) > base)
	testing.expect(t, s.cg_mem > 0)
	g2 := st.lookup_cg(s, b("g2"))
	c := st.lookup_consumer(g2, b("bb"))
	mid := s.cg_mem
	st.del_consumer(s, g2, c)
	testing.expect(t, s.cg_mem < mid)
	st.destroy_cg(s, b("g1"))
	st.destroy_cg(s, b("g2"))
	st.destroy_cg(s, b("g3"))
	testing.expect(t, s.cgroups != nil)
	st.free_groups(s)
	testing.expect_value(t, s.cg_mem, 0)
	testing.expect_value(t, st.memory_usage(s), base)
}

@(test)
dup_copies_groups_consumers_and_shared_pending_entries :: proc(t: ^testing.T) {
	s := stream_1_to(t, 6)
	defer st.destroy(s)
	g := st.create_cg(s, b("g1"), id(0), -1)
	h := st.create_cg(s, b("g2"), id(0), 4)
	alice := st.create_consumer(s, g, b("Alice"), T0)
	bob := st.create_consumer(s, g, b("Bob"), T0 + 1)
	st.create_consumer(s, g, b("Dave"), T0 + 2)
	deliver(s, g, alice, 1, false, T0 + 3)
	deliver(s, g, bob, 1, false, T0 + 4)
	deliver(s, g, bob, 1, true, T0 + 5)
	charlie := st.create_consumer(s, h, b("Charlie"), T0)
	deliver(s, h, charlie, 4, false, T0 + 6)
	d := st.dup(s)
	defer st.destroy(d)
	testing.expect(t, same_strings(group_names(d), {"g1", "g2"}))
	dg := st.lookup_cg(d, b("g1"))
	testing.expect(t, dg != g)
	testing.expect_value(t, dg.last_id, g.last_id)
	testing.expect_value(t, dg.entries_read, g.entries_read)
	testing.expect(t, same_ids(pel_ids(dg.pel), pel_ids(g.pel)))
	testing.expect(t, same_strings(consumer_names(dg), {"Alice", "Bob", "Dave"}))
	da := st.lookup_consumer(dg, b("Alice"))
	testing.expect_value(t, da.seen_time, alice.seen_time)
	testing.expect_value(t, da.active_time, alice.active_time)
	dave := st.lookup_consumer(dg, b("Dave"))
	testing.expect_value(t, dave.active_time, -1)
	n := st.lookup_nack(dg, id(1))
	testing.expect(t, n != nil && n.consumer == da && n != st.lookup_nack(g, id(1)))
	k1 := pel_key(id(1))
	v, found := rx.find(da.pel, k1[:])
	testing.expect(t, found && (^st.NACK)(v) == n)
	dh := st.lookup_cg(d, b("g2"))
	testing.expect_value(t, dh.entries_read, h.entries_read)
	testing.expect_value(t, dh.pel.numele, 4)
	st.ack(d, dg, id(1))
	testing.expect_value(t, g.pel.numele, 2)
	testing.expect_value(t, dg.pel.numele, 1)
	testing.expect_value(t, d.cg_mem > 0, true)
}
