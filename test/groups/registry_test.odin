package groups_test

import rx "../../src/rax"
import st "../../src/streamtype"
import "core:testing"

@(test)
group_registry_create_lookup_destroy :: proc(t: ^testing.T) {
	s := stream_1_to(t, 3)
	defer st.destroy(s)
	testing.expect_value(t, st.group_count(s), 0)
	testing.expect(t, st.find_group(s, b("g")) == nil)
	before := baseline(s)
	g := st.add_group(s, b("g"), id(0), st.ENTRIES_READ_UNKNOWN)
	testing.expect(t, g != nil)
	testing.expect(t, st.add_group(s, b("g"), id(5), 3) == nil)
	empty := st.add_group(s, b(""), id(2), 7)
	testing.expect(t, empty != nil)
	testing.expect(t, st.add_group(s, b("-5"), id(0), -1) != nil)
	testing.expect_value(t, st.group_count(s), 3)
	testing.expect(t, same_strings(group_names(s), {"", "-5", "g"}))
	testing.expect(t, st.find_group(s, b("g")) == g)
	testing.expect(t, st.find_group(s, b("")) == empty)
	testing.expect_value(t, empty.delivered, id(2))
	testing.expect_value(t, empty.reads, 7)
	testing.expect_value(t, g.reads, st.ENTRIES_READ_UNKNOWN)
	testing.expect(t, s.group_bytes > before)
	testing.expect(t, st.drop_group(s, b("g")))
	testing.expect(t, !st.drop_group(s, b("g")))
	testing.expect(t, !st.drop_group(s, b("nog")))
	testing.expect(t, st.find_group(s, b("g")) == nil)
	testing.expect_value(t, st.group_count(s), 2)
	st.free_groups(s)
	testing.expect(t, s.groups == nil)
	testing.expect_value(t, st.group_count(s), 0)
	testing.expect_value(t, s.group_bytes, 0)
	testing.expect(t, st.find_group(nil, b("g")) == nil)
}

@(test)
consumer_registry_and_pending_bookkeeping :: proc(t: ^testing.T) {
	s := stream_1_to(t, 10)
	defer st.destroy(s)
	g := st.add_group(s, b("g"), id(0), st.ENTRIES_READ_UNKNOWN)
	alice := st.add_member(s, g, b("alice"), T0)
	testing.expect(t, alice != nil)
	testing.expect(t, st.add_member(s, g, b("alice"), T0 + 5) == nil)
	testing.expect_value(t, alice.seen_ms, T0)
	testing.expect_value(t, alice.active_ms, -1)
	testing.expect_value(t, string(alice.name), "alice")
	bob := st.add_member(s, g, b("bob"), T0)
	empty := st.add_member(s, g, b(""), T0)
	testing.expect(t, same_strings(consumer_names(g), {"", "alice", "bob"}))
	testing.expect(t, st.find_member(g, b("bob")) == bob)
	testing.expect(t, st.find_member(g, b("carol")) == nil)
	testing.expect(t, st.find_member(nil, b("bob")) == nil)
	got := deliver(s, g, alice, 3, false, T0 + 1)
	testing.expect(t, same_ids(got, ids({1, 0}, {2, 0}, {3, 0})))
	deliver(s, g, bob, 2, false, T0 + 2)
	testing.expect_value(t, g.pending.numele, 5)
	testing.expect(t, same_ids(pel_ids(alice.owned), ids({1, 0}, {2, 0}, {3, 0})))
	testing.expect(t, same_ids(pel_ids(bob.owned), ids({4, 0}, {5, 0})))
	n := st.find_delivery(g, id(4))
	testing.expect(t, n != nil && n.owner == bob && n.times == 1 && n.sent_ms == T0 + 2)
	k4 := pel_key(id(4))
	v, found := rx.find(bob.owned, k4[:])
	testing.expect(t, found && (^st.Delivery)(v) == n)
	testing.expect(t, st.ack(s, g, id(2)))
	testing.expect(t, !st.ack(s, g, id(2)))
	testing.expect(t, !st.ack(s, g, id(99)))
	testing.expect(t, same_ids(pel_ids(alice.owned), ids({1, 0}, {3, 0})))
	testing.expect_value(t, g.pending.numele, 4)
	dropped := st.drop_member(s, g, alice)
	testing.expect_value(t, dropped, 2)
	testing.expect(t, same_ids(pel_ids(g.pending), ids({4, 0}, {5, 0})))
	testing.expect(t, same_strings(consumer_names(g), {"", "bob"}))
	testing.expect_value(t, st.drop_member(s, g, empty), 0)
	testing.expect(t, same_strings(consumer_names(g), {"bob"}))
	testing.expect(t, st.drop_group(s, b("g")))
	st.free_groups(s)
	testing.expect_value(t, s.group_bytes, 0)
}

pel_key :: proc(x: st.ID) -> (key: [16]u8) {
	st.encode_id(&key, x)
	return
}

@(test)
group_memory_is_accounted_and_released :: proc(t: ^testing.T) {
	s := stream_1_to(t, 200)
	defer st.destroy(s)
	base := st.memory_usage(s)
	for name in ([]string{"g1", "g2", "g3"}) {
		g := st.add_group(s, b(name), id(0), -1)
		for cname in ([]string{"a", "bb", "a-much-longer-consumer-name-than-usual"}) {
			c := st.add_member(s, g, b(cname), T0)
			deliver(s, g, c, 50, false, T0)
		}
	}
	testing.expect(t, st.memory_usage(s) > base)
	testing.expect(t, s.group_bytes > 0)
	g2 := st.find_group(s, b("g2"))
	c := st.find_member(g2, b("bb"))
	mid := s.group_bytes
	st.drop_member(s, g2, c)
	testing.expect(t, s.group_bytes < mid)
	st.drop_group(s, b("g1"))
	st.drop_group(s, b("g2"))
	st.drop_group(s, b("g3"))
	testing.expect(t, s.groups != nil)
	st.free_groups(s)
	testing.expect_value(t, s.group_bytes, 0)
	testing.expect_value(t, st.memory_usage(s), base)
}

@(test)
dup_copies_groups_consumers_and_shared_pending_entries :: proc(t: ^testing.T) {
	s := stream_1_to(t, 6)
	defer st.destroy(s)
	g := st.add_group(s, b("g1"), id(0), -1)
	h := st.add_group(s, b("g2"), id(0), 4)
	alice := st.add_member(s, g, b("Alice"), T0)
	bob := st.add_member(s, g, b("Bob"), T0 + 1)
	st.add_member(s, g, b("Dave"), T0 + 2)
	deliver(s, g, alice, 1, false, T0 + 3)
	deliver(s, g, bob, 1, false, T0 + 4)
	deliver(s, g, bob, 1, true, T0 + 5)
	charlie := st.add_member(s, h, b("Charlie"), T0)
	deliver(s, h, charlie, 4, false, T0 + 6)
	d := st.dup(s)
	defer st.destroy(d)
	testing.expect(t, same_strings(group_names(d), {"g1", "g2"}))
	dg := st.find_group(d, b("g1"))
	testing.expect(t, dg != g)
	testing.expect_value(t, dg.delivered, g.delivered)
	testing.expect_value(t, dg.reads, g.reads)
	testing.expect(t, same_ids(pel_ids(dg.pending), pel_ids(g.pending)))
	testing.expect(t, same_strings(consumer_names(dg), {"Alice", "Bob", "Dave"}))
	da := st.find_member(dg, b("Alice"))
	testing.expect_value(t, da.seen_ms, alice.seen_ms)
	testing.expect_value(t, da.active_ms, alice.active_ms)
	dave := st.find_member(dg, b("Dave"))
	testing.expect_value(t, dave.active_ms, -1)
	n := st.find_delivery(dg, id(1))
	testing.expect(t, n != nil && n.owner == da && n != st.find_delivery(g, id(1)))
	k1 := pel_key(id(1))
	v, found := rx.find(da.owned, k1[:])
	testing.expect(t, found && (^st.Delivery)(v) == n)
	dh := st.find_group(d, b("g2"))
	testing.expect_value(t, dh.reads, h.reads)
	testing.expect_value(t, dh.pending.numele, 4)
	st.ack(d, dg, id(1))
	testing.expect_value(t, g.pending.numele, 2)
	testing.expect_value(t, dg.pending.numele, 1)
	testing.expect_value(t, d.group_bytes > 0, true)
}
